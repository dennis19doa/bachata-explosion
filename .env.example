# Public, read-only origin exposed through Cloudflare Tunnel.
# Keep this empty for the local archive-shell preview.
PUBLIC_ARCHIVE_MEDIA_ORIGIN=https://media.bachataexplosion.com

# Native same-origin form endpoints handled by the Cloudflare Worker.
# Keep these empty in renderer-only/static previews if you do not want test submissions.
PUBLIC_CONTACT_FORM_ENDPOINT=/api/forms/contact
PUBLIC_TICKETS_FORM_ENDPOINT=/api/forms/tickets
PUBLIC_GROUPS_FORM_ENDPOINT=/api/forms/groups
PUBLIC_PARTNERS_FORM_ENDPOINT=/api/forms/partners
PUBLIC_MEDIA_FORM_ENDPOINT=/api/forms/media
PUBLIC_VOLUNTEER_FORM_ENDPOINT=/api/forms/volunteer
PUBLIC_AMBASSADOR_FORM_ENDPOINT=/api/forms/ambassador
# Jack & Jill includes a photo upload and remains on its dedicated upload flow for now.
PUBLIC_JJ_FORM_ENDPOINT=
PUBLIC_NEWSLETTER_FORM_ENDPOINT=/api/forms/newsletter

# Cloudflare Worker secrets / variables (configure with Wrangler or Cloudflare dashboard;
# do not commit real credentials).
TURNSTILE_SECRET=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNT_ID=
ZOHO_FROM_ADDRESS=forms@bachataexplosion.com
ZOHO_ACCOUNTS_BASE=https://accounts.zoho.eu
ZOHO_MAIL_BASE=https://mail.zoho.eu

# Route each form to the Zoho alias that should receive it.
FORM_CONTACT_TO=info@bachataexplosion.com
FORM_TICKETS_TO=tickets@bachataexplosion.com
FORM_GROUPS_TO=groups@bachataexplosion.com
FORM_PARTNERS_TO=partners@bachataexplosion.com
FORM_MEDIA_TO=media@bachataexplosion.com
FORM_VOLUNTEER_TO=volunteers@bachataexplosion.com
FORM_AMBASSADOR_TO=ambassadors@bachataexplosion.com
FORM_NEWSLETTER_TO=news@bachataexplosion.com
