# Public, read-only origin exposed through Cloudflare Tunnel.
# Keep this empty for the local archive-shell preview.
PUBLIC_ARCHIVE_MEDIA_ORIGIN=https://media.bachataexplosion.com

# Contact form delivery uses Formspree, matching the Elite Dance Studio setup.
# Create one Formspree form that delivers to info@bachataexplosion.com and paste
# its endpoint here (example: https://formspree.io/f/abcde123).
PUBLIC_CONTACT_FORM_ENDPOINT=https://formspree.io/f/replace-with-contact-form-id

# Other site forms can keep using their existing endpoints until migrated.
PUBLIC_VOLUNTEER_FORM_ENDPOINT=/api/forms/volunteer
PUBLIC_AMBASSADOR_FORM_ENDPOINT=/api/forms/ambassador
# Jack & Jill includes a photo upload and remains on its dedicated upload flow for now.
PUBLIC_JJ_FORM_ENDPOINT=
PUBLIC_NEWSLETTER_FORM_ENDPOINT=/api/forms/newsletter

# Legacy Cloudflare Worker/Zoho variables. The contact form no longer depends on
# these when PUBLIC_CONTACT_FORM_ENDPOINT is configured.
TURNSTILE_SECRET=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNT_ID=
ZOHO_FROM_ADDRESS=forms@bachataexplosion.com
ZOHO_ACCOUNTS_BASE=https://accounts.zoho.eu
ZOHO_MAIL_BASE=https://mail.zoho.eu

FORM_CONTACT_TO=info@bachataexplosion.com
FORM_VOLUNTEER_TO=info@bachataexplosion.com
FORM_AMBASSADOR_TO=info@bachataexplosion.com
FORM_NEWSLETTER_TO=info@bachataexplosion.com
