# Public, read-only origin exposed through Cloudflare Tunnel.
# Keep this empty for the local archive-shell preview.
PUBLIC_ARCHIVE_MEDIA_ORIGIN=https://media.bachataexplosion.com

# Website forms post back to the same Cloudflare Worker.
PUBLIC_CONTACT_FORM_ENDPOINT=/api/forms/contact
PUBLIC_VOLUNTEER_FORM_ENDPOINT=/api/forms/volunteer
PUBLIC_AMBASSADOR_FORM_ENDPOINT=/api/forms/ambassador
PUBLIC_NEWSLETTER_FORM_ENDPOINT=/api/forms/newsletter

# Jack & Jill includes a photo upload and remains on its dedicated upload flow.
PUBLIC_JJ_FORM_ENDPOINT=

# Direct Zoho SMTP delivery. Store ZOHO_SMTP_PASSWORD as an encrypted Cloudflare
# secret. ZOHO_SMTP_USER must be the actual Zoho mailbox/login address; when MFA
# is enabled use a Zoho application-specific password rather than the account password.
ZOHO_SMTP_HOST=smtp.zoho.eu
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=
ZOHO_SMTP_PASSWORD=
# Optional sender override. Leave blank to send from the authenticated Zoho user.
ZOHO_SMTP_FROM=
ZOHO_SMTP_FROM_NAME=Bachata Explosion Website
FORM_CONTACT_TO=info@bachataexplosion.com

# Optional Cloudflare Turnstile protection.
TURNSTILE_SECRET=
