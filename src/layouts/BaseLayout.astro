---
import "../styles/global.css";
import { newsletterFormEndpoint } from "../lib/forms";

interface Props {
  title?: string;
  description?: string;
  headerStyle?: "overlay" | "solid";
}

const {
  title = "Bachata Explosion — By dancers, for dancers",
  description = "Berlin bachata festivals, workshops, socials and a growing event archive — built by dancers, for dancers.",
  headerStyle = "overlay",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL("/og.png", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#100609" />
    <link rel="icon" href="/media/brand/explosion-logo.webp" type="image/webp" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Bachata Explosion — Berlin Bachata Festival, October 16–18, 2026" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class:list={["site-header", headerStyle === "solid" && "site-header-solid"]}>
      <a class="brand" href="/" aria-label="Bachata Explosion home">
        <img src="/media/brand/explosion-logo.webp" alt="Bachata Explosion" width="184" height="64" />
      </a>
      <nav class="desktop-nav" aria-label="Main navigation">
        <a href="/festival/">Festival</a>
        <a href="/#experience">Experience</a>
        <a href="/archive/">Archive</a>
        <a href="/contact/">Contact</a>
      </nav>
      <details class="mobile-nav">
        <summary aria-label="Open navigation"><span>Menu</span><i aria-hidden="true"></i></summary>
        <nav aria-label="Mobile navigation">
          <a href="/festival/">Festival <span>01</span></a>
          <a href="/#experience">Experience <span>02</span></a>
          <a href="/archive/">Archive <span>03</span></a>
          <a href="/contact/">Contact <span>04</span></a>
        </nav>
      </details>
      <a class="button button-small button-gold" href="/festival/#tickets">Get tickets</a>
    </header>
    <main id="main">
      <slot />
    </main>
    <section class="newsletter" aria-labelledby="newsletter-title">
      <div class="newsletter-inner shell">
        <div>
          <p class="section-label">Explosion insider</p>
          <h2 id="newsletter-title">Presales, artist drops<br />& dancer perks.</h2>
        </div>
        <form
          class="newsletter-form"
          action={newsletterFormEndpoint || undefined}
          method="post"
          data-endpoint-form
          data-preview-message="The newsletter form is designed and ready. We’ll connect double opt-in after the provider and subscriber migration are approved."
          data-success-message="Almost there—please check your inbox to confirm your subscription."
        >
          <input type="hidden" name="formType" value="newsletter" />
          <label><span>First name</span><input type="text" name="firstName" autocomplete="given-name" placeholder="Your first name" /></label>
          <label><span>Email</span><input type="email" name="email" autocomplete="email" placeholder="you@example.com" required /></label>
          <label class="honeypot" aria-hidden="true"><span>Website</span><input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
          <label class="consent"><input type="checkbox" required /> <span>I accept the <a href="https://bachataexplosion.com/privacy/">privacy policy</a>.</span></label>
          <button class="button button-gold" type="submit">Join the list</button>
          <p class="form-status" role="status"></p>
        </form>
      </div>
    </section>
    <footer class="site-footer">
      <div class="shell footer-grid">
        <a class="footer-brand" href="/"><img src="/media/brand/explosion-logo.webp" alt="Bachata Explosion" width="184" height="64" /></a>
        <nav aria-label="Legal navigation">
          <a href="/imprint/">Imprint</a>
          <a href="https://bachataexplosion.com/privacy/">Privacy</a>
          <a href="https://bachataexplosion.com/terms-conditions/">Terms</a>
          <a href="/contact/">Contact</a>
        </nav>
        <address>
          <strong>Elena & Dennis Events UG</strong><br />
          C/O Dennis Boronowski · Berlin<br />
          <a href="mailto:info@bachataexplosion.com">info@bachataexplosion.com</a>
        </address>
      </div>
    </footer>
    <a class="mobile-ticket-dock" href="/festival/#tickets"><span>BBF 2026</span><strong>Get tickets →</strong></a>
    <script>
      document.querySelectorAll<HTMLFormElement>("[data-endpoint-form]").forEach((form) => {
        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          const status = form.querySelector<HTMLElement>(".form-status");
          const button = form.querySelector<HTMLButtonElement>("button[type='submit']");
          const endpoint = form.getAttribute("action");

          if (!endpoint) {
            if (status) status.textContent = form.dataset.previewMessage ?? "This form is ready to connect before launch.";
            return;
          }

          if (button) button.disabled = true;
          if (status) status.textContent = "Sending…";
          try {
            const response = await fetch(endpoint, {
              method: "POST",
              body: new FormData(form),
              headers: { Accept: "application/json" },
            });
            if (!response.ok) throw new Error("Submission failed");
            form.reset();
            if (status) status.textContent = form.dataset.successMessage ?? "Thank you—your message has been sent.";
          } catch {
            if (status) status.textContent = "That did not go through. Please email info@bachataexplosion.com instead.";
          } finally {
            if (button) button.disabled = false;
          }
        });
      });
    </script>
  </body>
</html>
