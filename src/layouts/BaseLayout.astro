---
import "../styles/global.css";
import "../styles/site-consistency-v2.css";
import "../styles/urban-gold.css";
import "../styles/urban-full-site.css";
import "../styles/site-polish.css";
import { ticketUrl } from "../data/festival";

const whatsappUrl = "https://chat.whatsapp.com/D6Qo0TvbwfMLenL9ajiaHK";

interface Props {
  title?: string;
  description?: string;
  headerStyle?: "overlay" | "solid";
}

const {
  title = "Bachata Explosion — By dancers, for dancers",
  description = "Berlin bachata festivals, workshops, socials and a growing event archive — built by dancers, for dancers.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL("/og.png", Astro.site);
const currentPath = Astro.url.pathname;
const current = (path: string) => currentPath === path || (path !== "/" && currentPath.startsWith(path));
const festivalActive = current("/bbf-2026/") || current("/jj/");
const eventsActive = current("/archive/") || current("/role-rotation") || current("/elite-dance");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#070707" />
    <link rel="icon" href="/media/brand/explosion-logo.webp" type="image/webp" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Bachata Explosion — Berlin Bachata Festival, October 16–18, 2026" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
    <style is:global>
      body.ticket-modal-open{overflow:hidden}
      .ticket-modal[hidden]{display:none!important}
      .ticket-modal{position:fixed;z-index:2000;inset:0;display:grid;place-items:center;padding:24px;background:rgba(5,5,5,.78);backdrop-filter:blur(10px)}
      .ticket-modal__backdrop{position:absolute;inset:0;border:0;background:transparent;cursor:pointer}
      .ticket-modal__panel{position:relative;z-index:1;width:min(980px,100%);height:min(900px,92dvh);display:grid;grid-template-rows:auto minmax(0,1fr);overflow:hidden;border:1px solid rgba(255,255,255,.16);border-radius:18px;background:#f7f4ed;box-shadow:0 40px 120px rgba(0,0,0,.55)}
      .ticket-modal__bar{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:14px 16px 14px 20px;border-bottom:1px solid #d8d2c5;background:#f7f4ed;color:#151515}
      .ticket-modal__bar div{display:grid;gap:2px}
      .ticket-modal__bar strong{font:800 .84rem/1.15 var(--body);letter-spacing:.08em;text-transform:uppercase}
      .ticket-modal__bar span{color:#746f66;font:650 .72rem/1.25 var(--body)}
      .ticket-modal__close{width:42px;height:42px;display:grid;place-items:center;border:1px solid #b9b3a8;border-radius:50%;background:#fff;color:#111;font:500 1.45rem/1 Arial,sans-serif;cursor:pointer;transition:.16s ease}
      .ticket-modal__close:hover,.ticket-modal__close:focus-visible{border-color:#111;background:#111;color:#fff;outline:none}
      .ticket-modal__body{min-height:0;overflow:auto;background:#fff;overscroll-behavior:contain}
      .ticket-modal__frame{display:block;width:100%;height:100%;min-height:720px;border:0;background:#fff}
      @media(max-width:720px){.ticket-modal{padding:0}.ticket-modal__panel{width:100%;height:100dvh;border:0;border-radius:0}.ticket-modal__bar{padding:11px 12px 11px 16px}.ticket-modal__bar span{display:none}.ticket-modal__frame{min-height:calc(100dvh - 65px)}}
    </style>
  </head>
  <body>
    <div class="site-city-atmosphere" aria-hidden="true"><span class="city-graffiti"></span><span class="city-gate"></span></div>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <a class="brand" href="/" aria-label="Bachata Explosion home">
        <img src="/media/brand/explosion-logo.webp" alt="Bachata Explosion" width="184" height="64" />
      </a>

      <nav class="desktop-nav" aria-label="Main navigation">
        <a class:list={["nav-primary-link", { "nav-section-current": festivalActive }]} href="/bbf-2026/" aria-current={current("/bbf-2026/") ? "page" : undefined}>Festival</a>

        <details class:list={["nav-group", { "is-current": eventsActive }]}> 
          <summary>Events</summary>
          <div class="nav-popover">
            <span>Explore the Explosion formats</span>
            <a href="/archive/role-rotation-2026/"><b>Role Rotation</b><small>Lead, follow and understand both sides of connection</small></a>
            <a href="/archive/elite-dance-3/"><b>Elite Dance</b><small>A more focused and intimate event format</small></a>
            <a href="/archive/" aria-current={current("/archive/") ? "page" : undefined}><b>Past events</b><small>The complete Explosion archive since 2022</small></a>
          </div>
        </details>

        <a href="/explosion-history/" aria-current={current("/explosion-history/") ? "page" : undefined}>Our Story</a>
        <a href="/ambassadors/" aria-current={current("/ambassadors/") ? "page" : undefined}>Ambassadors</a>
        <a href="/contact/" aria-current={current("/contact/") ? "page" : undefined}>Contact</a>
      </nav>

      <details class="mobile-nav" data-site-menu>
        <summary aria-label="Open navigation"><span>Menu</span><i aria-hidden="true"></i></summary>
        <div class="mobile-nav-panel">
          <nav aria-label="Mobile navigation">
            <a href="/bbf-2026/" aria-current={current("/bbf-2026/") ? "page" : undefined}>Festival</a>

            <details class="mobile-nav-group">
              <summary><span>Events</span><i aria-hidden="true"></i></summary>
              <div>
                <a href="/archive/role-rotation-2026/">Role Rotation</a>
                <a href="/archive/elite-dance-3/">Elite Dance</a>
                <a href="/archive/" aria-current={current("/archive/") ? "page" : undefined}>Past events</a>
              </div>
            </details>

            <a href="/explosion-history/" aria-current={current("/explosion-history/") ? "page" : undefined}>Our Story</a>
            <a href="/ambassadors/" aria-current={current("/ambassadors/") ? "page" : undefined}>Ambassadors</a>
            <a href="/contact/" aria-current={current("/contact/") ? "page" : undefined}>Contact</a>
          </nav>
          <div class="mobile-nav-meta">
            <span>Born in Berlin · open to the world</span>
            <a href="/volunteers/">Volunteer</a>
            <a href="/insider/">Explosion Insider</a>
            <a href="https://instagram.com/bachataexplosion_official">Instagram ↗</a>
            <a href={whatsappUrl}>WhatsApp ↗</a>
          </div>
        </div>
      </details>

      <a class="button button-small button-gold" href={ticketUrl} data-ticket-checkout>Get tickets</a>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-grid">
        <a class="footer-brand" href="/"><img src="/media/brand/explosion-logo.webp" alt="Bachata Explosion" width="184" height="64" /></a>
        <nav aria-label="Footer navigation">
          <a href="/bbf-2026/">Festival</a>
          <a href="/archive/">Past events</a>
          <a href="/explosion-history/">Our story</a>
          <a href="/ambassadors/">Ambassadors</a>
          <a href="/volunteers/">Volunteers</a>
          <a href="/insider/">Insider</a>
          <a href="/contact/">Contact</a>
          <a href="/imprint/">Imprint</a>
          <a href="/privacy/">Privacy</a>
          <a href="/terms-conditions/">Terms</a>
          <a href={whatsappUrl}>WhatsApp</a>
        </nav>
        <address>
          <strong>Elena &amp; Dennis Events UG</strong><br />
          C/O Dennis Boronowski · Berlin<br />
          <a href="mailto:info@bachataexplosion.com">info@bachataexplosion.com</a>
        </address>
      </div>
    </footer>

    <a class="mobile-ticket-dock" href={ticketUrl} data-ticket-checkout><span>BBF 2026</span><strong>Get tickets →</strong></a>

    <div class="ticket-modal" data-ticket-modal hidden>
      <button class="ticket-modal__backdrop" type="button" aria-label="Close ticket checkout" data-ticket-close></button>
      <section class="ticket-modal__panel" role="dialog" aria-modal="true" aria-labelledby="ticket-modal-title">
        <div class="ticket-modal__bar">
          <div><strong id="ticket-modal-title">Berlin Bachata Festival 2026 · Tickets</strong><span>Choose your pass without leaving Bachata Explosion.</span></div>
          <button class="ticket-modal__close" type="button" aria-label="Close ticket checkout" data-ticket-close>×</button>
        </div>
        <div class="ticket-modal__body">
          <iframe class="ticket-modal__frame" title="Berlin Bachata Festival 2026 ticket checkout" data-ticket-frame data-src={ticketUrl} allow="payment *; clipboard-write" loading="lazy"></iframe>
        </div>
      </section>
    </div>

    <script>
      const dropdowns = Array.from(document.querySelectorAll<HTMLDetailsElement>(".nav-group"));
      const siteMenu = document.querySelector<HTMLDetailsElement>("[data-site-menu]");
      const mobileGroups = Array.from(document.querySelectorAll<HTMLDetailsElement>(".mobile-nav-group"));
      const heroVideo = document.querySelector<HTMLVideoElement>(".ug-hero-video");
      const ticketModal = document.querySelector<HTMLElement>("[data-ticket-modal]");
      const ticketFrame = document.querySelector<HTMLIFrameElement>("[data-ticket-frame]");
      const ticketCloseButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-ticket-close]"));
      let ticketTrigger: HTMLElement | null = null;

      heroVideo?.play().catch(() => undefined);

      const closeTicketModal = () => {
        if (!ticketModal || ticketModal.hidden) return;
        ticketModal.hidden = true;
        document.body.classList.remove("ticket-modal-open");
        ticketTrigger?.focus();
      };

      const openTicketModal = (trigger: HTMLElement) => {
        if (!ticketModal || !ticketFrame) return false;
        ticketTrigger = trigger;
        if (!ticketFrame.src) {
          const source = ticketFrame.dataset.src;
          if (source) ticketFrame.src = source;
        }
        ticketModal.hidden = false;
        document.body.classList.add("ticket-modal-open");
        requestAnimationFrame(() => ticketModal.querySelector<HTMLButtonElement>(".ticket-modal__close")?.focus());
        return true;
      };

      document.querySelectorAll<HTMLAnchorElement>("[data-ticket-checkout]").forEach((link) => {
        link.addEventListener("click", (event) => {
          if (openTicketModal(link)) event.preventDefault();
        });
      });
      ticketCloseButtons.forEach((button) => button.addEventListener("click", closeTicketModal));

      dropdowns.forEach((dropdown) => {
        dropdown.addEventListener("toggle", () => {
          if (!dropdown.open) return;
          dropdowns.forEach((candidate) => {
            if (candidate !== dropdown) candidate.open = false;
          });
        });
        dropdown.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => { dropdown.open = false; }));
      });

      document.addEventListener("click", (event) => {
        const target = event.target as Node;
        dropdowns.forEach((dropdown) => {
          if (!dropdown.contains(target)) dropdown.open = false;
        });
      });

      siteMenu?.addEventListener("toggle", () => {
        document.documentElement.classList.toggle("menu-is-open", Boolean(siteMenu.open));
        if (siteMenu.open) {
          dropdowns.forEach((dropdown) => { dropdown.open = false; });
        } else {
          mobileGroups.forEach((group) => { group.open = false; });
        }
      });

      mobileGroups.forEach((group) => group.addEventListener("toggle", () => {
        if (!group.open) return;
        mobileGroups.forEach((candidate) => {
          if (candidate !== group) candidate.open = false;
        });
      }));

      siteMenu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => {
        siteMenu.open = false;
      }));

      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;
        if (ticketModal && !ticketModal.hidden) {
          closeTicketModal();
          return;
        }
        dropdowns.forEach((dropdown) => { dropdown.open = false; });
        if (siteMenu) siteMenu.open = false;
      });
    </script>
  </body>
</html>