---
import "../styles/global.css";
import "../styles/explosion-original-modern.css";
import "../styles/explosion-premium-berlin.css";
import "../styles/explosion-berlin-unified.css";
import "../styles/explosion-feedback-sept1.css";
import "../styles/explosion-feedback-density.css";
import "../styles/explosion-feedback-round2.css";
import "../styles/explosion-feedback-round2-controls.css";
import "../styles/explosion-feedback-screens.css";
import "../styles/explosion-feedback-sept2.css";
import "../styles/explosion-feedback-sept2-final.css";
import { ticketUrl } from "../data/festival";

const whatsappUrl = "https://chat.whatsapp.com/D6Qo0TvbwfMLenL9ajiaHK";

interface Props {
  title?: string;
  description?: string;
  headerStyle?: "overlay" | "solid";
}

const {
  title = "Bachata Explosion — By dancers, for dancers",
  description = "Berlin bachata festivals, workshops, socials and a growing event archive — built by dancers, for dancers.",
  headerStyle = "solid",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL("/og.png", Astro.site);
const currentPath = Astro.url.pathname;
const current = (path: string) => currentPath === path || (path !== "/" && currentPath.startsWith(path));
const festivalActive = current("/bbf-2026/") || current("/jj/");
const archiveActive = current("/archive/") || current("/role-rotation") || current("/elite-dance");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#11070b" />
    <link rel="icon" href="/media/brand/explosion-logo.webp" type="image/webp" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Bachata Explosion — Berlin Bachata Festival, October 16–18, 2026" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class:list={["site-header", headerStyle === "solid" && "site-header-solid"]}>
      <a class="brand" href="/" aria-label="Bachata Explosion home"><img src="/media/brand/explosion-logo.webp" alt="Bachata Explosion" width="184" height="64" /></a>

      <nav class="desktop-nav" aria-label="Main navigation">
        <details class:list={["nav-group", { "is-current": festivalActive }]}>
          <summary>Festival</summary>
          <div class="nav-popover">
            <span>Berlin Bachata Festival 2026</span>
            <a href="/bbf-2026/"><b>Festival overview</b><small>16–18 October · MOA Berlin</small></a>
            <a href="/bbf-2026/#venue"><b>Venue & hotel</b><small>MOA Berlin and official room deal</small></a>
            <a href="/bbf-2026/#artists"><b>Artists</b><small>International lineup and DJs</small></a>
            <a href="/bbf-2026/#schedule"><b>Schedule</b><small>Friday to Sunday</small></a>
            <a href="/bbf-2026/#jj"><b>Jack & Jill</b><small>Competition and registration</small></a>
            <a href="/bbf-2026/#passes"><b>Passes</b><small>Full, Gold and Party</small></a>
            <a href="/bbf-2026/#travel"><b>Berlin & travel</b><small>Airport, train and local arrival</small></a>
            <a href="/bbf-2026/#faq"><b>FAQ</b><small>Practical festival answers</small></a>
          </div>
        </details>

        <a href="/explosion-history/" aria-current={current("/explosion-history/") ? "page" : undefined}>Our Story</a>
        <a href="/ambassadors/" aria-current={current("/ambassadors/") ? "page" : undefined}>Ambassadors</a>
        <a href="/volunteers/" aria-current={current("/volunteers/") ? "page" : undefined}>Volunteers</a>
        <a href="/archive/" aria-current={archiveActive ? "page" : undefined}>Past Events</a>
        <a href="/contact/" aria-current={current("/contact/") ? "page" : undefined}>Contact</a>
      </nav>

      <details class="mobile-nav" data-site-menu>
        <summary aria-label="Open navigation"><span>Menu</span><i aria-hidden="true"></i></summary>
        <div class="mobile-nav-panel">
          <nav aria-label="Mobile navigation">
            <details class="mobile-nav-group">
              <summary><span>Festival</span><i aria-hidden="true"></i></summary>
              <div>
                <a href="/bbf-2026/">Festival overview</a>
                <a href="/bbf-2026/#venue">Venue & hotel</a>
                <a href="/bbf-2026/#artists">Artists</a>
                <a href="/bbf-2026/#schedule">Schedule</a>
                <a href="/bbf-2026/#jj">Jack & Jill</a>
                <a href="/bbf-2026/#passes">Passes</a>
                <a href="/bbf-2026/#travel">Berlin & travel</a>
                <a href="/bbf-2026/#faq">FAQ</a>
              </div>
            </details>
            <a href="/explosion-history/">Our Story</a>
            <a href="/ambassadors/">Ambassadors</a>
            <a href="/volunteers/">Volunteers</a>
            <a href="/archive/">Past Events</a>
            <a href="/contact/">Contact</a>
          </nav>
          <div class="mobile-nav-meta">
            <span>By dancers, for dancers · Berlin</span>
            <a href="/insider/">Explosion Insider</a>
            <a href="https://instagram.com/bachataexplosion_official">Instagram ↗</a>
            <a href={whatsappUrl}>WhatsApp ↗</a>
          </div>
        </div>
      </details>

      <a class="button button-small button-gold" href={ticketUrl}>Get tickets</a>
    </header>

    <main id="main"><slot /></main>

    <footer class="site-footer">
      <div class="shell footer-grid">
        <div class="footer-brand-block"><a class="footer-brand" href="/"><img src="/media/brand/explosion-logo.webp" alt="Bachata Explosion" width="184" height="64" /></a><p>Berlin dance experiences built by dancers, for dancers.</p></div>
        <nav aria-label="Footer navigation">
          <a href="/bbf-2026/">Festival</a><a href="/bbf-2026/#travel">Berlin & travel</a><a href="/explosion-history/">Our Story</a><a href="/ambassadors/">Ambassadors</a><a href="/volunteers/">Volunteers</a><a href="/archive/">Past Events</a><a href="/contact/">Contact</a><a href="/imprint/">Imprint</a><a href="/privacy/">Privacy</a><a href="/terms-conditions/">Terms</a>
        </nav>
        <address><strong>Elena &amp; Dennis Events UG</strong><br />Berlin, Germany<br /><a href="mailto:info@bachataexplosion.com">info@bachataexplosion.com</a><br /><a href={whatsappUrl}>Festival WhatsApp ↗</a></address>
      </div>
    </footer>

    <a class="mobile-ticket-dock" href={ticketUrl}><span>BBF 2026</span><strong>Get tickets →</strong></a>
    <button class="back-to-top" type="button" aria-label="Back to top" title="Back to top">↑</button>

    <script>
      const dropdowns = Array.from(document.querySelectorAll<HTMLDetailsElement>(".nav-group"));
      const siteMenu = document.querySelector<HTMLDetailsElement>("[data-site-menu]");
      const mobileGroups = Array.from(document.querySelectorAll<HTMLDetailsElement>(".mobile-nav-group"));
      const heroVideos = Array.from(document.querySelectorAll<HTMLVideoElement>(".home-hero-video,.impact-hero-video,.bbf-hero-video,.ex-hero video"));
      const backToTop = document.querySelector<HTMLButtonElement>(".back-to-top");

      heroVideos.forEach((video) => video.play().catch(() => undefined));
      dropdowns.forEach((dropdown) => {
        dropdown.addEventListener("toggle", () => { if (!dropdown.open) return; dropdowns.forEach((candidate) => { if (candidate !== dropdown) candidate.open = false; }); });
        dropdown.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => { dropdown.open = false; }));
      });
      document.addEventListener("click", (event) => { const target = event.target as Node; dropdowns.forEach((dropdown) => { if (!dropdown.contains(target)) dropdown.open = false; }); });
      siteMenu?.addEventListener("toggle", () => { document.documentElement.classList.toggle("menu-is-open", Boolean(siteMenu.open)); if (!siteMenu.open) mobileGroups.forEach((group) => { group.open = false; }); });
      mobileGroups.forEach((group) => group.addEventListener("toggle", () => { if (!group.open) return; mobileGroups.forEach((candidate) => { if (candidate !== group) candidate.open = false; }); }));
      siteMenu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => { siteMenu.open = false; }));
      document.addEventListener("keydown", (event) => { if (event.key !== "Escape") return; dropdowns.forEach((dropdown) => { dropdown.open = false; }); if (siteMenu) siteMenu.open = false; });
      const syncBackToTop = () => { if (!backToTop) return; backToTop.dataset.visible = window.scrollY > 720 ? "true" : "false"; };
      syncBackToTop(); window.addEventListener("scroll", syncBackToTop, { passive: true }); backToTop?.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }));

      window.addEventListener("DOMContentLoaded", () => {
        const bbf = document.querySelector<HTMLElement>(".bbf-premium");
        if (bbf) {
          const roomImages = Array.from(bbf.querySelectorAll<HTMLImageElement>(".bbf-room-media img"));
          roomImages.forEach((image, index) => {
            image.src = "/media/bbf/venue/location.png";
            image.alt = `Hotel MOA Berlin room example for ${index === 0 ? "single" : index === 1 ? "double" : "3-person"} room booking`;
          });
          const faqTitle = bbf.querySelector<HTMLElement>("#faq .bbf-faq-intro h2");
          if (faqTitle) faqTitle.innerHTML = "Questions?<br><em>We have answers.</em>";
        }

        const volunteerHero = document.querySelector<HTMLElement>("[data-volunteer-hero]");
        const volunteerTrack = volunteerHero?.querySelector<HTMLElement>("[data-volunteer-track]");
        if (volunteerHero && volunteerTrack) {
          volunteerHero.querySelector(".volunteer-we-are")?.remove();
          volunteerHero.querySelector(".volunteer-slider-ui")?.remove();
          const groupPhotos = [
            ["/media/atmosphere/explosion-community.jpg", "Bachata Explosion community group"],
            ["/media/bbf/atmosphere/saturday-62.jpg", "Bachata Explosion festival group"],
            ["/media/bbf/atmosphere/saturday-60.jpg", "Bachata Explosion dancers together"],
            ["/media/atmosphere/party-crowd.webp", "Bachata Explosion social community"],
            ["/media/bbf/atmosphere/party-141.jpg", "Bachata Explosion event crowd"],
            ["/media/bbf/atmosphere/party-143.jpg", "Bachata Explosion party community"],
          ];
          volunteerTrack.innerHTML = groupPhotos.map(([src, alt], index) => `<figure class="volunteer-slide${index === 0 ? " is-active" : ""}" data-auto-volunteer-slide><img src="${src}" alt="${alt}" width="1600" height="1000" ${index === 0 ? "" : "loading=\"lazy\""}></figure>`).join("");
          const slides = Array.from(volunteerTrack.querySelectorAll<HTMLElement>("[data-auto-volunteer-slide]"));
          let active = 0;
          if (slides.length > 1 && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            window.setInterval(() => {
              slides[active]?.classList.remove("is-active");
              active = (active + 1) % slides.length;
              slides[active]?.classList.add("is-active");
            }, 4300);
          }
        }

        const historySidebar = document.querySelector<HTMLElement>('.wp-preserved-page[data-wordpress-source="explosion-history"] .be-history__sidebar');
        if (historySidebar) {
          const historySection = historySidebar.closest<HTMLElement>(".be-history") ?? historySidebar.parentElement;
          historySidebar.style.setProperty("position", "static", "important");
          historySidebar.style.setProperty("max-height", "none", "important");
          historySidebar.style.setProperty("overflow", "visible", "important");

          if (historySection) {
            const floating = historySidebar.cloneNode(true) as HTMLElement;
            floating.classList.add("history-floating-nav");
            floating.removeAttribute("id");
            document.body.appendChild(floating);

            const syncHistoryNav = () => {
              if (window.innerWidth <= 900) {
                floating.style.display = "none";
                return;
              }
              const sourceRect = historySidebar.getBoundingClientRect();
              const sectionRect = historySection.getBoundingClientRect();
              const top = 102;
              floating.style.left = `${sourceRect.left}px`;
              floating.style.width = `${sourceRect.width}px`;
              const shouldFloat = sourceRect.top <= top && sectionRect.bottom > top + 220;
              floating.style.display = shouldFloat ? "block" : "none";
            };

            const floatingLinks = Array.from(floating.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'));
            const syncHistoryActive = () => {
              const candidates = floatingLinks
                .map((link) => ({ link, target: document.querySelector<HTMLElement>(link.getAttribute("href") || "") }))
                .filter((item): item is { link: HTMLAnchorElement; target: HTMLElement } => Boolean(item.target));
              let currentTarget: HTMLElement | undefined;
              for (const { target } of candidates) {
                if (target.getBoundingClientRect().top <= 180) currentTarget = target;
              }
              floatingLinks.forEach((link) => link.classList.toggle("is-active", Boolean(currentTarget && link.getAttribute("href") === `#${currentTarget.id}`)));
            };

            const syncHistory = () => { syncHistoryNav(); syncHistoryActive(); };
            syncHistory();
            window.addEventListener("scroll", syncHistory, { passive: true });
            window.addEventListener("resize", syncHistory);
          }
        }
      });
    </script>
  </body>
</html>