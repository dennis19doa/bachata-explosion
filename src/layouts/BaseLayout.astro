---
import "../styles/global.css";
import "../styles/explosion-modern.css";
import { ticketUrl } from "../data/festival";

const whatsappUrl = "https://chat.whatsapp.com/D6Qo0TvbwfMLenL9ajiaHK";

interface Props {
  title?: string;
  description?: string;
  headerStyle?: "overlay" | "solid";
}

const {
  title = "Bachata Explosion — By dancers, for dancers",
  description = "Berlin bachata festivals, workshops, socials and a growing event archive — built by dancers, for dancers.",
  headerStyle = "solid",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL("/og.png", Astro.site);
const currentPath = Astro.url.pathname;
const current = (path: string) => currentPath === path || (path !== "/" && currentPath.startsWith(path));
const festivalActive = current("/bbf-2026/") || current("/jj/");
const eventsActive = current("/archive/") || current("/role-rotation") || current("/elite-dance");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f0e8" />
    <link rel="icon" href="/media/brand/explosion-logo.webp" type="image/webp" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Bachata Explosion — Berlin Bachata Festival, October 16–18, 2026" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class:list={["site-header", headerStyle === "solid" && "site-header-solid"]}>
      <a class="brand" href="/" aria-label="Bachata Explosion home">
        <img src="/media/brand/explosion-logo.webp" alt="Bachata Explosion" width="184" height="64" />
      </a>

      <nav class="desktop-nav" aria-label="Main navigation">
        <a class:list={[{ "nav-section-current": festivalActive }]} href="/bbf-2026/" aria-current={current("/bbf-2026/") ? "page" : undefined}>Festival</a>
        <details class:list={["nav-group", { "is-current": eventsActive }]}> 
          <summary>Events</summary>
          <div class="nav-popover">
            <span>Explosion events</span>
            <a href="/archive/role-rotation-2026/"><b>Role Rotation</b><small>Connection from both sides</small></a>
            <a href="/archive/elite-dance-3/"><b>Elite Dance</b><small>A focused, intimate edition</small></a>
            <a href="/archive/"><b>Past events</b><small>Every Explosion since 2022</small></a>
          </div>
        </details>
        <a href="/explosion-history/" aria-current={current("/explosion-history/") ? "page" : undefined}>Our Story</a>
        <a href="/ambassadors/" aria-current={current("/ambassadors/") ? "page" : undefined}>Ambassadors</a>
        <a href="/contact/" aria-current={current("/contact/") ? "page" : undefined}>Contact</a>
      </nav>

      <details class="mobile-nav" data-site-menu>
        <summary aria-label="Open navigation"><span>Menu</span><i aria-hidden="true"></i></summary>
        <div class="mobile-nav-panel">
          <nav aria-label="Mobile navigation">
            <a href="/bbf-2026/">Festival</a>
            <details class="mobile-nav-group">
              <summary><span>Events</span><i aria-hidden="true"></i></summary>
              <div>
                <a href="/archive/role-rotation-2026/">Role Rotation</a>
                <a href="/archive/elite-dance-3/">Elite Dance</a>
                <a href="/archive/">Past events</a>
              </div>
            </details>
            <a href="/explosion-history/">Our Story</a>
            <a href="/ambassadors/">Ambassadors</a>
            <a href="/contact/">Contact</a>
          </nav>
          <div class="mobile-nav-meta">
            <span>By dancers, for dancers · Berlin</span>
            <a href="/volunteers/">Volunteer</a>
            <a href="/insider/">Explosion Insider</a>
            <a href="https://instagram.com/bachataexplosion_official">Instagram ↗</a>
            <a href={whatsappUrl}>WhatsApp ↗</a>
          </div>
        </div>
      </details>

      <a class="button button-small button-gold" href={ticketUrl}>Get tickets</a>
    </header>

    <main id="main"><slot /></main>

    <footer class="site-footer">
      <div class="shell footer-grid">
        <div class="footer-brand-block">
          <a class="footer-brand" href="/"><img src="/media/brand/explosion-logo.webp" alt="Bachata Explosion" width="184" height="64" /></a>
          <p>Berlin dance experiences built by dancers, for dancers.</p>
        </div>
        <nav aria-label="Footer navigation">
          <a href="/bbf-2026/">Festival</a>
          <a href="/archive/">Past events</a>
          <a href="/explosion-history/">Our Story</a>
          <a href="/ambassadors/">Ambassadors</a>
          <a href="/volunteers/">Volunteers</a>
          <a href="/contact/">Contact</a>
          <a href="/imprint/">Imprint</a>
          <a href="/privacy/">Privacy</a>
          <a href="/terms-conditions/">Terms</a>
        </nav>
        <address>
          <strong>Elena &amp; Dennis Events UG</strong><br />
          Berlin, Germany<br />
          <a href="mailto:info@bachataexplosion.com">info@bachataexplosion.com</a><br />
          <a href={whatsappUrl}>Festival WhatsApp ↗</a>
        </address>
      </div>
    </footer>

    <a class="mobile-ticket-dock" href={ticketUrl}><span>BBF 2026</span><strong>Get tickets →</strong></a>

    <script>
      const dropdowns = Array.from(document.querySelectorAll<HTMLDetailsElement>(".nav-group"));
      const siteMenu = document.querySelector<HTMLDetailsElement>("[data-site-menu]");
      const mobileGroups = Array.from(document.querySelectorAll<HTMLDetailsElement>(".mobile-nav-group"));
      const heroVideos = Array.from(document.querySelectorAll<HTMLVideoElement>(".home-hero-video,.impact-hero-video,.bbf-hero-video"));

      heroVideos.forEach((video) => video.play().catch(() => undefined));

      dropdowns.forEach((dropdown) => {
        dropdown.addEventListener("toggle", () => {
          if (!dropdown.open) return;
          dropdowns.forEach((candidate) => { if (candidate !== dropdown) candidate.open = false; });
        });
        dropdown.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => { dropdown.open = false; }));
      });

      document.addEventListener("click", (event) => {
        const target = event.target as Node;
        dropdowns.forEach((dropdown) => { if (!dropdown.contains(target)) dropdown.open = false; });
      });

      siteMenu?.addEventListener("toggle", () => {
        document.documentElement.classList.toggle("menu-is-open", Boolean(siteMenu.open));
        if (!siteMenu.open) mobileGroups.forEach((group) => { group.open = false; });
      });

      mobileGroups.forEach((group) => group.addEventListener("toggle", () => {
        if (!group.open) return;
        mobileGroups.forEach((candidate) => { if (candidate !== group) candidate.open = false; });
      }));

      siteMenu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => { siteMenu.open = false; }));

      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;
        dropdowns.forEach((dropdown) => { dropdown.open = false; });
        if (siteMenu) siteMenu.open = false;
      });
    </script>
  </body>
</html>