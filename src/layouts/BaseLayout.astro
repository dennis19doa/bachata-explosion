---
import "../styles/global.css";
import "../styles/berlin-web.css";
import { ticketUrl } from "../data/festival";

const whatsappUrl = "https://chat.whatsapp.com/D6Qo0TvbwfMLenL9ajiaHK";

interface Props {
  title?: string;
  description?: string;
  headerStyle?: "overlay" | "solid";
}

const {
  title = "Bachata Explosion — By dancers, for dancers",
  description = "Berlin bachata festivals, workshops, socials and a growing event archive — built by dancers, for dancers.",
  headerStyle = "overlay",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL("/og.png", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fff8ec" />
    <link rel="icon" href="/media/brand/explosion-logo.webp" type="image/webp" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Bachata Explosion — Berlin Bachata Festival, October 16–18, 2026" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class:list={["site-header", headerStyle === "solid" && "site-header-solid"]}>
      <a class="brand" href="/" aria-label="Bachata Explosion home">
        <img src="/media/brand/explosion-logo.webp" alt="Bachata Explosion" width="184" height="64" />
      </a>

      <nav class="desktop-nav" aria-label="Main navigation">
        <a class="nav-home" href="/">Home</a>
        <details class="nav-group">
          <summary>Festival</summary>
          <div class="nav-popover">
            <span>Berlin Bachata Festival · 16–18 October 2026</span>
            <a href="/bbf-2026/"><b>Festival overview</b><small>Artists, venue, passes and everything you need</small></a>
            <a href="/bbf-2026/#schedule"><b>Schedule</b><small>Workshops, parties and weekend program</small></a>
            <a href="/jj/"><b>Jack &amp; Jill</b><small>Competition, rules and registration</small></a>
          </div>
        </details>
        <details class="nav-group">
          <summary>Berlin</summary>
          <div class="nav-popover">
            <span>Make a Berlin weekend out of it</span>
            <a href="/bbf-2026/#venue"><b>Hotel &amp; venue</b><small>Stay and dance at MOA Berlin</small></a>
            <a href="/bbf-2026/#travel"><b>Travel to Berlin</b><small>Airports, Hauptbahnhof and local transport</small></a>
            <a href={whatsappUrl}><b>Festival community ↗</b><small>Meet dancers before you arrive</small></a>
          </div>
        </details>
        <a href="/archive/">Past events</a>
        <details class="nav-group">
          <summary>About</summary>
          <div class="nav-popover nav-popover-right">
            <span>By dancers, for dancers — born in Berlin</span>
            <a href="/explosion-history/"><b>Our story</b><small>How Bachata Explosion grew since 2022</small></a>
            <a href="/ambassadors/"><b>Ambassadors</b><small>Carry the Explosion into your city</small></a>
            <a href="/volunteers/"><b>Volunteers</b><small>Help make the weekend happen</small></a>
          </div>
        </details>
        <a href="/contact/">Contact</a>
      </nav>

      <details class="mobile-nav" data-site-menu>
        <summary aria-label="Open navigation"><span>Menu</span><i aria-hidden="true"></i></summary>
        <div class="mobile-nav-panel">
          <nav aria-label="Mobile navigation">
            <a class="mobile-nav-home" href="/">Home</a>
            <details class="mobile-nav-group">
              <summary><span>Festival</span><i aria-hidden="true"></i></summary>
              <div>
                <a href="/bbf-2026/">Berlin Bachata Festival</a>
                <a href="/bbf-2026/#schedule">Schedule</a>
                <a href="/jj/">Jack &amp; Jill</a>
              </div>
            </details>
            <details class="mobile-nav-group">
              <summary><span>Berlin</span><i aria-hidden="true"></i></summary>
              <div>
                <a href="/bbf-2026/#venue">Hotel &amp; venue</a>
                <a href="/bbf-2026/#travel">Travel to Berlin</a>
                <a href={whatsappUrl}>Festival community ↗</a>
              </div>
            </details>
            <details class="mobile-nav-group">
              <summary><span>About</span><i aria-hidden="true"></i></summary>
              <div>
                <a href="/archive/">Past events</a>
                <a href="/explosion-history/">Our story</a>
                <a href="/ambassadors/">Ambassadors</a>
                <a href="/volunteers/">Volunteers</a>
                <a href="/contact/">Contact</a>
              </div>
            </details>
          </nav>
          <div class="mobile-nav-meta">
            <span>Born in Berlin · open to the world</span>
            <a href="https://instagram.com/bachataexplosion_official">Instagram ↗</a>
          </div>
        </div>
      </details>

      <a class="button button-small button-gold" href={ticketUrl}>Get tickets</a>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-grid">
        <a class="footer-brand" href="/"><img src="/media/brand/explosion-logo.webp" alt="Bachata Explosion" width="184" height="64" /></a>
        <nav aria-label="Legal navigation">
          <a href="/archive/">Past events</a>
          <a href="/explosion-history/">History</a>
          <a href="/imprint/">Imprint</a>
          <a href="/privacy/">Privacy</a>
          <a href="/terms-conditions/">Terms</a>
          <a href="/contact/">Contact</a>
          <a href={whatsappUrl}>WhatsApp</a>
        </nav>
        <address>
          <strong>Elena &amp; Dennis Events UG</strong><br />
          C/O Dennis Boronowski · Berlin<br />
          <a href="mailto:info@bachataexplosion.com">info@bachataexplosion.com</a>
        </address>
      </div>
    </footer>

    <a class="mobile-ticket-dock" href={ticketUrl}><span>BBF 2026</span><strong>Get tickets →</strong></a>

    <script>
      const dropdowns = Array.from(document.querySelectorAll<HTMLDetailsElement>(".nav-group"));
      const siteMenu = document.querySelector<HTMLDetailsElement>("[data-site-menu]");
      const mobileGroups = Array.from(document.querySelectorAll<HTMLDetailsElement>(".mobile-nav-group"));
      const heroVideo = document.querySelector<HTMLVideoElement>(".home-hero-video");

      heroVideo?.play().catch(() => undefined);

      dropdowns.forEach((dropdown) => {
        dropdown.addEventListener("toggle", () => {
          if (!dropdown.open) return;
          dropdowns.forEach((candidate) => {
            if (candidate !== dropdown) candidate.open = false;
          });
        });
        dropdown.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => { dropdown.open = false; }));
      });

      document.addEventListener("click", (event) => {
        const target = event.target as Node;
        dropdowns.forEach((dropdown) => {
          if (!dropdown.contains(target)) dropdown.open = false;
        });
      });

      siteMenu?.addEventListener("toggle", () => {
        document.documentElement.classList.toggle("menu-is-open", Boolean(siteMenu.open));
        if (siteMenu.open) {
          dropdowns.forEach((dropdown) => { dropdown.open = false; });
        } else {
          mobileGroups.forEach((group) => { group.open = false; });
        }
      });

      mobileGroups.forEach((group) => group.addEventListener("toggle", () => {
        if (!group.open) return;
        mobileGroups.forEach((candidate) => {
          if (candidate !== group) candidate.open = false;
        });
      }));

      siteMenu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => {
        siteMenu.open = false;
      }));

      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;
        dropdowns.forEach((dropdown) => { dropdown.open = false; });
        if (siteMenu) siteMenu.open = false;
      });
    </script>
  </body>
</html>
