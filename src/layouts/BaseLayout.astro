---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  headerStyle?: "overlay" | "solid";
}

const {
  title = "Bachata Explosion — By dancers, for dancers",
  description = "Berlin bachata festivals, workshops, socials and a growing event archive — built by dancers, for dancers.",
  headerStyle = "overlay",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL("/og.png", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#100609" />
    <link rel="icon" href="/media/brand/explosion-logo.webp" type="image/webp" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Bachata Explosion — Berlin Bachata Festival, October 16–18, 2026" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
  </head>
  <body class="urban-site">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class:list={["site-header", headerStyle === "solid" && "site-header-solid"]}>
      <span class="site-city-code" aria-hidden="true">52.5200° N · 13.4050° E</span>
      <a class="brand" href="/" aria-label="Bachata Explosion home">
        <img src="/media/brand/explosion-logo.webp" alt="Bachata Explosion" width="184" height="64" />
      </a>
      <nav class="desktop-nav" aria-label="Main navigation">
        <a class="nav-home" href="/">Home</a>
        <details class="nav-group">
          <summary>Berlin Bachata Festival</summary>
          <div class="nav-popover">
            <span>BBF · October 16–18, 2026</span>
            <a href="/bbf-2026/"><b>Festival overview</b><small>Venue, artists, program & passes</small></a>
            <a href="/jj/"><b>Jack &amp; Jill</b><small>Competition, rules & registration</small></a>
          </div>
        </details>
        <a href="/archive/">Past events</a>
        <a href="/explosion-history/">History</a>
        <a href="/ambassadors/">Ambassadors</a>
        <details class="nav-group">
          <summary>Contact</summary>
          <div class="nav-popover nav-popover-right">
            <span>Talk to the team</span>
            <a href="/contact/"><b>Contact</b><small>Questions, partnerships & support</small></a>
            <a href="/volunteers/"><b>Volunteers</b><small>Help make the weekend happen</small></a>
          </div>
        </details>
      </nav>
      <details class="mobile-nav" data-site-menu>
        <summary aria-label="Open navigation"><span>Menu</span><i aria-hidden="true"></i></summary>
        <div class="mobile-nav-panel">
          <video class="mobile-nav-video" autoplay muted loop playsinline preload="metadata" poster="/media/motion/explosion-particles-poster.webp" aria-hidden="true">
            <source src="/media/video/explosion-menu.mp4" type="video/mp4" />
          </video>
          <div class="mobile-nav-shade" aria-hidden="true"></div>
          <nav aria-label="Mobile navigation">
            <small>Choose your next Explosion</small>
            <a href="/bbf-2026/">Berlin Bachata Festival</a>
            <a href="/jj/">Jack &amp; Jill</a>
            <a href="/archive/">Past events</a>
            <a href="/explosion-history/">History</a>
            <a href="/ambassadors/">Ambassadors</a>
            <a href="/volunteers/">Volunteers</a>
            <a href="/contact/">Contact</a>
          </nav>
          <div class="mobile-nav-meta">
            <span>Berlin · by dancers, for dancers</span>
            <a href="https://instagram.com/bachataexplosion_official">Instagram ↗</a>
          </div>
        </div>
      </details>
      <a class="button button-small button-gold" href="/tickets/">Get tickets</a>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-city-line" aria-hidden="true">BERLIN · BACHATA · PEOPLE FROM EVERYWHERE · BY DANCERS FOR DANCERS ·</div>
      <div class="shell footer-grid">
        <a class="footer-brand" href="/"><img src="/media/brand/explosion-logo.webp" alt="Bachata Explosion" width="184" height="64" /></a>
        <nav aria-label="Legal navigation">
          <a href="/archive/">Past events</a>
          <a href="/explosion-history/">History</a>
          <a href="/imprint/">Imprint</a>
          <a href="/privacy/">Privacy</a>
          <a href="/terms-conditions/">Terms</a>
          <a href="/contact/">Contact</a>
        </nav>
        <address>
          <strong>Elena & Dennis Events UG</strong><br />
          C/O Dennis Boronowski · Berlin<br />
          <a href="mailto:info@bachataexplosion.com">info@bachataexplosion.com</a>
        </address>
      </div>
    </footer>
    <a class="mobile-ticket-dock" href="/tickets/"><span>BBF 2026</span><strong>Get tickets →</strong></a>
    <script>
      const dropdowns = Array.from(document.querySelectorAll<HTMLDetailsElement>(".nav-group"));
      const siteMenu = document.querySelector<HTMLDetailsElement>("[data-site-menu]");
      const menuVideo = siteMenu?.querySelector<HTMLVideoElement>(".mobile-nav-video");
      const heroVideo = document.querySelector<HTMLVideoElement>(".home-hero-video");

      heroVideo?.play().catch(() => undefined);

      dropdowns.forEach((dropdown) => {
        dropdown.addEventListener("toggle", () => {
          if (!dropdown.open) return;
          dropdowns.forEach((candidate) => {
            if (candidate !== dropdown) candidate.open = false;
          });
        });
        dropdown.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => { dropdown.open = false; }));
      });

      document.addEventListener("click", (event) => {
        const target = event.target as Node;
        dropdowns.forEach((dropdown) => {
          if (!dropdown.contains(target)) dropdown.open = false;
        });
      });

      siteMenu?.addEventListener("toggle", () => {
        document.documentElement.classList.toggle("menu-is-open", Boolean(siteMenu.open));
        if (siteMenu.open) {
          dropdowns.forEach((dropdown) => { dropdown.open = false; });
          menuVideo?.play().catch(() => undefined);
        } else {
          menuVideo?.pause();
        }
      });
      siteMenu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => {
        siteMenu.open = false;
      }));

      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;
        dropdowns.forEach((dropdown) => { dropdown.open = false; });
        if (siteMenu) siteMenu.open = false;
      });
    </script>
  </body>
</html>
