---
import BaseLayout from "../../layouts/BaseLayout.astro";
import gallery from "../../data/friday-workshops-2026.json";

type Photo = { path: string; width: number; height: number; alt: string; credit?: string; variants: { path: string; width: number }[] };
const photos = gallery.photos as Photo[];
const mediaOrigin = (import.meta.env.PUBLIC_ARCHIVE_MEDIA_ORIGIN || "https://media.bachataexplosion.com").replace(/\/$/, "");
const source = (path: string) => `${mediaOrigin}/${path.replace(/^\//, "")}`;
---
<BaseLayout title="Friday Workshops 2026 — Bachata Explosion" description="Friday workshop memories from Berlin Bachata Festival 2026. A day of learning, connection and dancing at MOA Berlin.">
  <div class="friday-page shell">
    <header class="friday-heading">
      <a class="text-link" href="/bbf-2026/">← Berlin Bachata Festival 2026</a>
      <p class="section-label">16 October 2026 · MOA Berlin</p>
      <h1>Friday Workshops <em>2026</em></h1>
      <p>A day of learning, connection and dancing. Our Friday workshop memories from Berlin Bachata Festival.</p>
    </header>
    {photos.length > 0 ? <>
      <p class="photo-count">{photos.length} photographs · Select a photo to see it in full</p>
      <div class="friday-gallery" aria-label="Friday workshop photographs">
        {photos.map((photo, index) => <a href={source(photo.path)} data-gallery-photo data-caption={photo.alt} aria-label={`View photo ${index + 1}: ${photo.alt}`}>
          <img src={source(photo.path)} srcset={photo.variants.map((variant) => `${source(variant.path)} ${variant.width}w`).join(", ")} sizes="(max-width: 600px) 100vw, (max-width: 960px) 50vw, 33vw" width={photo.width} height={photo.height} alt={photo.alt} loading={index < 3 ? "eager" : "lazy"} decoding="async" />
          {photo.credit && <span class="photo-credit">{photo.credit}</span>}
        </a>)}
      </div>
      <dialog class="photo-viewer" aria-label="Workshop photo viewer">
        <button class="viewer-close" type="button" aria-label="Close photo viewer">Close ×</button>
        <button class="viewer-prev" type="button" aria-label="Previous photo">←</button>
        <figure><img alt="" /><figcaption aria-live="polite"></figcaption></figure>
        <button class="viewer-next" type="button" aria-label="Next photo">→</button>
      </dialog>
    </> : <div class="gallery-pending"><h2>The gallery is on its way.</h2><p>Friday workshop photographs will appear here once the album is ready.</p></div>}
    <a class="button button-outline" href="/bbf-2026/">Back to the festival</a>
  </div>
</BaseLayout>
<style>
  .friday-page{padding-top:150px;padding-bottom:90px;min-height:75vh}.friday-heading{max-width:900px;margin-bottom:44px}.friday-heading .text-link{color:#e4c36f}.friday-heading .text-link:focus-visible{outline:2px solid #e4c36f;outline-offset:5px}.friday-heading .section-label{margin-top:36px}.friday-heading h1{font-size:clamp(2.5rem,6.5vw,6rem);line-height:1.02;margin:20px 0;overflow-wrap:anywhere}.friday-heading h1 em{color:var(--gold,#d0a84a)}.friday-heading p:last-child{max-width:640px;color:#c6bdb3;font-size:1.1rem;line-height:1.7}.photo-count{color:#c6bdb3;margin-bottom:20px}.friday-gallery{columns:3;column-gap:18px;margin-bottom:48px}.friday-gallery a{display:block;position:relative;break-inside:avoid;margin-bottom:18px;overflow:hidden;background:#1c1714;border:1px solid #d0a84a33;border-radius:4px}.friday-gallery img{width:100%;height:auto;display:block;transition:transform .2s}.friday-gallery a:hover img{transform:scale(1.025)}.friday-gallery a:focus-visible{outline:3px solid #e4c36f;outline-offset:4px}.photo-credit{position:absolute;bottom:0;left:0;right:0;padding:16px 12px 8px;font-size:.75rem;color:white;background:linear-gradient(transparent,#000b)}.gallery-pending{border:1px solid #d0a84a44;padding:clamp(24px,5vw,48px);margin-bottom:40px;background:#d0a84008}.gallery-pending h2{font-size:clamp(1.5rem,3vw,2.4rem);margin:0 0 12px}.gallery-pending p{color:#c6bdb3}.photo-viewer{position:fixed;inset:0;width:100vw;max-width:100vw;height:100dvh;max-height:100dvh;padding:64px 60px 24px;border:0;background:#100c09f7;color:white}.photo-viewer::backdrop{background:#000d}.photo-viewer[open]{display:flex;align-items:center;justify-content:center}.photo-viewer figure{margin:0;text-align:center;min-width:0}.photo-viewer img{max-width:100%;max-height:calc(100dvh - 160px);object-fit:contain}.photo-viewer figcaption{padding-top:12px;font-size:.9rem}.photo-viewer button{position:absolute;border:1px solid #d0a84a88;background:#211a14;color:white;padding:12px;cursor:pointer;min-width:44px;min-height:44px}.viewer-close{top:16px;right:16px}.viewer-prev{left:8px;top:50%}.viewer-next{right:8px;top:50%}@media(max-width:960px){.friday-gallery{columns:2}}@media(max-width:600px){.friday-page{padding-top:120px}.friday-gallery{columns:1;column-gap:14px}.photo-viewer{padding-inline:48px}}@media(prefers-reduced-motion:reduce){.friday-gallery img{transition:none}}
</style>
<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-gallery-photo]"));
  const dialog = document.querySelector<HTMLDialogElement>(".photo-viewer");
  if (dialog && links.length) {
    const image = dialog.querySelector<HTMLImageElement>("img")!;
    const caption = dialog.querySelector("figcaption")!;
    let active = 0;
    let previousOverflow = "";
    const show = (index: number) => {
      active = (index + links.length) % links.length;
      image.src = links[active].href;
      image.alt = links[active].dataset.caption || "Friday workshop photograph";
      caption.textContent = `${active + 1} / ${links.length} · ${image.alt}`;
    };
    links.forEach((link, index) => link.addEventListener("click", (event) => {
      if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      event.preventDefault(); show(index); previousOverflow = document.body.style.overflow;
      document.body.style.overflow = "hidden"; dialog.showModal();
    }));
    dialog.querySelector(".viewer-close")?.addEventListener("click", () => dialog.close());
    dialog.querySelector(".viewer-prev")?.addEventListener("click", () => show(active - 1));
    dialog.querySelector(".viewer-next")?.addEventListener("click", () => show(active + 1));
    dialog.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft" || event.key === "ArrowRight") { event.preventDefault(); show(active + (event.key === "ArrowRight" ? 1 : -1)); }
    });
    dialog.addEventListener("close", () => { document.body.style.overflow = previousOverflow; });
  }
</script>
