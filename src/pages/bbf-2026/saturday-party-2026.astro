---
// Preserve old shared links without duplicating gallery content.
const canonical = "/bbf-2026/saturday-workshops-2026/";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex,follow" />
    <meta name="description" content="The Saturday gallery has moved to Saturday Workshops 2026. View the workshop photos from Berlin Bachata Festival 2026." />
    <meta property="og:image" content="https://bachataexplosion.com/og.png" />
    <meta http-equiv="refresh" content={`0; url=${canonical}`} />
    <link rel="canonical" href={new URL(canonical, Astro.site)} />
    <title>Saturday Workshops 2026 — Bachata Explosion</title>
  </head>
  <body>
    <h1>Saturday Workshops 2026</h1>
    <p>This gallery is now called Saturday Workshops 2026. <a href={canonical}>Open the photo gallery</a>.</p>
    <script is:inline>window.location.replace("/bbf-2026/saturday-workshops-2026/");</script>
  </body>
</html>
