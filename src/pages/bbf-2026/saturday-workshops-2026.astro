---
import BaseLayout from "../../layouts/BaseLayout.astro";

const mediaOrigin = (import.meta.env.PUBLIC_ARCHIVE_MEDIA_ORIGIN || "https://media.bachataexplosion.com").replace(/\/+$/, "");
// The gallery index is generated from the objects in the public R2 bucket at request time.
const manifestUrl = "/api/galleries/saturday-workshops-2026";
---

<BaseLayout title="Saturday Workshops 2026 — Bachata Explosion" description="Saturday workshop photos from Berlin Bachata Festival 2026 at MOA Berlin. Relive the dancing, energy and connections from Saturday's workshops.">
  <div class="saturday-page shell" data-party-gallery data-media-origin={mediaOrigin} data-manifest-url={manifestUrl}>
    <header class="saturday-heading">
      <a class="text-link" href="/bbf-2026/">← Berlin Bachata Festival 2026</a>
      <p class="section-label">17 October 2026 · MOA Berlin</p>
      <h1>Saturday Workshops <em>2026</em></h1>
      <p>Relive Saturday's workshops at Berlin Bachata Festival. Learn, connect and relive the moments from the workshop floor.</p>
    </header>
    <p class="photo-count" data-party-count role="status">Loading Saturday workshop photographs…</p>
    <div class="saturday-gallery" data-party-grid aria-label="Saturday workshop photographs"></div>
    <button class="party-load-more" data-party-more type="button" hidden>Load more photos</button>
    <div class="gallery-pending" data-party-error hidden>
      <h2>Saturday workshop memories are on their way.</h2>
      <p>The photo collection is being prepared. Please check back soon.</p>
    </div>
    <dialog class="photo-viewer" aria-label="Saturday workshop photo viewer">
      <button class="viewer-close" type="button" aria-label="Close photo viewer">Close ×</button>
      <button class="viewer-prev" type="button" aria-label="Previous photo">←</button>
      <figure><img alt="" /><figcaption aria-live="polite"></figcaption></figure>
      <button class="viewer-next" type="button" aria-label="Next photo">→</button>
    </dialog>
    <a class="button button-outline" href="/bbf-2026/">Back to the festival</a>
  </div>
</BaseLayout>

<style>
  .saturday-page{padding-top:150px;padding-bottom:90px;min-height:75vh}.saturday-heading{max-width:900px;margin-bottom:44px}.saturday-heading .text-link{color:#e4c36f}.saturday-heading .text-link:focus-visible{outline:2px solid #e4c36f;outline-offset:5px}.saturday-heading .section-label{margin-top:36px}.saturday-heading h1{font-size:clamp(2.5rem,6.5vw,6rem);line-height:1.02;margin:20px 0;overflow-wrap:anywhere}.saturday-heading h1 em{color:var(--gold,#d0a84a)}.saturday-heading p:last-child{max-width:640px;color:#c6bdb3;font-size:1.1rem;line-height:1.7}.photo-count{color:#c6bdb3;margin-bottom:20px}.saturday-gallery{columns:3;column-gap:18px;margin-bottom:48px}.saturday-gallery a{display:block;position:relative;break-inside:avoid;margin-bottom:18px;overflow:hidden;background:#1c1714;border:1px solid #d0a84a33;border-radius:4px}.saturday-gallery img{width:100%;height:auto;display:block;transition:transform .2s}.saturday-gallery a:hover img{transform:scale(1.025)}.saturday-gallery a:focus-visible{outline:3px solid #e4c36f;outline-offset:4px}.photo-credit{position:absolute;bottom:0;left:0;right:0;padding:16px 12px 8px;font-size:.75rem;color:white;background:linear-gradient(transparent,#000b)}.gallery-pending{border:1px solid #d0a84a44;padding:clamp(24px,5vw,48px);margin-bottom:40px;background:#d0a84008}.gallery-pending h2{font-size:clamp(1.5rem,3vw,2.4rem);margin:0 0 12px}.gallery-pending p{color:#c6bdb3}.photo-viewer{position:fixed;inset:0;width:100vw;max-width:100vw;height:100dvh;max-height:100dvh;padding:64px 60px 24px;border:0;background:#100c09f7;color:white}.photo-viewer::backdrop{background:#000d}.photo-viewer[open]{display:flex;align-items:center;justify-content:center}.photo-viewer figure{margin:0;text-align:center;min-width:0}.photo-viewer img{max-width:100%;max-height:calc(100dvh - 160px);object-fit:contain}.photo-viewer figcaption{padding-top:12px;font-size:.9rem}.photo-viewer button{position:absolute;border:1px solid #d0a84a88;background:#211a14;color:white;padding:12px;cursor:pointer;min-width:44px;min-height:44px}.viewer-close{top:16px;right:16px}.viewer-prev{left:8px;top:50%}.viewer-next{right:8px;top:50%}@media(max-width:960px){.saturday-gallery{columns:2}}@media(max-width:600px){.saturday-page{padding-top:120px}.saturday-gallery{columns:1;column-gap:14px}.photo-viewer{padding-inline:48px}}@media(prefers-reduced-motion:reduce){.saturday-gallery img{transition:none}}
</style>
<style>
  .party-load-more{display:block;margin:0 auto 48px;padding:12px 26px;border:1px solid #d0a84a;background:transparent;color:#e4c36f;font:inherit;font-weight:700;cursor:pointer}
  .party-load-more:hover,.party-load-more:focus-visible{color:#100c09;background:#e4c36f}
  .party-load-more[hidden],.gallery-pending[hidden]{display:none}
  .saturday-gallery{margin-bottom:28px}
  .gallery-pending{margin-bottom:48px}
</style>
<script>
  type GalleryVariant = { path: string; width: number };
  type GalleryPhoto = {
    path: string;
    width?: number;
    height?: number;
    alt?: string;
    credit?: string;
    variants?: GalleryVariant[];
  };
  type GalleryManifest = { photos?: GalleryPhoto[] };

  const root = document.querySelector<HTMLElement>("[data-party-gallery]");
  const grid = root?.querySelector<HTMLElement>("[data-party-grid]");
  const count = root?.querySelector<HTMLElement>("[data-party-count]");
  const error = root?.querySelector<HTMLElement>("[data-party-error]");
  const more = root?.querySelector<HTMLButtonElement>("[data-party-more]");
  const dialog = root?.querySelector<HTMLDialogElement>(".photo-viewer");
  const mediaOrigin = root?.dataset.mediaOrigin ?? "";
  const manifestUrl = root?.dataset.manifestUrl ?? "";
  const image = dialog?.querySelector<HTMLImageElement>("img");
  const caption = dialog?.querySelector<HTMLElement>("figcaption");
  const photos: GalleryPhoto[] = [];
  const batchSize = 60;
  let rendered = 0;
  let active = 0;
  let previousOverflow = "";

  function mediaUrl(path: string): string {
    if (!mediaOrigin || !path || path.startsWith("//") || path.includes("\\")) throw new Error("Invalid media URL");
    const url = new URL(path.replace(/^\/+/, ""), mediaOrigin + "/");
    if (url.origin !== new URL(mediaOrigin).origin || !url.pathname.startsWith("/events/berlin-bachata-festival-2026-saturday-workshops/")) {
      throw new Error("Invalid gallery photo path");
    }
    return url.href;
  }

  function show(index: number) {
    if (!image || !caption || !photos.length) return;
    active = (index + photos.length) % photos.length;
    const photo = photos[active];
    image.src = mediaUrl(photo.path);
    image.alt = photo.alt || "Saturday workshop photo " + (active + 1);
    caption.textContent = (active + 1) + " / " + photos.length + " · " + image.alt;
  }

  function openViewer(index: number) {
    if (!dialog) return;
    show(index);
    previousOverflow = document.body.style.overflow;
    document.body.style.overflow = "hidden";
    dialog.showModal();
  }

  function renderNext() {
    if (!grid || !more) return;
    const fragment = document.createDocumentFragment();
    const next = Math.min(rendered + batchSize, photos.length);
    for (let index = rendered; index < next; index++) {
      const photo = photos[index];
      const link = document.createElement("a");
      link.href = mediaUrl(photo.path);
      link.dataset.galleryPhoto = "";
      const alt = photo.alt || "Saturday workshop at Berlin Bachata Festival 2026 — photo " + (index + 1);
      link.setAttribute("aria-label", "View photo " + (index + 1) + ": " + alt);

      const img = document.createElement("img");
      const variants = (photo.variants || []).filter((v) => v && Number.isFinite(v.width) && v.width > 0).sort((a,b) => a.width - b.width);
      const thumbnail = variants.find((v) => v.width >= 480) || variants[0];
      img.src = thumbnail ? mediaUrl(thumbnail.path) : link.href;
      if (variants.length) {
        img.srcset = variants.map((v) => mediaUrl(v.path) + " " + v.width + "w").join(", ");
        img.sizes = "(max-width: 600px) 100vw, (max-width: 960px) 50vw, 33vw";
      }
      if (photo.width && photo.height) { img.width = photo.width; img.height = photo.height; }
      img.alt = alt;
      img.loading = index < 3 ? "eager" : "lazy";
      img.decoding = "async";
      link.append(img);
      if (photo.credit) {
        const credit = document.createElement("span");
        credit.className = "photo-credit";
        credit.textContent = photo.credit;
        link.append(credit);
      }
      link.addEventListener("click", (event) => {
        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        openViewer(index);
      });
      fragment.append(link);
    }
    grid.append(fragment);
    rendered = next;
    const remaining = photos.length - rendered;
    more.hidden = remaining <= 0;
    more.textContent = "Load more photos · " + remaining + " remaining";
  }

  more?.addEventListener("click", renderNext);
  dialog?.querySelector(".viewer-close")?.addEventListener("click", () => dialog.close());
  dialog?.querySelector(".viewer-prev")?.addEventListener("click", () => show(active - 1));
  dialog?.querySelector(".viewer-next")?.addEventListener("click", () => show(active + 1));
  dialog?.addEventListener("keydown", (event) => {
    if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
      event.preventDefault();
      show(active + (event.key === "ArrowRight" ? 1 : -1));
    }
  });
  dialog?.addEventListener("close", () => { document.body.style.overflow = previousOverflow; });

  // Photos are read from the original saturday-workshops R2 folder.
  // If the photos move, update both this path guard and the Worker prefix.

  async function loadPartyPhotos() {
    if (!root || !grid || !count || !error) return;
    try {
      const response = await fetch(manifestUrl, { mode: "cors" });
      if (!response.ok) throw new Error("Gallery manifest response " + response.status);
      const data = await response.json() as GalleryManifest;
      if (!Array.isArray(data.photos) || !data.photos.length) throw new Error("Empty gallery");
      for (const photo of data.photos) {
        if (!photo || typeof photo.path !== "string") continue;
        mediaUrl(photo.path);
        photos.push(photo);
      }
      if (!photos.length) throw new Error("No valid photos");
      count.textContent = photos.length.toLocaleString() + " photographs · Select a photo to see it in full";
      renderNext();
    } catch (reason) {
      count.textContent = "Saturday Workshops 2026 photos";
      error.hidden = false;
      console.warn("Saturday workshop gallery could not load", reason);
    }
  }

  void loadPartyPhotos();
</script>
