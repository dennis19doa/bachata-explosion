---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ambassadorFormEndpoint } from "../lib/forms";

const formConnected = Boolean(ambassadorFormEndpoint);
const benefits = [
  { label: "Your community", title: "A personal promo code", text: "Give your dancers a clear reason to join and track the community you bring into each Explosion." },
  { label: "Your access", title: "Festival benefits", text: "Unlock selected access, discounts and ambassador-only opportunities as your community impact grows." },
  { label: "Your toolkit", title: "Ready-to-share media", text: "Receive official posts, stories, links and an on-brand media kit that is easy to publish." },
  { label: "Your voice", title: "Spotlight & recognition", text: "Be visible across Explosion channels and represent the character of your local scene." },
] as const;
---

<BaseLayout
  title="Bachata Explosion Ambassadors — bring your community to Berlin"
  description="Join the Bachata Explosion Ambassador Crew, represent your dance community and unlock promo codes, media support, festival benefits and visibility."
  headerStyle="solid"
>
  <article class="ambassador-2026 ambassador-round2" data-wordpress-source="ambassadors">
    <section class="ambassador-hero ambassador-hero-round2" aria-labelledby="ambassador-title">
      <div class="shell ambassador-hero-grid ambassador-hero-grid-round2">
        <div class="ambassador-hero-copy">
          <p class="eyebrow"><span></span>Official ambassador crew</p>
          <h1 id="ambassador-title">Carry the<br /><em>Explosion.</em></h1>
          <p>Bring your community into a Berlin-born festival, share the story in your own voice and grow with the people behind the event.</p>
          <div class="hero-actions"><a class="button button-gold" href="#ambassador-application">Apply now</a><a class="button button-glass" href="#ambassador-benefits">See the benefits</a></div>
        </div>
        <div class="ambassador-hero-media" aria-label="Bachata Explosion community moments">
          <figure class="ambassador-community-photo"><img src="https://bachataexplosion.com/wp-content/uploads/2025/08/2023.10.29-00-29-IMG_3829-Rating_1-scaled.jpg" alt="Bachata Explosion community celebration" width="1800" height="1200" referrerpolicy="no-referrer" /><figcaption>One community · many scenes</figcaption></figure>
          <figure class="ambassador-award-photo"><img src="https://bachataexplosion.com/wp-content/uploads/2025/10/Freitag-Workshops-296-1-scaled.jpg" alt="Bachata Explosion workshop atmosphere" width="1200" height="1800" referrerpolicy="no-referrer" /><figcaption>Berlin energy</figcaption></figure>
        </div>
      </div>
    </section>

    <section class="ambassador-core section-pad" id="ambassador-benefits" aria-labelledby="ambassador-benefits-title">
      <div class="shell ambassador-core-grid">
        <div class="ambassador-core-intro">
          <p class="section-label">More than reposting</p>
          <h2 id="ambassador-benefits-title">Be the connection<br /><em>between scenes.</em></h2>
          <p>Ambassadors are trusted dancers who understand their local community. You do not need the largest following—you need a real voice, reliability and the desire to bring people together.</p>
        </div>
        <div class="ambassador-benefit-grid">{benefits.map((benefit) => <article><span>{benefit.label}</span><h3>{benefit.title}</h3><p>{benefit.text}</p></article>)}</div>
      </div>
    </section>

    <section class="ambassador-role ambassador-role-round2 section-pad">
      <div class="shell ambassador-role-grid">
        <figure><img src="https://bachataexplosion.com/wp-content/uploads/2025/10/Freitag-Workshops-296-1-scaled.jpg" alt="Bachata Explosion workshop community" width="1200" height="800" loading="lazy" referrerpolicy="no-referrer" /><figcaption>One festival · many local scenes</figcaption></figure>
        <div>
          <p class="section-label">What you bring</p>
          <h2>Represent.<br /><em>Invite. Connect.</em></h2>
          <div class="ambassador-role-notes">
            <p><strong>Represent your community</strong><span>Share what your dancers care about and invite them into an event you genuinely believe in.</span></p>
            <p><strong>Use official assets</strong><span>Publish the provided media, links and information accurately and in your own voice.</span></p>
            <p><strong>Stay in contact</strong><span>Keep communication clear, use your personal code and tell us what your community needs.</span></p>
          </div>
          <div class="ambassador-tags"><span>Personal promo code</span><span>Media kit</span><span>Exclusive content</span></div>
          <div class="ambassador-group-inline"><div><strong>Coming with a full crew?</strong><p>Groups of 10 or more can request a direct group arrangement, with group discounts of up to €20 per person.</p></div><a class="button button-gold" href="mailto:info@bachataexplosion.com?subject=Bachata%20Explosion%20group%20discount">Ask about group rates</a></div>
        </div>
      </div>
    </section>

    <section class="ambassador-application ambassador-application-round2 section-pad" id="ambassador-application" aria-labelledby="ambassador-form-title">
      <div class="shell ambassador-application-grid">
        <aside><p class="section-label">Ambassador application</p><h2 id="ambassador-form-title">Tell us about<br /><em>your scene.</em></h2><p>We review your community, communication style and motivation. The strongest applications are specific, personal and honest.</p><div class="ambassador-application-note"><span>What happens next</span><p>Selected applicants receive their promo code, media kit and onboarding details directly from the team.</p></div></aside>
        <form class="ambassador-form" method="POST" action={ambassadorFormEndpoint || undefined} data-ambassador-form data-ambassador-endpoint={ambassadorFormEndpoint}>
          <input type="hidden" name="topic" value="Ambassador application" />
          <label><span>Full name *</span><input type="text" name="name" autocomplete="name" maxlength="100" required /></label>
          <label><span>Email *</span><input type="email" name="email" autocomplete="email" maxlength="180" required /></label>
          <label><span>Instagram *</span><input type="text" name="instagram" maxlength="120" placeholder="@youraccount" required /></label>
          <label><span>Country / city *</span><input type="text" name="community" maxlength="160" placeholder="Where is your community?" required /></label>
          <label class="full-field"><span>Tell us about your community and how you would help *</span><textarea name="message" rows="6" maxlength="2000" placeholder="Who do you dance with, how do you communicate with them, and why does Explosion fit your scene?" required></textarea></label>
          <label class="form-trap" aria-hidden="true"><span>Leave empty</span><input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
          <label class="ambassador-consent full-field"><input type="checkbox" name="privacy_consent" value="yes" required /><span>I agree that my details may be used to review this application and contact me. See the <a href="/privacy/">privacy policy</a>.</span></label>
          <div class="ambassador-submit full-field"><button class="button button-gold" type="submit" data-ambassador-submit>Apply to the crew</button><small>{formConnected ? "Secure application delivery is connected." : "Preview mode: no application is transmitted yet."}</small></div>
          <p class="ambassador-form-status full-field" role="status" aria-live="polite" data-ambassador-status>{formConnected ? "Ready when you are." : "The application is designed and ready. Connect the protected email endpoint to activate delivery."}</p>
        </form>
      </div>
    </section>
  </article>

  <script>
    const ambassadorForm = document.querySelector<HTMLFormElement>("[data-ambassador-form]");
    const ambassadorStatus = ambassadorForm?.querySelector<HTMLElement>("[data-ambassador-status]");
    const ambassadorSubmit = ambassadorForm?.querySelector<HTMLButtonElement>("[data-ambassador-submit]");
    ambassadorForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const endpoint = ambassadorForm.dataset.ambassadorEndpoint?.trim();
      if (!endpoint) { if (ambassadorStatus) ambassadorStatus.textContent = "Preview mode is active, so nothing was sent. Connect the protected email endpoint to receive ambassador applications."; return; }
      if (ambassadorSubmit) { ambassadorSubmit.disabled = true; ambassadorSubmit.textContent = "Sending application…"; }
      if (ambassadorStatus) ambassadorStatus.textContent = "Sending your application securely…";
      try { const response = await fetch(endpoint, { method: "POST", body: new FormData(ambassadorForm), headers: { Accept: "application/json" } }); if (!response.ok) throw new Error("Application failed"); ambassadorForm.reset(); if (ambassadorStatus) ambassadorStatus.textContent = "Application received. Thank you—our team will review it and contact you."; }
      catch { if (ambassadorStatus) ambassadorStatus.textContent = "The application could not be delivered. Please try again or email info@bachataexplosion.com."; }
      finally { if (ambassadorSubmit) { ambassadorSubmit.disabled = false; ambassadorSubmit.textContent = "Apply to the crew"; } }
    });
  </script>
</BaseLayout>