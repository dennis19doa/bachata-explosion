---
import BaseLayout from "../layouts/BaseLayout.astro";
import { volunteerFormEndpoint } from "../lib/forms";

const formConnected = Boolean(volunteerFormEndpoint);
const roles = [
  { value: "Door and check-in", title: "Door & check-in", text: "Scan tickets, distribute wristbands and welcome dancers into the event." },
  { value: "Pickup driver", title: "Pickup driver", text: "Pick up and drop off artists using your own car and keep the team informed." },
  { value: "Construction volunteer", title: "Setup crew", text: "Help with practical construction and setup work before and after the event." },
  { value: "Event research", title: "Event research", text: "Research hotels, venues, travel routes, suppliers and cost-effective options." },
  { value: "Other contribution", title: "Something else", text: "Bring a skill, idea or kind of support we have not listed yet." },
] as const;
const events = ["Berlin Bachata Festival", "Role Rotation", "Summer Edition", "Elite Dance", "More than one event"];
const languages = ["German", "English", "Spanish", "Other"];
---

<BaseLayout title="Volunteer with Bachata Explosion — join the event team" description="Apply directly to the Bachata Explosion volunteer team for check-in, artist transport, setup, event research or another contribution.">
  <article class="volunteer-2026" data-wordpress-source="volunteers">
    <section class="volunteer-hero" aria-labelledby="volunteer-title">
      <img src="/media/bbf/atmosphere/saturday-62.jpg" alt="The Bachata Explosion community together in Berlin" width="1800" height="1200" />
      <div class="volunteer-hero-shade" aria-hidden="true"></div>
      <div class="volunteer-hero-word" aria-hidden="true">FAMILY</div>
      <div class="shell volunteer-hero-content">
        <p class="eyebrow"><span></span>Join the Explosion team</p>
        <h1 id="volunteer-title">We are<br /><em>Explosion.</em></h1>
        <p>Help build the weekend from the inside and become part of the family behind the floor.</p>
        <a class="button button-gold" href="#volunteer-application">Start your application</a>
      </div>
    </section>

    <section class="volunteer-promise section-pad">
      <div class="shell volunteer-promise-grid">
        <div><p class="section-label">The exchange</p><h2>Bring your energy.<br /><em>Live the whole event.</em></h2></div>
        <div class="volunteer-promise-cards">
          <article><span>What you give</span><strong>Around 8 hours</strong><p>Reliable help, clear communication and responsibility for your assigned task.</p></article>
          <article><span>What you receive</span><strong>A festival Full Pass</strong><p>Free access to the regular event programme outside your agreed volunteer shifts.</p></article>
          <article><span>What you join</span><strong>A real team</strong><p>Behind-the-scenes experience, community visibility and people who want you to feel at home.</p></article>
        </div>
      </div>
    </section>

    <section class="volunteer-roles section-pad" aria-labelledby="volunteer-roles-title">
      <div class="shell">
        <div class="volunteer-heading">
          <div><p class="section-label">Where you can help</p><h2 id="volunteer-roles-title">Choose your<br /><em>place in the team.</em></h2></div>
          <p>You can select more than one role in the application. Tell us about other useful experience or ideas as well.</p>
        </div>
        <div class="volunteer-role-grid">
          {roles.map((role) => <a href="#volunteer-application" data-volunteer-role-link={role.value}><span>{role.title}</span><p>{role.text}</p><b>Choose this role ↘</b></a>)}
        </div>
      </div>
    </section>

    <section class="volunteer-application section-pad" id="volunteer-application" aria-labelledby="volunteer-form-title">
      <div class="shell volunteer-application-grid">
        <aside>
          <p class="section-label">Native application</p>
          <h2 id="volunteer-form-title">Your application.<br /><em>Right here.</em></h2>
          <p>This replaces Typeform completely. You stay on the Bachata Explosion website from start to finish.</p>
          <div class="volunteer-form-note"><span>What happens next</span><p>We review your preferred role, event, languages and availability, then contact you directly.</p></div>
        </aside>

        <form class="volunteer-form" method="POST" action={volunteerFormEndpoint || undefined} data-volunteer-form data-volunteer-endpoint={volunteerFormEndpoint}>
          <input type="hidden" name="topic" value="Volunteer application" />

          <fieldset class="volunteer-form-section">
            <legend><span>Preferred tasks</span> What are you applying for? *</legend>
            <p>Choose as many as you like.</p>
            <div class="volunteer-choice-grid">
              {roles.map((role) => <label><input type="checkbox" name="roles" value={role.value} data-volunteer-role required /><span><strong>{role.title}</strong><small>{role.text}</small></span></label>)}
            </div>
          </fieldset>

          <fieldset class="volunteer-form-section volunteer-field-grid">
            <legend><span>Your contribution</span> Tell us where you fit</legend>
            <label class="full-field"><span>What can you do that we did not mention?</span><textarea name="other_contribution" rows="5" maxlength="1600" placeholder="Share your skills, experience or ideas. How do you see yourself in the Explosion team?"></textarea></label>
            <label><span>Which event are you applying for? *</span><select name="event" required><option value="">Choose an event</option>{events.map((event) => <option value={event}>{event}</option>)}</select></label>
            <div class="volunteer-language-field"><span>Which languages do you speak? *</span><div>{languages.map((language) => <label><input type="checkbox" name="languages" value={language} required /><span>{language}</span></label>)}</div></div>
          </fieldset>

          <fieldset class="volunteer-form-section volunteer-field-grid">
            <legend><span>Contact information</span> How can we reach you? *</legend>
            <label><span>First name *</span><input type="text" name="first_name" autocomplete="given-name" required maxlength="80" /></label>
            <label><span>Last name *</span><input type="text" name="last_name" autocomplete="family-name" required maxlength="80" /></label>
            <label><span>Phone / WhatsApp *</span><input type="tel" name="phone" autocomplete="tel" required maxlength="40" placeholder="Including country code" /></label>
            <label><span>Email *</span><input type="email" name="email" autocomplete="email" required maxlength="180" /></label>
            <label class="full-field"><span>Availability or exceptions</span><textarea name="availability" rows="4" maxlength="1200" placeholder="Tell us if you cannot be available Friday–Sunday or have timing restrictions."></textarea></label>
          </fieldset>

          <fieldset class="volunteer-form-section volunteer-rules">
            <legend><span>Rules & conditions</span> A clear agreement</legend>
            <details open><summary>Door and event-team rules <span aria-hidden="true">+</span></summary><ul><li>Be at your shift at least 10 minutes before it starts.</li><li>Tell the organisers immediately if you are late, unavailable or need to cancel.</li><li>Do not dance during your shift or leave the door unattended without informing the team.</li><li>Breaking the rules can lead to exclusion from the event and cancellation of the Full Pass.</li></ul></details>
            <details><summary>Pickup-driver rules <span aria-hidden="true">+</span></summary><ul><li>You need your own safe, roadworthy car and must complete the agreed artist pickups.</li><li>Confirm every artist pickup and drop-off with the organising team.</li><li>Two or three completed pickups may be required to qualify for the Full Pass.</li><li>Notify us immediately if you cannot complete an assigned journey.</li></ul></details>
            <label class="volunteer-consent"><input type="checkbox" name="volunteer_rules" value="agreed" required /><span>I have read and agree to the rules that apply to my volunteer role.</span></label>
            <label class="volunteer-consent"><input type="checkbox" name="conditions" value="agreed" required /><span>I understand that the expected work is around 8 hours, information shared with the team is confidential, absences must be reported promptly, and I may be asked to repost event advertising at least once.</span></label>
            <label class="volunteer-consent"><input type="checkbox" name="privacy_consent" value="yes" required /><span>I agree that my details may be used to review this application and contact me. See the <a href="/privacy/">privacy policy</a>.</span></label>
          </fieldset>

          <label class="form-trap" aria-hidden="true"><span>Leave empty</span><input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
          <div class="volunteer-submit"><button class="button button-gold" type="submit" data-volunteer-submit>Apply to the team</button><p role="status" aria-live="polite" data-volunteer-status>{formConnected ? "Ready when you are." : "Preview mode: the Typeform is removed; activate the protected email endpoint to deliver applications."}</p></div>
        </form>
      </div>
    </section>
  </article>

  <script>
    const volunteerForm = document.querySelector<HTMLFormElement>("[data-volunteer-form]");
    const volunteerStatus = volunteerForm?.querySelector<HTMLElement>("[data-volunteer-status]");
    const volunteerSubmit = volunteerForm?.querySelector<HTMLButtonElement>("[data-volunteer-submit]");
    const roleInputs = Array.from(document.querySelectorAll<HTMLInputElement>("[data-volunteer-role]"));
    const languageInputs = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="languages"]'));
    const maintainRequirement = (inputs: HTMLInputElement[]) => { const selected = inputs.some((input) => input.checked); inputs.forEach((input) => { input.required = !selected; }); };
    roleInputs.forEach((input) => input.addEventListener("change", () => maintainRequirement(roleInputs)));
    languageInputs.forEach((input) => input.addEventListener("change", () => maintainRequirement(languageInputs)));
    document.querySelectorAll<HTMLAnchorElement>("[data-volunteer-role-link]").forEach((link) => link.addEventListener("click", () => { const input = roleInputs.find((candidate) => candidate.value === link.dataset.volunteerRoleLink); if (input) input.checked = true; maintainRequirement(roleInputs); }));
    volunteerForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const endpoint = volunteerForm.dataset.volunteerEndpoint?.trim();
      if (!endpoint) { if (volunteerStatus) volunteerStatus.textContent = "The native application is ready, but delivery is still in preview mode. Connect the protected email endpoint to receive applications."; return; }
      if (volunteerSubmit) { volunteerSubmit.disabled = true; volunteerSubmit.textContent = "Sending application…"; }
      if (volunteerStatus) volunteerStatus.textContent = "Sending your application securely…";
      try {
        const response = await fetch(endpoint, { method: "POST", body: new FormData(volunteerForm), headers: { Accept: "application/json" } });
        if (!response.ok) throw new Error("Application failed");
        volunteerForm.reset(); maintainRequirement(roleInputs); maintainRequirement(languageInputs);
        if (volunteerStatus) volunteerStatus.textContent = "Application received. Thank you—our team will review it and contact you.";
      } catch { if (volunteerStatus) volunteerStatus.textContent = "The application could not be delivered. Please try again or email info@bachataexplosion.com."; }
      finally { if (volunteerSubmit) { volunteerSubmit.disabled = false; volunteerSubmit.textContent = "Apply to the team"; } }
    });
  </script>
</BaseLayout>
