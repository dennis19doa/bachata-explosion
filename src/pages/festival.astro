---
import BaseLayout from "../layouts/BaseLayout.astro";
import { festivalFaqs, ticketUrl } from "../data/festival";
---

<BaseLayout
  title="Berlin Bachata Festival 2026 | Bachata Explosion"
  description="October 16–18, 2026 at MOA Berlin: international bachata artists, workshops, parties, shows and the BBF Jack & Jill."
  headerStyle="solid"
>
  <section class="page-hero festival-hero">
    <div class="shell page-hero-grid">
      <div>
        <p class="eyebrow"><span></span> BBF #4 · October 16–18, 2026</p>
        <h1>Berlin Bachata<br /><em>Festival</em></h1>
        <p class="hero-lead">International artists, high-quality workshops and social dancing until late in the heart of Berlin.</p>
        <div class="hero-actions"><a class="button button-gold" href={ticketUrl}>Get tickets</a><a class="text-link" href="#weekend">Plan your weekend ↓</a></div>
      </div>
      <img class="festival-poster" src="/media/events/bbf-2026-poster.jpg" alt="Berlin Bachata Festival 2026 poster" width="1080" height="1350" />
    </div>
  </section>

  <nav class="festival-planner" id="weekend" aria-label="Festival page">
    <div class="shell festival-planner-inner">
      <p><span>BBF #4</span> Plan the weekend</p>
      <div>
        <a href="#program">Program</a>
        <a href="#tickets">Passes</a>
        <a href="#venue">Venue</a>
        <a href="#competition">Jack &amp; Jill</a>
      </div>
    </div>
  </nav>

  <section class="venue-strip" id="venue">
    <div class="shell venue-grid">
      <p class="section-label">Official festival hotel</p>
      <h2>MOA Berlin.<br /><em>Everything in one place.</em></h2>
      <div><p>Workshops, parties and your hotel under one roof.<br /><br />Mercure Hotel MOA Berlin<br />Stephanstraße 41 · 10559 Berlin</p><a class="text-link" href="https://maps.google.com/?q=Mercure+Hotel+MOA+Berlin">Open map ↗</a></div>
    </div>
  </section>

  <section class="section-pad">
    <div class="shell">
      <div class="section-heading centered"><p class="section-label">Why dancers choose Explosion</p><h2>Real progress.<br /><em>Real festival energy.</em></h2></div>
      <div class="feature-grid six-grid">
        <article><span>01</span><h3>World-class instructors</h3><p>International artists and technique-driven learning.</p></article>
        <article><span>02</span><h3>Social dancing</h3><p>Big floors, strong sound and generous dance time.</p></article>
        <article><span>03</span><h3>Structured workshops</h3><p>Clear levels and practical takeaways.</p></article>
        <article><span>04</span><h3>Competitions</h3><p>Jack & Jill and Explosion’s battle culture.</p></article>
        <article><span>05</span><h3>By dancers</h3><p>Designed by people who actively live the scene.</p></article>
        <article><span>06</span><h3>Community values</h3><p>Every role, gender and identity is welcome.</p></article>
      </div>
    </div>
  </section>

  <section class="competition-section section-pad" id="competition">
    <div class="shell competition-grid">
      <div><p class="section-label">Saturday competition</p><h2>Your name.<br /><em>Your moment.</em></h2><p>The BBF Jack & Jill puts connection, musicality, technique and adaptability in the spotlight.</p><a class="button button-outline" href="https://bachataexplosion.com/jj/">Competition details</a></div>
      <ol class="competition-steps"><li><b>01</b><span>Register</span></li><li><b>02</b><span>Cypher</span></li><li><b>03</b><span>Semi-final</span></li><li><b>04</b><span>Center stage</span></li></ol>
    </div>
  </section>

  <section class="schedule-section section-pad" id="program">
    <div class="shell">
      <div class="section-heading split-heading"><div><p class="section-label">Friday to Sunday</p><h2>Festival<br /><em>rhythm.</em></h2></div><p>The detailed artist timetable will be added when it is final. This structure stays clear even when timings change.</p></div>
      <div class="schedule-grid">
        <article><div class="schedule-day"><b>01</b><span>Friday</span></div><h3>Arrive & ignite</h3><ul><li>Workshops</li><li>Welcome social</li><li>Opening party</li></ul></article>
        <article><div class="schedule-day"><b>02</b><span>Saturday</span></div><h3>Grow & compete</h3><ul><li>Full workshop day</li><li>Jack & Jill</li><li>Main party</li></ul></article>
        <article><div class="schedule-day"><b>03</b><span>Sunday</span></div><h3>One last dance</h3><ul><li>Workshops</li><li>Social dancing</li><li>Closing party</li></ul></article>
      </div>
    </div>
  </section>

  <section class="passes-section section-pad" id="tickets">
    <div class="shell">
      <div class="section-heading centered"><p class="section-label">Official passes</p><h2>Choose your<br /><em>festival.</em></h2></div>
      <div class="passes-grid">
        <article class="featured-pass"><span>Most complete</span><h3>Full Pass</h3><ul><li>Regular workshops</li><li>Parties, shows and socials</li><li>The full festival experience</li></ul><a class="button button-gold" href={ticketUrl}>Buy Full Pass</a></article>
        <article><span>Dance all night</span><h3>Party Pass</h3><ul><li>Festival parties</li><li>Pre-party workshops</li><li>Social-first weekend</li></ul><a class="button button-outline" href={ticketUrl}>Buy Party Pass</a></article>
        <article><span>Premium access</span><h3>Gold Pass</h3><ul><li>Premium perks</li><li>Selected masterclasses</li><li>More focused learning</li></ul><a class="button button-outline" href={ticketUrl}>Buy Gold Pass</a></article>
      </div>
    </div>
  </section>

  <section class="faq-section section-pad">
    <div class="shell faq-grid">
      <div><p class="section-label">Good to know</p><h2>Festival<br /><em>FAQ.</em></h2><p>Still unsure? Email <a href="mailto:info@bachataexplosion.com">info@bachataexplosion.com</a>.</p></div>
      <div class="faq-list">
        {festivalFaqs.map((faq) => <details><summary>{faq.question}<span>+</span></summary><p>{faq.answer}</p></details>)}
      </div>
    </div>
  </section>
</BaseLayout>
