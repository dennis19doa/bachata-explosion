<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>Warm Festival — Bachata Explosion</title><style>
@import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800;900&family=DM+Sans:wght@400;500;600;700&display=swap');*{box-sizing:border-box}body{margin:0;background:#fff8ef;color:#231719;font-family:'DM Sans',system-ui,sans-serif}a{text-decoration:none;color:inherit}.wrap{width:min(1180px,calc(100% - 40px));margin:auto}.nav{position:fixed;z-index:30;left:50%;top:14px;transform:translateX(-50%);width:min(1180px,calc(100% - 28px));height:68px;display:flex;align-items:center;padding:10px 12px 10px 18px;background:rgba(255,248,239,.94);border:1px solid rgba(81,28,40,.14);box-shadow:0 15px 42px rgba(94,50,48,.14);backdrop-filter:blur(14px)}.nav img{width:145px;filter:brightness(.25)}.links{margin-left:auto;display:flex;gap:24px;align-items:center;font-size:.72rem;font-weight:800;text-transform:uppercase}.ticket{background:#8b2840;color:#fff;padding:14px 18px}.hero{padding:115px 0 70px}.hero-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;min-height:680px}.hero-card{background:#f3c9b7;padding:60px;display:flex;flex-direction:column;justify-content:center;position:relative;overflow:hidden}.hero-card:after{content:"EXPLOSION";position:absolute;right:-20px;bottom:-35px;font:900 8rem/.8 'Barlow Condensed';color:rgba(139,40,64,.08);transform:rotate(-8deg)}.eyebrow{font-size:.7rem;text-transform:uppercase;letter-spacing:.15em;font-weight:800;color:#8b2840}.hero h1{font:900 clamp(5.5rem,9vw,9.2rem)/.75 'Barlow Condensed';text-transform:uppercase;letter-spacing:-.04em;margin:16px 0}.hero h1 em{font-style:normal;color:#8b2840}.hero p{max-width:560px;line-height:1.65}.actions{display:flex;gap:12px;margin-top:25px;flex-wrap:wrap}.button{padding:14px 20px;border:1px solid #28191c;font-size:.72rem;font-weight:800;text-transform:uppercase}.button.primary{background:#8b2840;color:#fff;border-color:#8b2840}.hero-media{position:relative;overflow:hidden}.hero-media img{width:100%;height:100%;object-fit:cover}.floating{position:absolute;right:18px;bottom:18px;width:175px;background:#fff;padding:7px;transform:rotate(3deg);box-shadow:0 15px 40px rgba(0,0,0,.2)}.floating img{height:auto}.stats{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-top:14px}.stats div{background:#231719;color:#fff;padding:22px}.stats strong{display:block;color:#f3c9b7;font:800 2.7rem/.9 'Barlow Condensed'}.stats span{font-size:.64rem;text-transform:uppercase;letter-spacing:.08em;color:#cfc5c1}.section{padding:100px 0}.section h2{font:900 clamp(4rem,7vw,7rem)/.83 'Barlow Condensed';text-transform:uppercase;margin:9px 0 24px}.section h2 em{font-style:normal;color:#8b2840}.copy{max-width:590px;line-height:1.75;color:#65575a}.mosaic{display:grid;grid-template-columns:1.2fr .8fr;gap:16px;margin-top:40px}.mosaic img{width:100%;height:520px;object-fit:cover}.mosaic .side{display:grid;grid-template-rows:1fr 1fr;gap:16px}.mosaic .side img{height:252px}.events{background:#f2e7d9}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:38px}.card{background:#fff8ef}.card img{width:100%;aspect-ratio:4/3;object-fit:cover}.card div{padding:22px}.card h3{font:800 2.3rem/.9 'Barlow Condensed';text-transform:uppercase;margin:6px 0}.card small{color:#8b2840;font-weight:800;text-transform:uppercase}.berlin{background:#8b2840;color:#fff}.berlin-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:60px;align-items:center}.berlin img{width:100%;height:520px;object-fit:cover;filter:saturate(.8)}.berlin .copy{color:#f4dedb}.berlin .eyebrow{color:#ffd5bf}.footer{padding:55px 0;background:#231719;color:#eee}.footer .wrap{display:flex;justify-content:space-between}@media(max-width:850px){.links a:not(.ticket){display:none}.hero-grid,.mosaic,.berlin-grid{grid-template-columns:1fr}.hero-card{padding:45px 28px}.hero-media{min-height:520px}.stats{grid-template-columns:repeat(2,1fr)}.stats div:first-child{grid-column:1/-1}.cards{grid-template-columns:1fr}.mosaic .side{grid-template-rows:none;grid-template-columns:1fr 1fr}.mosaic .side img{height:260px}.footer .wrap{flex-direction:column;gap:10px}}
</style></head><body><header class="nav"><img src="/media/brand/explosion-logo.webp" alt="Bachata Explosion"/><nav class="links"><a href="#festival">Festival</a><a href="#events">Events</a><a href="#berlin">Berlin</a><a href="#community">Community</a><a class="ticket" href={ticketUrl}>Get tickets</a></nav></header><main><section class="hero"><div class="wrap"><div class="hero-grid"><div class="hero-card"><p class="eyebrow">16–18 October 2026 · MOA Berlin</p><h1>Bachata<br/><em>Explosion</em></h1><p>A brighter, friendlier festival direction using warm cream, burgundy and peach. It keeps the energy and personality of Explosion without making the site dark or aggressive.</p><div class="actions"><a class="button primary" href={ticketUrl}>Get tickets</a><a class="button" href="#festival">Discover festival</a></div></div><div class="hero-media"><img src="/media/bbf/atmosphere/saturday-62.jpg" alt="Festival dancing"/><div class="floating"><img src="/media/events/bbf-2026-poster.jpg" alt="BBF poster"/></div></div></div><div class="stats"><div><strong>BBF 2026</strong><span>Berlin</span></div><div><strong>3</strong><span>Days</span></div><div><strong>40+</strong><span>Workshops</span></div><div><strong>30+</strong><span>Artists</span></div><div><strong>3</strong><span>Parties</span></div></div></div></section><section class="section" id="community"><div class="wrap"><p class="eyebrow">The feeling</p><h2>Community first.<br/><em>Energy everywhere.</em></h2><p class="copy">This direction feels more welcoming and joyful. It uses actual dance photography and warmer colours while keeping a clear, modern structure.</p><div class="mosaic"><img src="/media/atmosphere/explosion-community.jpg" alt="Community"/><div class="side"><img src="/media/bbf/atmosphere/party-141.jpg" alt="Party"/><img src="/media/bbf/atmosphere/saturday-60.jpg" alt="Workshop"/></div></div></div></section><section class="section events" id="events"><div class="wrap"><p class="eyebrow">The Explosion family</p><h2>One brand.<br/><em>Three experiences.</em></h2><div class="cards"><article class="card"><img src="/media/events/bbf-2026-poster.jpg" alt="BBF"/><div><small>Flagship</small><h3>Berlin Bachata Festival</h3><p>Large-scale festival energy with a personal feel.</p></div></article><article class="card"><img src="/media/events/role-rotation-2026.webp" alt="Role Rotation"/><div><small>Perspective</small><h3>Role Rotation</h3><p>Connection from both sides of the dance.</p></div></article><article class="card"><img src="/media/events/elite-dance-3.webp" alt="Elite Dance"/><div><small>Focused</small><h3>Elite Dance</h3><p>Smaller format, serious growth, strong community.</p></div></article></div></div></section><section class="section berlin" id="berlin"><div class="wrap berlin-grid"><div><p class="eyebrow">Berlin born</p><h2>The city is<br/>the backdrop.</h2><p class="copy">Berlin appears through the people, the venue and the event atmosphere. This concept is less “Berlin aesthetic” and more “Explosion happening in Berlin.”</p></div><img src="/media/brand/berlin-brandenburg-gold.png" alt="Berlin Brandenburg Gate"/></div></section></main><footer class="footer"><div class="wrap"><span>Bachata Explosion</span><span>Style preview · Warm Festival</span></div></footer></body></html>