---
const ticketUrl = "https://www.tickettailor.com/events/bachataexplosionbyelenadennis/1902213";
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width" />
<title>Original Refined — Bachata Explosion Style Preview</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap');
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#f5f0e8;color:#191617;font-family:Manrope,system-ui,sans-serif}a{text-decoration:none;color:inherit}.wrap{width:min(1180px,calc(100% - 40px));margin:auto}.nav{position:fixed;z-index:20;top:18px;left:50%;transform:translateX(-50%);width:min(1180px,calc(100% - 32px));height:66px;display:flex;align-items:center;gap:30px;padding:10px 14px 10px 18px;background:rgba(247,242,234,.94);border:1px solid rgba(33,21,25,.13);box-shadow:0 14px 40px rgba(55,34,37,.12);backdrop-filter:blur(16px)}.nav img{width:142px}.links{margin-left:auto;display:flex;gap:24px;align-items:center;font-size:.75rem;font-weight:800;text-transform:uppercase;letter-spacing:.04em}.cta{padding:13px 18px;background:#711d35;color:#fff}.hero{min-height:830px;display:grid;grid-template-columns:1fr 1fr;align-items:stretch;padding-top:100px}.hero-copy{display:flex;flex-direction:column;justify-content:center;padding:70px max(32px,calc((100vw - 1180px)/2)) 60px max(32px,calc((100vw - 1180px)/2))}.eyebrow{color:#9b6b2e;text-transform:uppercase;font-weight:800;font-size:.72rem;letter-spacing:.15em}.hero h1{font-family:'Barlow Condensed',sans-serif;font-size:clamp(5.5rem,10vw,10rem);line-height:.76;margin:18px 0 24px;text-transform:uppercase;letter-spacing:-.035em}.hero h1 span{display:block}.hero h1 em{font-style:normal;color:#711d35}.lead{max-width:590px;color:#655d5f;line-height:1.7;font-size:1.05rem}.actions{display:flex;gap:12px;margin-top:28px;flex-wrap:wrap}.button{padding:15px 20px;border:1px solid #1e191a;font-weight:800;font-size:.74rem;text-transform:uppercase;letter-spacing:.06em}.button.primary{background:#711d35;color:#fff;border-color:#711d35}.hero-media{position:relative;overflow:hidden;background:#1a1416}.hero-media img{width:100%;height:100%;object-fit:cover;display:block;filter:saturate(.85) contrast(1.02)}.hero-media:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 50%,rgba(16,8,11,.45))}.poster{position:absolute;z-index:2;left:-40px;bottom:42px;width:190px;background:#fff;padding:8px;transform:rotate(-3deg);box-shadow:0 18px 45px rgba(0,0,0,.28)}.poster img{height:auto}.facts{background:#1b1718;color:#fff}.fact-grid{display:grid;grid-template-columns:1.4fr repeat(4,1fr)}.fact-grid div{min-height:135px;display:flex;flex-direction:column;justify-content:center;padding:24px;border-right:1px solid rgba(255,255,255,.13)}.fact-grid strong{font:800 2.8rem/.9 'Barlow Condensed';color:#d0a250}.fact-grid span{margin-top:8px;color:#bdb5b3;font-size:.66rem;text-transform:uppercase;letter-spacing:.09em}.section{padding:105px 0}.split{display:grid;grid-template-columns:.9fr 1.1fr;gap:80px;align-items:center}.section h2{font:800 clamp(3.8rem,7vw,7rem)/.85 'Barlow Condensed';text-transform:uppercase;margin:10px 0 24px}.section h2 em{font-style:normal;color:#711d35}.photo{min-height:540px;overflow:hidden}.photo img{width:100%;height:100%;min-height:540px;object-fit:cover}.events{background:#e9dfd2}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:38px}.card{background:#f8f4ed;border:1px solid rgba(30,22,24,.12)}.card img{width:100%;aspect-ratio:4/3;object-fit:cover}.card div{padding:22px}.card h3{font:800 2.3rem/.9 'Barlow Condensed';text-transform:uppercase;margin:5px 0 10px}.card small{color:#9b6b2e;font-weight:800;text-transform:uppercase;letter-spacing:.08em}.footer{background:#171314;color:#eee;padding:65px 0}.footer .wrap{display:flex;justify-content:space-between;gap:30px}.footer strong{color:#d0a250}@media(max-width:900px){.links a:not(.cta){display:none}.hero{grid-template-columns:1fr}.hero-copy{padding:130px 26px 60px}.hero-media{min-height:560px}.poster{left:20px}.fact-grid{grid-template-columns:repeat(2,1fr)}.fact-grid div:first-child{grid-column:1/-1}.split{grid-template-columns:1fr}.cards{grid-template-columns:1fr}.footer .wrap{flex-direction:column}}
</style>
</head>
<body>
<header class="nav"><a href="/"><img src="/media/brand/explosion-logo.webp" alt="Bachata Explosion" /></a><nav class="links"><a href="#festival">Festival</a><a href="#events">Events</a><a href="#story">Our Story</a><a href="#berlin">Berlin</a><a class="cta" href={ticketUrl}>Get tickets</a></nav></header>
<main>
<section class="hero"><div class="hero-copy"><p class="eyebrow">Berlin born · dancer built · since 2022</p><h1><span>Bachata</span><span><em>Explosion</em></span></h1><p class="lead">A cleaner evolution of the original Bachata Explosion feeling: warm, human and festival-focused, with burgundy, gold and real photography instead of heavy decoration.</p><div class="actions"><a class="button primary" href={ticketUrl}>Get tickets</a><a class="button" href="#festival">Explore BBF 2026</a></div></div><div class="hero-media"><img src="/media/bbf/atmosphere/party-143.jpg" alt="Festival dancers" /><a class="poster" href="#festival"><img src="/media/events/bbf-2026-poster.jpg" alt="BBF poster" /></a></div></section>
<section class="facts"><div class="wrap fact-grid"><div><strong>Berlin Bachata Festival</strong><span>16–18 October 2026 · MOA Berlin</span></div><div><strong>3</strong><span>Days</span></div><div><strong>40+</strong><span>Workshops</span></div><div><strong>30+</strong><span>Artists</span></div><div><strong>3</strong><span>Parties</span></div></div></section>
<section class="section" id="story"><div class="wrap split"><div><p class="eyebrow">Why Explosion exists</p><h2>Big events.<br/><em>Human feeling.</em></h2><p class="lead">The original website’s friendliness stays, but the hierarchy becomes clearer: one message per section, bigger imagery and fewer competing graphic elements.</p><div class="actions"><a class="button" href="#events">See our events</a></div></div><div class="photo"><img src="/media/atmosphere/explosion-community.jpg" alt="Explosion community" /></div></div></section>
<section class="section events" id="events"><div class="wrap"><p class="eyebrow">The Explosion family</p><h2>Different formats.<br/><em>One identity.</em></h2><div class="cards"><article class="card"><img src="/media/events/bbf-2026-poster.jpg" alt="BBF"/><div><small>Flagship</small><h3>Berlin Bachata Festival</h3><p>Three days of workshops, artists, parties and community.</p></div></article><article class="card"><img src="/media/events/role-rotation-2026.webp" alt="Role Rotation"/><div><small>Switch perspective</small><h3>Role Rotation</h3><p>Lead, follow and understand connection from both sides.</p></div></article><article class="card"><img src="/media/events/elite-dance-3.webp" alt="Elite Dance"/><div><small>Focused</small><h3>Elite Dance</h3><p>A more intimate training and community experience.</p></div></article></div></div></section>
<section class="section" id="berlin"><div class="wrap split"><div class="photo"><img src="/media/bbf/atmosphere/saturday-62.jpg" alt="Berlin festival"/></div><div><p class="eyebrow">Berlin</p><h2>Our home.<br/><em>Your weekend.</em></h2><p class="lead">Berlin is present through the actual event, the international crowd and the city around it—without turning the website into a Berlin theme park.</p></div></div></section>
</main><footer class="footer"><div class="wrap"><div><strong>Bachata Explosion</strong><br/>Feel it. Live it. Share it.</div><div>Style preview · Original Refined</div></div></footer>
</body></html>