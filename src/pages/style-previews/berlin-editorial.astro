<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>Berlin Editorial — Bachata Explosion</title><style>
@import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800;900&family=Inter:wght@400;500;600;700&display=swap');*{box-sizing:border-box}body{margin:0;background:#efe9de;color:#111;font-family:Inter,system-ui,sans-serif}a{text-decoration:none;color:inherit}.wrap{width:min(1220px,calc(100% - 40px));margin:auto}.nav{height:72px;display:flex;align-items:center;padding:0 24px;border-bottom:1px solid #222;background:#efe9de;position:sticky;top:0;z-index:20}.nav img{width:135px;filter:brightness(0)}.navlinks{margin-left:auto;display:flex;gap:24px;align-items:center;font-size:.72rem;font-weight:700;text-transform:uppercase}.ticket{background:#f2c500;padding:15px 18px}.hero{padding:70px 0 0}.hero-grid{display:grid;grid-template-columns:1.05fr .95fr;min-height:650px;border-top:1px solid #111;border-bottom:1px solid #111}.hero-copy{padding:60px 54px 60px 0;display:flex;flex-direction:column;justify-content:center}.label{font-size:.7rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.hero h1{font:900 clamp(6rem,11vw,12rem)/.72 'Barlow Condensed';letter-spacing:-.045em;text-transform:uppercase;margin:18px 0}.hero h1 span{display:block}.hero p{max-width:600px;font-size:1.05rem;line-height:1.65}.hero-photo{position:relative;overflow:hidden}.hero-photo img{width:100%;height:100%;object-fit:cover;filter:saturate(.75)}.route{position:absolute;left:22px;right:22px;bottom:22px;background:#f2c500;padding:14px 16px;font-weight:800;text-transform:uppercase;font-size:.72rem;letter-spacing:.08em}.facts{display:grid;grid-template-columns:repeat(5,1fr);border-bottom:1px solid #111}.facts div{padding:26px;border-right:1px solid #111}.facts strong{display:block;font:800 3.1rem/.9 'Barlow Condensed'}.facts span{font-size:.64rem;text-transform:uppercase;font-weight:700}.section{padding:100px 0}.title{font:900 clamp(4rem,8vw,8.5rem)/.8 'Barlow Condensed';text-transform:uppercase;margin:0}.section-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:start}.copy{font-size:1.05rem;line-height:1.7;max-width:560px}.poster-row{display:grid;grid-template-columns:1.2fr .8fr;gap:16px;margin-top:40px}.poster-row img{width:100%;height:520px;object-fit:cover}.black{background:#111;color:#efe9de}.black .label{color:#f2c500}.berlin-strip{display:grid;grid-template-columns:2fr 1fr 1fr;border-top:1px solid #efe9de;border-bottom:1px solid #efe9de;margin-top:50px}.berlin-strip div{padding:26px;border-right:1px solid #efe9de}.berlin-strip strong{font:800 2.5rem/.9 'Barlow Condensed';text-transform:uppercase}.footer{padding:50px 0;background:#f2c500;color:#111}.footer .wrap{display:flex;justify-content:space-between;font-weight:700}@media(max-width:850px){.navlinks a:not(.ticket){display:none}.hero-grid,.section-grid,.poster-row{grid-template-columns:1fr}.hero-copy{padding:50px 0}.hero-photo{min-height:480px}.facts{grid-template-columns:repeat(2,1fr)}.facts div:first-child{grid-column:1/-1}.berlin-strip{grid-template-columns:1fr}.poster-row img{height:420px}}
</style></head><body><header class="nav"><img src="/media/brand/explosion-logo.webp" alt="Bachata Explosion"/><nav class="navlinks"><a href="#festival">Festival</a><a href="#events">Events</a><a href="#berlin">Berlin</a><a href="#story">Story</a><a class="ticket" href={ticketUrl}>Get tickets</a></nav></header><main><section class="hero"><div class="wrap hero-grid"><div class="hero-copy"><p class="label">Berlin · October 16–18, 2026</p><h1><span>Bachata</span><span>Explosion</span></h1><p>A graphic, highly organised direction inspired by Berlin editorial design: strong grids, clear hierarchy, real city photography and almost no decoration.</p></div><div class="hero-photo"><img src="/media/bbf/atmosphere/party-141.jpg" alt="Bachata festival"/><div class="route">MOA Berlin → Workshops → Socials → After Dark</div></div></div><div class="wrap facts"><div><strong>BBF 2026</strong><span>Flagship event</span></div><div><strong>3</strong><span>Days</span></div><div><strong>40+</strong><span>Workshops</span></div><div><strong>30+</strong><span>Artists</span></div><div><strong>3</strong><span>Parties</span></div></div></section><section class="section" id="festival"><div class="wrap section-grid"><div><p class="label">01 / Festival</p><h2 class="title">Clear.<br/>Bold.<br/>Berlin.</h2></div><div><p class="copy">This direction makes the website feel designed rather than decorated. Each section has one job, with strong spacing and typography creating the Berlin identity.</p><div class="poster-row"><img src="/media/events/bbf-2026-poster.jpg" alt="BBF poster"/><img src="/media/bbf/atmosphere/saturday-60.jpg" alt="Festival atmosphere"/></div></div></div></section><section class="section black" id="berlin"><div class="wrap"><p class="label">02 / Berlin</p><h2 class="title">The city becomes<br/>part of the system.</h2><div class="berlin-strip"><div><strong>Berlin born</strong><p class="copy">Not landmarks everywhere. Berlin comes through structure, transport-like labels, contrast and real event imagery.</p></div><div><strong>MOA</strong><p>One venue</p></div><div><strong>2022→</strong><p>Explosion history</p></div></div></div></section></main><footer class="footer"><div class="wrap"><span>Bachata Explosion</span><span>Style preview · Berlin Editorial</span></div></footer></body></html>