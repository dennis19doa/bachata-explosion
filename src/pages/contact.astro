---
import BaseLayout from "../layouts/BaseLayout.astro";
import { contactTopicEndpoints } from "../lib/forms";

const routes = [
  { value: "Ticket question", number: "01", label: "Tickets", alias: "tickets@bachataexplosion.com", subject: "[Bachata Explosion] Ticket question", detail: "Passes, payments, confirmations or name changes" },
  { value: "Group discount", number: "02", label: "Groups", alias: "groups@bachataexplosion.com", subject: "[Bachata Explosion] Group discount", detail: "Promo codes and bringing your dance community" },
  { value: "Partnership or ambassador", number: "03", label: "Partners", alias: "partners@bachataexplosion.com", subject: "[Bachata Explosion] Partnership", detail: "Ambassadors, studios, brands and collaborations" },
  { value: "Media or photographer", number: "04", label: "Media", alias: "media@bachataexplosion.com", subject: "[Bachata Explosion] Media request", detail: "Press, photographers, video and content requests" },
  { value: "Volunteer", number: "05", label: "Volunteer", alias: "volunteers@bachataexplosion.com", subject: "[Bachata Explosion] Volunteer inquiry", detail: "Help the team before or during an event" },
  { value: "General question", number: "06", label: "General", alias: "info@bachataexplosion.com", subject: "[Bachata Explosion] General contact", detail: "Anything that does not fit the other routes" },
] as const;

const events = ["Berlin Bachata Festival 2026", "Role Rotation", "Elite Dance #3", "Jack & Jill", "Past event / photo archive", "Not event-specific"];
const initialRoute = routes[0];
const initialEndpoint = contactTopicEndpoints[initialRoute.value];
const formConnected = Object.values(contactTopicEndpoints).some(Boolean);
---

<BaseLayout
  title="Contact Bachata Explosion — tickets, groups, partners and media"
  description="Contact the Bachata Explosion team about tickets, groups, partnerships, media, volunteering or a general question."
  headerStyle="solid"
>
  <article class="contact-2026" data-wordpress-source="contact">
    <section class="contact-hero" aria-labelledby="contact-title">
      <div class="urban-hero-word" aria-hidden="true">CONNECT</div>
      <div class="contact-hero-orbit" aria-hidden="true"><span></span><span></span><span></span></div>
      <div class="shell contact-hero-grid">
        <div>
          <p class="eyebrow"><span></span>Talk to the Explosion team</p>
          <h1 id="contact-title">Tell us<br /><em>what you need.</em></h1>
        </div>
        <div class="contact-hero-copy">
          <p>Choose a topic and give us the details we need to answer properly.</p>
          <a class="contact-direct" href="mailto:info@bachataexplosion.com">
            <span>Prefer your email app?</span>
            <strong>info@bachataexplosion.com ↗</strong>
          </a>
        </div>
      </div>
    </section>

    <section class="contact-routing section-pad" aria-labelledby="contact-routing-title">
      <div class="shell">
        <div class="contact-section-heading">
          <div><p class="section-label">Step 01 · Choose a topic</p><h2 id="contact-routing-title">What can we<br /><em>help with?</em></h2></div>
          <p>One simple form, routed to the right part of the team.</p>
        </div>
        <div class="contact-route-grid">
          {routes.map((route, index) => (
            <button type="button" class="contact-route" data-contact-topic={route.value} aria-pressed={index === 0 ? "true" : "false"}>
              <span>{route.number}</span>
              <strong>{route.label}</strong>
              <small>{route.detail}</small>
              <i aria-hidden="true">↘</i>
            </button>
          ))}
        </div>
      </div>
    </section>

    <section class="contact-workbench section-pad" id="message" aria-labelledby="contact-form-title">
      <div class="shell contact-workbench-grid">
        <div class="contact-workbench-intro">
          <p class="section-label">Step 02 · Add the details</p>
          <h2 id="contact-form-title">Make it easy<br /><em>to answer.</em></h2>
          <p>For ticket questions, use the same email address you used at checkout.</p>
          <div class="contact-delivery-card">
            <span>Message route</span>
            <strong data-contact-destination>{initialRoute.alias}</strong>
            <p>The selected topic determines the form endpoint and the role address used for sorting and replies.</p>
          </div>
        </div>

        <form
          class="contact-form contact-form-2026"
          id="contact-form"
          method="POST"
          action={initialEndpoint || undefined}
          data-contact-endpoint={initialEndpoint}
          data-contact-endpoints={JSON.stringify(contactTopicEndpoints)}
          data-contact-connected={String(formConnected)}
        >
          <input type="hidden" name="_email.subject" value={initialRoute.subject} data-contact-subject />
          <input type="hidden" name="destination_alias" value={initialRoute.alias} data-contact-alias />
          <label>
            <span>Full name *</span>
            <input type="text" name="name" autocomplete="name" required maxlength="100" placeholder="How should we call you?" />
          </label>
          <label>
            <span>Email *</span>
            <input type="email" name="email" autocomplete="email" required maxlength="180" placeholder="you@example.com" />
          </label>
          <label>
            <span>WhatsApp</span>
            <input type="tel" name="whatsapp" autocomplete="tel" maxlength="40" placeholder="Optional, including country code" />
          </label>
          <label>
            <span>Topic *</span>
            <select name="topic" required data-contact-select>
              {routes.map((route) => <option value={route.value}>{route.label}</option>)}
            </select>
          </label>
          <label class="full-field">
            <span>Event</span>
            <select name="event">
              <option value="">Choose if relevant</option>
              {events.map((event) => <option value={event}>{event}</option>)}
            </select>
          </label>
          <label class="full-field">
            <span>Message *</span>
            <textarea name="message" rows="7" required maxlength="2000" placeholder="What would you like us to know?"></textarea>
          </label>
          <label class="form-trap" aria-hidden="true">
            <span>Leave this field empty</span>
            <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
          </label>
          <label class="consent full-field">
            <input type="checkbox" name="privacy_consent" value="yes" required />
            <span>I agree that my details may be used to answer this request. See the <a href="/privacy/">privacy policy</a>.</span>
          </label>
          <div class="contact-form-action full-field">
            <button class="button button-gold" type="submit" data-submit-label>Send message</button>
            <small>{formConnected ? "Secure form routing is configured." : "Preview mode: no message is transmitted yet."}</small>
          </div>
          <p class="contact-form-status full-field" role="status" aria-live="polite" data-contact-status>
            {formConnected ? "Ready when you are." : "The routing is ready. Add the protected form endpoints to activate delivery."}
          </p>
        </form>
      </div>
    </section>

    <section class="contact-next section-pad">
      <div class="shell contact-next-grid">
        <div><p class="section-label">Other doors</p><h2>Join the<br /><em>team.</em></h2></div>
        <a href="/volunteers/"><span>Volunteer applications</span><strong>Help make the weekend happen</strong><i>↗</i></a>
        <a href="/ambassadors/"><span>Ambassador program</span><strong>Bring your community into the Explosion</strong><i>↗</i></a>
      </div>
    </section>
  </article>

  <script>
    const form = document.querySelector<HTMLFormElement>("#contact-form");
    const topicSelect = form?.querySelector<HTMLSelectElement>("[data-contact-select]");
    const routeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-contact-topic]"));
    const status = form?.querySelector<HTMLElement>("[data-contact-status]");
    const submitButton = form?.querySelector<HTMLButtonElement>("[data-submit-label]");
    const subjectInput = form?.querySelector<HTMLInputElement>("[data-contact-subject]");
    const aliasInput = form?.querySelector<HTMLInputElement>("[data-contact-alias]");
    const destination = document.querySelector<HTMLElement>("[data-contact-destination]");

    const routing: Record<string, { alias: string; subject: string }> = {
      "Ticket question": { alias: "tickets@bachataexplosion.com", subject: "[Bachata Explosion] Ticket question" },
      "Group discount": { alias: "groups@bachataexplosion.com", subject: "[Bachata Explosion] Group discount" },
      "Partnership or ambassador": { alias: "partners@bachataexplosion.com", subject: "[Bachata Explosion] Partnership" },
      "Media or photographer": { alias: "media@bachataexplosion.com", subject: "[Bachata Explosion] Media request" },
      Volunteer: { alias: "volunteers@bachataexplosion.com", subject: "[Bachata Explosion] Volunteer inquiry" },
      "General question": { alias: "info@bachataexplosion.com", subject: "[Bachata Explosion] General contact" },
    };

    let endpoints: Record<string, string> = {};
    try { endpoints = JSON.parse(form?.dataset.contactEndpoints ?? "{}"); } catch { endpoints = {}; }

    const applyTopic = (topic: string) => {
      const route = routing[topic] ?? routing["General question"];
      const endpoint = endpoints[topic]?.trim() ?? "";
      if (topicSelect) topicSelect.value = topic;
      if (form) {
        form.dataset.contactEndpoint = endpoint;
        if (endpoint) form.action = endpoint;
        else form.removeAttribute("action");
      }
      if (subjectInput) subjectInput.value = route.subject;
      if (aliasInput) aliasInput.value = route.alias;
      if (destination) destination.textContent = route.alias;
      routeButtons.forEach((candidate) => candidate.setAttribute("aria-pressed", String(candidate.dataset.contactTopic === topic)));
      if (status && !endpoint) status.textContent = `Preview mode for ${route.alias}: add its protected endpoint to activate delivery.`;
      else if (status) status.textContent = `Ready to route this message through ${route.alias}.`;
    };

    routeButtons.forEach((button) => {
      button.addEventListener("click", () => {
        applyTopic(button.dataset.contactTopic ?? "General question");
        document.querySelector("#message")?.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });
    topicSelect?.addEventListener("change", () => applyTopic(topicSelect.value));

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const topic = topicSelect?.value ?? "General question";
      applyTopic(topic);
      const endpoint = form.dataset.contactEndpoint?.trim();
      const route = routing[topic] ?? routing["General question"];
      if (!endpoint) {
        if (status) status.textContent = `Preview mode is active for ${route.alias}, so nothing was sent yet.`;
        return;
      }

      if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent = "Sending…";
      }
      if (status) status.textContent = `Sending securely via ${route.alias}…`;

      try {
        const response = await fetch(endpoint, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        if (!response.ok) throw new Error(`Submission failed with ${response.status}`);
        form.reset();
        applyTopic("Ticket question");
        if (status) {
          status.classList.remove("is-error");
          status.classList.add("is-success");
          status.textContent = "Message received. Thank you—your request was routed with its topic and event details.";
        }
      } catch {
        if (status) {
          status.classList.remove("is-success");
          status.classList.add("is-error");
          status.textContent = `The message could not be delivered. Please try again or email ${route.alias} directly.`;
        }
      } finally {
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.textContent = "Send message";
        }
      }
    });
  </script>
</BaseLayout>
