  </style>

  <script>
    const jjRules = Array.from(document.querySelectorAll<HTMLDetailsElement>(".jj26-rule-list details"));
    jjRules.forEach((rule) => rule.addEventListener("toggle", () => { if (!rule.open) return; jjRules.forEach((candidate) => { if (candidate !== rule) candidate.open = false; }); }));

    const jjForm = document.querySelector<HTMLFormElement>("[data-jj-form]");
    const jjStatus = jjForm?.querySelector<HTMLElement>("[data-jj-status]");
    const jjSubmit = jjForm?.querySelector<HTMLButtonElement>("[data-jj-submit]");
    jjForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const endpoint = jjForm.dataset.jjEndpoint?.trim();
      if (!endpoint) { if (jjStatus) jjStatus.textContent = "Registration is designed and ready, but delivery is still in preview mode until the protected email endpoint is connected."; return; }
      if (jjSubmit) { jjSubmit.disabled = true; jjSubmit.textContent = "Sending…"; }
      try {
        const response = await fetch(endpoint, { method: "POST", body: new FormData(jjForm), headers: { Accept: "application/json" } });
        if (!response.ok) throw new Error("Registration failed");
        jjForm.reset();
        if (jjStatus) jjStatus.textContent = "Registration received. The team will verify your Full Pass and contact you.";
      } catch { if (jjStatus) jjStatus.textContent = "Registration could not be delivered. Please try again or email info@bachataexplosion.com."; }
      finally { if (jjSubmit) { jjSubmit.disabled = false; jjSubmit.textContent = "Submit registration"; } }
    });
  </script>
</BaseLayout>
