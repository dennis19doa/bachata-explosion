---
import BaseLayout from "../layouts/BaseLayout.astro";
import { archiveEvents } from "../data/archive";
import { ticketUrl } from "../data/festival";
import "../styles/home-refresh.css";

const teamNames = ["Laura", "Lucy", "Mircea", "Roberto", "Jenn", "Milo", "Blanca"];
---

<BaseLayout
  title="Bachata Explosion — Berlin Bachata events by dancers, for dancers"
  description="Bachata Explosion is a Berlin-born bachata event family: Berlin Bachata Festival 2026, Role Rotation, Elite Dance and a growing international community."
>
  <div class="refresh-home" data-wordpress-source="home">
    <section class="refresh-hero" aria-labelledby="refresh-hero-title">
      <div class="refresh-hero-copy">
        <div class="refresh-hero-overline">
          <b>Born in Berlin</b>
          <span>16–18 October 2026</span>
          <span>MOA Berlin</span>
        </div>
        <h1 id="refresh-hero-title"><span>Bachata</span><span><em>Explosion</em></span></h1>
        <p class="refresh-hero-tagline">Feel it. Live it. Share it.</p>
        <p class="refresh-copy refresh-hero-lead">A dancer-built event family with ambitious teaching, international artists, packed socials and a community that still feels personal.</p>
        <div class="refresh-hero-actions">
          <a class="refresh-button" href={ticketUrl}>Get tickets</a>
          <a class="refresh-button refresh-button-light" href="/bbf-2026/">Discover BBF 2026</a>
        </div>
        <div class="refresh-countdown" data-countdown="2026-10-16T18:00:00+02:00" aria-label="Countdown to Berlin Bachata Festival 2026">
          <div><strong data-days>—</strong><span>Days</span></div>
          <div><strong data-hours>—</strong><span>Hours</span></div>
          <div><strong data-minutes>—</strong><span>Minutes</span></div>
        </div>
      </div>

      <div class="refresh-hero-visual">
        <video class="ug-hero-video" autoplay muted loop playsinline preload="metadata" poster="/media/atmosphere/party-crowd.webp" aria-label="Bachata Explosion festival atmosphere">
          <source src="/media/video/bbf-2026-recap.mp4" type="video/mp4" />
        </video>
        <span class="refresh-hero-note">Berlin energy.<br />Explosion community.</span>
        <a class="refresh-hero-poster" href="/bbf-2026/" aria-label="Open Berlin Bachata Festival 2026">
          <img src="/media/events/bbf-2026-poster.jpg" alt="Berlin Bachata Festival 2026 poster" width="1080" height="1350" />
          <span>BBF 2026 · Official artwork ↗</span>
        </a>
      </div>
    </section>

    <section class="refresh-facts" aria-label="Berlin Bachata Festival 2026 highlights">
      <div class="refresh-shell refresh-fact-grid">
        <div class="refresh-fact-intro"><strong>One community.</strong><span>Built for the dance floor.</span></div>
        <div><strong>3</strong><span>Days</span></div>
        <div><strong>40+</strong><span>Workshops</span></div>
        <div><strong>30+</strong><span>Artists</span></div>
        <div><strong>3</strong><span>Parties</span></div>
      </div>
    </section>

    <section class="refresh-story refresh-section" aria-labelledby="refresh-story-title">
      <div class="refresh-shell refresh-story-grid">
        <div class="refresh-story-copy">
          <p class="refresh-kicker">More than a festival</p>
          <h2 class="refresh-title" id="refresh-story-title">A movement built around <em>connection.</em></h2>
          <p class="refresh-copy">Bachata Explosion grew in Berlin from one simple idea: create the kind of dance experience we would want to attend ourselves—strong teaching, serious dancing and enough warmth that people still feel seen.</p>
          <div class="refresh-values">
            <div><b>Dance</b><span>Workshops that give you something real to take home.</span></div>
            <div><b>Connect</b><span>A social floor where the community matters as much as the line-up.</span></div>
            <div><b>Celebrate</b><span>Big-event energy without losing the personal side of Explosion.</span></div>
          </div>
        </div>
        <figure class="refresh-story-photo">
          <img src="/media/atmosphere/explosion-community.jpg" alt="Bachata Explosion community together in Berlin" width="1200" height="800" loading="lazy" />
          <figcaption>By dancers, for dancers — born in Berlin.</figcaption>
        </figure>
      </div>
    </section>

    <section class="refresh-next refresh-section" aria-labelledby="refresh-next-title">
      <div class="refresh-shell">
        <div class="refresh-next-heading">
          <div>
            <p class="refresh-kicker">The next Explosion</p>
            <h2 class="refresh-title" id="refresh-next-title">Berlin Bachata <em>Festival.</em></h2>
          </div>
          <p class="refresh-copy">16–18 October 2026 at Hotel MOA Berlin. Workshops, parties, shows, competitions and an international bachata community under one roof.</p>
        </div>
        <article class="refresh-next-card">
          <img src="/media/events/bbf-2026-poster.jpg" alt="Berlin Bachata Festival 2026 official artwork" width="1080" height="1350" loading="lazy" />
          <div class="refresh-next-content">
            <p class="refresh-kicker">October 16–18 · MOA Berlin</p>
            <h3>Three days.<br />One Explosion.</h3>
            <p>The flagship Bachata Explosion weekend brings together international artists, focused workshops, social dancing, shows and Jack & Jill in Berlin.</p>
            <div class="refresh-next-tags"><span>40+ workshops</span><span>30+ artists</span><span>3 parties</span><span>Jack & Jill</span></div>
            <div class="refresh-hero-actions">
              <a class="refresh-button" href="/bbf-2026/">Explore festival</a>
              <a class="refresh-button refresh-button-light" href={ticketUrl}>Get tickets</a>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section class="refresh-universe refresh-section" aria-labelledby="refresh-universe-title">
      <div class="refresh-shell">
        <p class="refresh-kicker">The Explosion universe</p>
        <h2 class="refresh-title" id="refresh-universe-title">Different concepts.<br /><em>Same DNA.</em></h2>
        <div class="refresh-universe-grid">
          <a class="refresh-event-card" href="/bbf-2026/">
            <img src="/media/events/bbf-2026-poster.jpg" alt="Berlin Bachata Festival 2026" width="1080" height="1350" loading="lazy" />
            <div><small>Flagship weekend</small><h3>Berlin Bachata Festival</h3><p>The full-scale Explosion experience in Berlin.</p><b>Explore BBF →</b></div>
          </a>
          <a class="refresh-event-card" href="/archive/role-rotation-2026/">
            <img src="/media/events/role-rotation-2026.webp" alt="Role Rotation 2026" width="900" height="1100" loading="lazy" />
            <div><small>Switch perspective</small><h3>Role Rotation</h3><p>Lead, follow and understand connection from both sides.</p><b>Explore Role Rotation →</b></div>
          </a>
          <a class="refresh-event-card" href="/archive/elite-dance-3/">
            <img src="/media/events/elite-dance-3.webp" alt="Elite Dance 3" width="900" height="1100" loading="lazy" />
            <div><small>More intimate</small><h3>Elite Dance</h3><p>Selected artists, focused growth and a closer community atmosphere.</p><b>Explore Elite Dance →</b></div>
          </a>
        </div>
      </div>
    </section>

    <section class="refresh-community refresh-section" aria-labelledby="refresh-community-title">
      <div class="refresh-shell refresh-community-grid">
        <div>
          <p class="refresh-kicker">The Explosion feeling</p>
          <h2 class="refresh-title" id="refresh-community-title">The room matters more than the <em>poster.</em></h2>
          <p class="refresh-copy">The moments people remember are the social that would not end, the workshop where something finally clicked and the new friends who made Berlin feel familiar.</p>
          <p class="refresh-community-quote">Feel it. Live it. Share it.</p>
        </div>
        <div class="refresh-community-pics" aria-label="Bachata Explosion atmosphere">
          <img src="/media/bbf/atmosphere/party-141.jpg" alt="Bachata Explosion party atmosphere" width="1200" height="800" loading="lazy" />
          <img src="/media/bbf/atmosphere/saturday-60.jpg" alt="Bachata Explosion dancers during the festival" width="1200" height="800" loading="lazy" />
        </div>
      </div>
    </section>

    <section class="refresh-people refresh-section" aria-labelledby="refresh-people-title">
      <div class="refresh-shell refresh-people-grid">
        <div class="refresh-founder-pics">
          <figure><img src="/media/team/dennis.jpg" alt="Dennis, founder of Bachata Explosion" width="600" height="800" loading="lazy" /><figcaption>Dennis · Founder</figcaption></figure>
          <figure><img src="/media/team/elena.jpg" alt="Elena, founder of Bachata Explosion" width="600" height="800" loading="lazy" /><figcaption>Elena · Founder</figcaption></figure>
        </div>
        <div class="refresh-people-copy">
          <p class="refresh-kicker">Behind Explosion</p>
          <h2 class="refresh-title" id="refresh-people-title">Dancer-built.<br /><em>Human-led.</em></h2>
          <p class="refresh-copy">Dennis and Elena built Bachata Explosion from the dance floor outward, together with a team that keeps each edition organised, ambitious and welcoming.</p>
          <div class="refresh-team-names" aria-label="Bachata Explosion team">
            {teamNames.map((name) => <span>{name}</span>)}
          </div>
        </div>
      </div>
    </section>

    <section class="refresh-history refresh-section" aria-labelledby="refresh-history-title">
      <div class="refresh-shell refresh-history-grid">
        <div>
          <p class="refresh-kicker">Since 2022</p>
          <h2 class="refresh-title" id="refresh-history-title">Every edition leaves a <em>mark.</em></h2>
        </div>
        <div>
          <p class="refresh-copy">The redesign keeps the complete Bachata Explosion history: {archiveEvents.length} editions, original event chapters, posters and galleries.</p>
          <div class="refresh-history-actions">
            <a class="refresh-button" href="/archive/">Past events</a>
            <a class="refresh-button refresh-button-light" href="/explosion-history/">Our story</a>
          </div>
        </div>
      </div>
    </section>
  </div>

  <style is:global>
    .refresh-hero-tagline{margin:20px 0 0;color:var(--rh-gold-bright);font:400 clamp(1.45rem,2.5vw,2.25rem)/1 var(--marker,cursive);transform:rotate(-2deg)}
    .ug-hero-video{width:100%;height:100%;min-height:804px;display:block;object-fit:cover;object-position:center;filter:saturate(.72) contrast(1.15) brightness(.72)}
    @media(max-width:1000px){.ug-hero-video{min-height:620px}}
    @media(max-width:680px){.ug-hero-video{min-height:520px}}
  </style>

  <script>
    const countdown = document.querySelector<HTMLElement>("[data-countdown]");
    const updateCountdown = () => {
      if (!countdown) return;
      const target = new Date(countdown.dataset.countdown ?? "").getTime();
      const remaining = Math.max(0, target - Date.now());
      const day = 86_400_000;
      const hour = 3_600_000;
      const minute = 60_000;
      const values = {
        days: Math.floor(remaining / day),
        hours: Math.floor((remaining % day) / hour),
        minutes: Math.floor((remaining % hour) / minute),
      };
      Object.entries(values).forEach(([key, value]) => {
        const element = countdown.querySelector<HTMLElement>(`[data-${key}]`);
        if (element) element.textContent = String(value).padStart(2, "0");
      });
    };
    updateCountdown();
    window.setInterval(updateCountdown, 60_000);
  </script>
</BaseLayout>
