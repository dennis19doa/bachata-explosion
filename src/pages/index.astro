---
import BaseLayout from "../layouts/BaseLayout.astro";
import { archiveEvents } from "../data/archive";
import { ticketUrl } from "../data/festival";
import "../styles/home-impact.css";

const team = [
  { name: "Dennis", image: "/media/team/dennis.jpg", label: "Founder" },
  { name: "Elena", image: "/media/team/elena.jpg", label: "Founder" },
  { name: "Laura", image: "/media/team/laura.jpg", label: "Explosion team" },
  { name: "Lucy", image: "/media/team/lucy.jpg", label: "Explosion team" },
  { name: "Mircea", image: "/media/team/mircea.jpg", label: "Explosion team" },
  { name: "Roberto", image: "/media/team/roberto.jpg", label: "Explosion team" },
  { name: "Jenn", image: "/media/team/jenn.jpg", label: "Explosion team" },
  { name: "Milo", image: "/media/team/milo.jpg", label: "Explosion team" },
  { name: "Blanca", image: "/media/team/blanca.jpg", label: "Explosion team" },
] as const;

const historyHighlights = [
  archiveEvents.find((event) => event.slug === "gold-edition-2022"),
  archiveEvents.find((event) => event.slug === "berlin-bachata-festival-2023"),
  archiveEvents.find((event) => event.slug === "berlin-bachata-festival-2024"),
  archiveEvents.find((event) => event.slug === "berlin-bachata-festival-2025"),
  archiveEvents.find((event) => event.slug === "role-rotation-2026"),
].filter(Boolean);
---

<BaseLayout
  title="Bachata Explosion — Berlin Bachata events by dancers, for dancers"
  description="Bachata Explosion is a Berlin-born bachata event family: Berlin Bachata Festival 2026, Role Rotation, Elite Dance and a growing international community."
>
  <div class="impact-home" data-wordpress-source="home">
    <section class="impact-hero" aria-labelledby="impact-hero-title">
      <video class="impact-hero-video ug-hero-video" autoplay muted loop playsinline preload="metadata" poster="/media/atmosphere/party-crowd.webp" aria-label="Bachata Explosion festival atmosphere">
        <source src="/media/video/bbf-2026-recap.mp4" type="video/mp4" />
      </video>
      <div class="impact-hero-wash" aria-hidden="true"></div>
      <div class="impact-shell impact-hero-layout">
        <div class="impact-hero-copy">
          <p class="impact-route-label"><span>BERLIN</span><b>16–18 OCT 2026</b><span>MOA BERLIN</span></p>
          <h1 id="impact-hero-title"><span>Bachata</span><span>Explosion</span></h1>
          <p class="impact-tagline">Feel it. Live it. Share it.</p>
          <p class="impact-copy impact-hero-lead">A Berlin-born event family built around serious dancing, ambitious teaching and the kind of community that still feels personal.</p>
          <div class="impact-actions">
            <a class="impact-button" href={ticketUrl} data-ticket-checkout>Get tickets</a>
            <a class="impact-button ghost" href="/bbf-2026/">Explore festival</a>
          </div>
        </div>

        <aside class="impact-hero-note" aria-label="Berlin Bachata Festival 2026">
          <span>BERLIN / MOABIT / 2026</span>
          <p>Berlin is our <em>dancefloor.</em></p>
          <small>By dancers. For dancers. Open to the world.</small>
        </aside>
      </div>
    </section>

    <section class="impact-info-strip" aria-label="Berlin Bachata Festival 2026 highlights">
      <div class="impact-shell impact-info-grid">
        <div><small>When</small><strong>16–18 Oct</strong></div>
        <div><small>Where</small><strong>MOA Berlin</strong></div>
        <div><small>Workshops</small><strong>40+</strong></div>
        <div><small>Artists</small><strong>30+</strong></div>
        <div><small>Nights</small><strong>3 parties</strong></div>
      </div>
    </section>

    <section class="impact-story impact-section" aria-labelledby="impact-story-title">
      <div class="impact-shell impact-story-grid">
        <div class="impact-story-copy">
          <p class="impact-kicker">01 / Why Explosion</p>
          <h2 class="impact-title" id="impact-story-title">A festival can be big<br />without feeling <em>anonymous.</em></h2>
          <p class="impact-copy">Bachata Explosion grew in Berlin from a simple idea: create the dance experience we would want to attend ourselves. Strong teaching. Serious dancing. Enough personality that people remember more than the timetable.</p>
          <a class="impact-text-link" href="/explosion-history/">Read our story →</a>
        </div>
        <figure class="impact-story-media">
          <img src="/media/atmosphere/explosion-community.jpg" alt="Bachata Explosion community together in Berlin" width="1200" height="800" loading="lazy" />
          <figcaption><b>People first.</b><span>That has been the point since 2022.</span></figcaption>
        </figure>
      </div>
      <div class="impact-shell impact-values" aria-label="Bachata Explosion values">
        <div><span>01</span><b>Dance</b><p>Workshops that give dancers something real to take home.</p></div>
        <div><span>02</span><b>Connect</b><p>A social floor where community matters as much as the line-up.</p></div>
        <div><span>03</span><b>Celebrate</b><p>Big-event energy without losing the human side of Explosion.</p></div>
      </div>
    </section>

    <section class="impact-feature impact-section" aria-labelledby="impact-feature-title">
      <div class="impact-shell impact-feature-grid">
        <div class="impact-feature-art">
          <span class="impact-art-label">Official artwork · 2026</span>
          <img src="/media/events/bbf-2026-poster.jpg" alt="Berlin Bachata Festival 2026 poster" width="1080" height="1350" loading="lazy" />
        </div>
        <div class="impact-feature-copy">
          <p class="impact-kicker">02 / The next Explosion</p>
          <h2 class="impact-title" id="impact-feature-title">Berlin Bachata<br /><em>Festival 2026.</em></h2>
          <p class="impact-copy">Three days of international artists, focused workshops, social dancing, shows and Jack & Jill — all under one roof at MOA Berlin.</p>
          <dl class="impact-festival-facts">
            <div><dt>40+</dt><dd>Workshops</dd></div>
            <div><dt>30+</dt><dd>Artists</dd></div>
            <div><dt>3</dt><dd>Party nights</dd></div>
          </dl>
          <div class="impact-actions">
            <a class="impact-button dark" href="/bbf-2026/">Explore festival</a>
            <a class="impact-text-link" href={ticketUrl} data-ticket-checkout>Buy a pass →</a>
          </div>
        </div>
      </div>
    </section>

    <section class="impact-concepts impact-section" aria-labelledby="impact-events-title">
      <div class="impact-shell impact-section-heading">
        <p class="impact-kicker">03 / The Explosion universe</p>
        <h2 class="impact-title" id="impact-events-title">Different formats.<br /><em>Different feeling.</em></h2>
        <p class="impact-copy">The formats are related, but they are not the same event in three boxes. Each has its own reason to exist.</p>
      </div>

      <div class="impact-shell impact-concept-list">
        <a class="impact-concept impact-concept-bbf" href="/bbf-2026/">
          <figure><img src="/media/events/bbf-2026-poster.jpg" alt="Berlin Bachata Festival 2026" width="1080" height="1350" loading="lazy" /></figure>
          <div><small>01 · THE FLAGSHIP</small><h3>Berlin Bachata Festival</h3><p>The full-scale Explosion weekend: international line-up, workshops, competition and long Berlin nights.</p><b>Explore festival →</b></div>
        </a>

        <a class="impact-concept impact-concept-role" href="/archive/role-rotation-2026/">
          <figure><img src="/media/events/role-rotation-2026.webp" alt="Role Rotation 2026" width="900" height="1100" loading="lazy" /></figure>
          <div><small>02 · CHANGE PERSPECTIVE</small><h3>Role Rotation</h3><p>A weekend built around switching roles, empathy and understanding connection from both sides.</p><b>Explore Role Rotation →</b></div>
        </a>

        <a class="impact-concept impact-concept-elite" href="/archive/elite-dance-3/">
          <figure><img src="/media/events/elite-dance-3.webp" alt="Elite Dance 3" width="900" height="1100" loading="lazy" /></figure>
          <div><small>03 · GO DEEPER</small><h3>Elite Dance</h3><p>Smaller scale, selected artists and a closer environment for dancers who want focused growth.</p><b>Explore Elite Dance →</b></div>
        </a>
      </div>
    </section>

    <section class="impact-berlin impact-section" aria-labelledby="impact-berlin-title">
      <div class="impact-shell impact-berlin-grid">
        <div class="impact-berlin-copy">
          <p class="impact-kicker">04 / Made in Berlin</p>
          <h2 class="impact-title" id="impact-berlin-title">The city is part of the event.<br /><em>Not a decoration.</em></h2>
          <p class="impact-copy">Berlin gives Explosion its attitude: direct, international, creative and comfortable with contrasts. We use that language in the way the site guides you, not by covering every page in landmarks.</p>
          <div class="impact-berlin-signs"><span>BERLIN / MOABIT</span><span>MOA → FESTIVAL FLOOR</span><span>OPEN TO THE WORLD</span></div>
          <a class="impact-text-link" href="/bbf-2026/#travel">Plan your Berlin weekend →</a>
        </div>
        <figure class="impact-berlin-media">
          <img src="/media/bbf/atmosphere/party-143.jpg" alt="Bachata Explosion dance floor in Berlin" width="1200" height="800" loading="lazy" />
          <span>BERLIN AFTER DARK</span>
        </figure>
      </div>
    </section>

    <section class="impact-people impact-section" aria-labelledby="impact-people-title">
      <div class="impact-shell impact-section-heading impact-people-heading">
        <p class="impact-kicker">05 / Behind Explosion</p>
        <h2 class="impact-title" id="impact-people-title">Built by people<br />who are still on the <em>dance floor.</em></h2>
        <p class="impact-copy">Explosion is not a faceless festival brand. The people behind the event are part of what dancers come back for.</p>
      </div>

      <div class="impact-shell impact-team-wall">
        {team.map((person, index) => (
          <figure class:list={["impact-person", index < 2 && "is-founder"]}>
            <img src={person.image} alt={`${person.name} — Bachata Explosion`} width="600" height="800" loading="lazy" />
            <figcaption><strong>{person.name}</strong><span>{person.label}</span></figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="impact-history impact-section" aria-labelledby="impact-history-title">
      <div class="impact-shell impact-history-head">
        <div><p class="impact-kicker">06 / Explosion since 2022</p><h2 class="impact-title" id="impact-history-title">The archive is part of<br />the <em>brand.</em></h2></div>
        <div><p class="impact-copy">Every edition has its own artwork, people and atmosphere. Instead of hiding that history, we keep it visible.</p><div class="impact-actions"><a class="impact-button" href="/archive/">See all past events</a><a class="impact-text-link light" href="/explosion-history/">Read the story →</a></div></div>
      </div>

      <div class="impact-shell impact-history-gallery">
        {historyHighlights.map((event) => event && (
          <a class="impact-history-card" href={`/archive/${event.slug}/`}>
            <span>{event.year}</span>
            <figure><img src={event.cover} alt={`${event.title} ${event.year}`} loading="lazy" /></figure>
            <div><strong>{event.title}</strong><small>{event.category}</small></div>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>