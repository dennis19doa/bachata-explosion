---
import BaseLayout from "../layouts/BaseLayout.astro";
import { archiveEvents } from "../data/archive";
import { ticketUrl } from "../data/festival";

const team = [
  { name: "Dennis", role: "Owner · Founder", since: "Since 2021", image: "/media/team/dennis.jpg", bio: "Event vision, community growth and the details that make every Explosion ambitious and personal." },
  { name: "Elena", role: "Owner · Founder", since: "Since 2021", image: "/media/team/elena.jpg", bio: "Dancer experience, team culture and the warm atmosphere behind the Explosion community." },
  { name: "Laura", role: "Explosion Team", since: "Since 2023", image: "/media/team/laura.jpg", bio: "Event flow and the welcoming community feeling on site." },
  { name: "Lucy", role: "Physiotherapist", since: "Since 2023", image: "/media/team/lucy.jpg", bio: "Body awareness, care and dancer-friendly support." },
  { name: "Mircea", role: "Chef", since: "Since 2023", image: "/media/team/mircea.jpg", bio: "Comfort, care and behind-the-scenes support throughout the weekend." },
  { name: "Roberto", role: "Promoter", since: "Since 2023", image: "/media/team/roberto.jpg", bio: "Connecting dancers with the events and helping the community grow." },
  { name: "Jenn", role: "Explosion Team", since: "Since 2023", image: "/media/team/jenn.jpg", bio: "Supporting the people-first atmosphere that makes dancers feel at home." },
  { name: "Milo", role: "Driver", since: "Since 2023", image: "/media/team/milo.jpg", bio: "The logistics that help a festival weekend run smoothly." },
  { name: "Blanca", role: "Research & Planning", since: "Since 2024", image: "/media/team/blanca.jpg", bio: "Planning, ideas and preparation that keep the brand moving forward." },
];

const roleRotation = archiveEvents.find((event) => event.slug === "role-rotation-2026") ?? archiveEvents[0];
const eliteDance = archiveEvents.find((event) => event.slug === "elite-dance-3") ?? archiveEvents[1];
---

<BaseLayout
  title="Bachata Explosion — Berlin Bachata events by dancers, for dancers"
  description="Meet the next Bachata Explosion in Berlin: Berlin Bachata Festival 2026 at Hotel MOA Berlin, plus the complete event history and photo archive."
>
  <div data-wordpress-source="home">
  <section class="home-hero" aria-labelledby="home-hero-title">
    <div class="home-hero-live-texture" aria-hidden="true"></div>
    <video class="home-hero-video" autoplay muted loop playsinline preload="metadata" poster="/media/atmosphere/party-crowd.webp" aria-hidden="true">
      <source src="/media/video/bbf-2026-recap.mp4" type="video/mp4" />
    </video>
    <div class="home-hero-shade" aria-hidden="true"></div>
    <div class="home-hero-content shell">
      <div class="home-hero-copy">
        <p class="home-urban-sticker">Berlin born · dancer built · since 2022</p>
        <p class="home-hero-meta"><span>October 16–18, 2026</span><span>MOA Berlin</span></p>
        <p class="eyebrow"><span></span>Next Explosion</p>
        <h1 id="home-hero-title">Berlin<br />Bachata<br /><em>Festival</em></h1>
        <p class="home-hero-lead">Three days of international artists, focused workshops, shows, competitions and late-night social dancing. Built in Berlin by dancers, for dancers.</p>
        <div class="hero-actions">
          <a class="button button-gold" href={ticketUrl}>Secure your pass</a>
          <a class="button button-glass" href="/bbf-2026/">Discover the festival</a>
        </div>
        <div class="home-countdown" data-countdown="2026-10-16T18:00:00+02:00" aria-label="Countdown to Berlin Bachata Festival 2026">
          <div><strong data-days>—</strong><span>Days</span></div>
          <div><strong data-hours>—</strong><span>Hours</span></div>
          <div><strong data-minutes>—</strong><span>Minutes</span></div>
        </div>
      </div>
      <a class="home-hero-poster" href="/bbf-2026/" aria-label="Explore Berlin Bachata Festival 2026">
        <img src="/media/events/bbf-2026-poster.jpg" alt="Berlin Bachata Festival 2026 official poster" width="1080" height="1350" />
        <span><b>BBF 2026</b> Official event poster ↗</span>
      </a>
    </div>
    <a class="home-scroll-cue" href="#choose-event"><span>Enter the Explosion</span><i aria-hidden="true"></i></a>
  </section>

  <section class="home-signal" aria-label="Bachata Explosion essentials">
    <div class="home-signal-beam" aria-hidden="true"></div>
    <div class="shell home-stat-grid">
      <div><strong>Made in Berlin</strong><span>Born here</span></div>
      <div><strong data-home-count="2022">0</strong><span>Events since</span></div>
      <div><strong data-home-count="21">0</strong><span>Events created</span></div>
      <div><strong>By dancers</strong><span>For dancers</span></div>
      <div><strong data-home-count="6010">0</strong><span>Attendees in total</span></div>
      <div><strong data-home-count="500" data-home-suffix="+">0</strong><span>Artists worked with</span></div>
    </div>
  </section>

  <div class="home-impact-marquee" aria-hidden="true">
    <span>Berlin Bachata Festival · 16–18 October 2026 · MOA Berlin · </span>
    <span>Berlin Bachata Festival · 16–18 October 2026 · MOA Berlin · </span>
  </div>

  <section class="home-manifesto section-pad">
    <span class="home-manifesto-city" aria-hidden="true">52.5200° N · 13.4050° E</span>
    <div class="shell home-manifesto-grid">
      <p class="section-label">21 events · one Berlin community</p>
      <h2>Built in Berlin.<br /><em>Made to move you.</em></h2>
      <p>We are all about you. Bachata Explosion is built around connection, growth and the family feeling that makes dancers feel at home—from the first workshop to the last song.</p>
    </div>
  </section>

  <section class="event-switcher section-pad" id="choose-event" aria-labelledby="event-switcher-title">
    <div class="shell">
      <div class="event-switcher-heading">
        <div>
          <p class="section-label">The Explosion universe</p>
          <h2 id="event-switcher-title">Different formats.<br /><em>One identity.</em></h2>
        </div>
        <p>Berlin Bachata Festival is the flagship weekend. Role Rotation and Elite Dance are other chapters of the same dancer-built community.</p>
      </div>
      <article class="home-next-event">
        <a class="home-next-poster" href="/bbf-2026/">
          <img src="/media/events/bbf-2026-poster.jpg" alt="Berlin Bachata Festival 2026 event artwork" width="1080" height="1350" loading="lazy" />
          <span>Official BBF 2026 artwork</span>
        </a>
        <div class="home-next-copy">
          <p>October 16–18, 2026 · Hotel MOA Berlin</p>
          <h3>Berlin<br />Bachata<br />Festival</h3>
          <ul><li>International artists, DJs, shows & competitions</li><li>Workshops and social dancing across the weekend</li><li>Hotel and venue under one roof</li></ul>
          <div class="home-next-actions"><a class="button button-gold" href="/bbf-2026/">Explore the festival</a><a class="button button-outline" href={ticketUrl}>Get tickets</a></div>
        </div>
        <div class="home-next-history">
          <span>The flagship Explosion</span>
          <a href="/bbf-2026/#schedule"><b>Festival program</b><small>Three days of workshops & parties ↗</small></a>
          <a href="/jj/"><b>Jack & Jill</b><small>Competition, rules & registration ↗</small></a>
          <div><a href="/bbf-2026/#venue">MOA Berlin</a><a href="/bbf-2026/#travel">Travel info</a></div>
        </div>
      </article>

      <div class="home-event-chapters" aria-label="Other Bachata Explosion event formats">
        <a class="home-chapter-card" href={`/archive/${roleRotation.slug}/`}>
          <img src={roleRotation.cover} alt={`${roleRotation.title} ${roleRotation.year} event poster`} width="900" height="1100" loading="lazy" />
          <div><span>Role switch concept · Berlin</span><h3>Role Rotation</h3><p>Lead, follow or switch roles to understand connection from both sides.</p><b>Enter the chapter →</b></div>
        </a>
        <a class="home-chapter-card" href={`/archive/${eliteDance.slug}/`}>
          <img src={eliteDance.cover} alt={`${eliteDance.title} ${eliteDance.year} event poster`} width="900" height="1100" loading="lazy" />
          <div><span>Special edition · Berlin</span><h3>Elite Dance #3</h3><p>A more intimate Explosion atmosphere with selected artists, growth and connection.</p><b>Enter the chapter →</b></div>
        </a>
        <div class="home-chapter-note">
          <span>Explosion DNA</span>
          <strong>Quality teaching.<br />Real connection.<br />Berlin energy.</strong>
          <p>Different concepts, same community-first approach.</p>
          <a class="text-link" href="/archive/">Explore every past event <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="home-feeling section-pad">
    <div class="shell home-feeling-grid">
      <figure>
        <img src="/media/bbf/atmosphere/party-141.jpg" alt="Bachata Explosion crowd dancing at a Berlin party" width="1200" height="800" loading="lazy" />
        <figcaption>Real people. Real connection. Berlin.</figcaption>
      </figure>
      <div>
        <p class="section-label">The Explosion feeling</p>
        <h2>Not generic.<br /><em>Not anonymous.</em></h2>
        <p>We design the kind of weekend we want to dance ourselves: clear teaching, ambitious production and a room that still feels human.</p>
        <div class="home-editorial-notes">
          <p>Come to improve.</p>
          <p>Stay for the community.</p>
          <p>Leave with memories that keep you dancing.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="home-team section-pad" aria-labelledby="home-team-title">
    <div class="shell">
      <div class="section-heading split-heading">
        <div><p class="section-label">The people behind the weekend</p><h2 id="home-team-title">Dancer-built.<br /><em>Human-led.</em></h2></div>
        <p>The people making every weekend personal, welcoming and unmistakably Explosion.</p>
      </div>
      <p class="team-rail-instruction">The real crew behind the floor—scroll across to meet the team.</p>
      <div class="team-marquee" aria-label="Bachata Explosion team">
        <div class="team-track">
          {[0, 1].map((loop) => (
            <div class="team-group" aria-hidden={loop === 1 ? "true" : undefined}>
              {team.map((member) => (
                <article class="team-card" tabindex={loop === 0 ? "0" : "-1"}>
                  <img src={member.image} alt={loop === 0 ? `${member.name}, ${member.role} at Bachata Explosion` : ""} width="600" height="600" loading="lazy" />
                  <div>
                    <span>{member.since}</span>
                    <h3>{member.name}</h3>
                    <b>{member.role}</b>
                    <p>{member.bio}</p>
                  </div>
                </article>
              ))}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="archive-preview home-archive section-pad">
    <div class="shell">
      <div class="section-heading split-heading">
        <div><p class="section-label">The living archive</p><h2>Every edition<br /><em>still matters.</em></h2></div>
        <div><p>Your history is part of the identity. Choose an edition and relive the floor—every original event chapter remains available.</p><a class="text-link" href="/archive/">Browse the complete archive <span aria-hidden="true">↗</span></a></div>
      </div>
      <div class="home-archive-label"><span>Complete archive</span><b>{archiveEvents.length} editions · 2022–2026</b></div>
      <div class="archive-marquee" aria-label="Every Bachata Explosion edition">
        <div class="archive-track">
          {[0, 1].map((loop) => (
            <div class="archive-group" aria-hidden={loop === 1 ? "true" : undefined}>
              {archiveEvents.map((event) => (
                <a class="archive-card" href={`/archive/${event.slug}/`} tabindex={loop === 0 ? undefined : "-1"}>
                  <img src={event.cover} alt={loop === 0 ? `${event.title} ${event.year} event cover` : ""} width="900" height="1100" loading="lazy" />
                  <div><span>{event.category} · {event.year}</span><h3>{event.title}</h3><b>View collection →</b></div>
                </a>
              ))}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="home-berlin section-pad" id="berlin" aria-labelledby="home-berlin-title">
    <div class="shell home-berlin-grid">
      <div class="home-berlin-intro">
        <p class="section-label">The city is part of the event</p>
        <h2 id="home-berlin-title">Come for Explosion.<br /><em>Stay for Berlin.</em></h2>
        <p>The festival gives you a reason to book the weekend. Berlin turns it into a trip: music, history, late nights and neighbourhoods that never feel interchangeable.</p>
        <div class="home-berlin-stamp"><span>Made in</span><strong>Berlin</strong><small>Open to everywhere</small></div>
      </div>
      <div class="home-berlin-reasons">
        <article>
          <span>Freedom</span>
          <h3>A city that lets you be yourself.</h3>
          <p>Berlin rewards individuality. Come dressed up, dressed down or entirely as yourself—the city’s creative energy makes room for difference.</p>
        </article>
        <article>
          <span>After dark</span>
          <h3>The weekend does not end at the venue door.</h3>
          <p>When the last festival song fades, Berlin is still moving: bars, art spaces, food and a nightlife culture famous for carrying on until morning.</p>
        </article>
        <article>
          <span>Explore</span>
          <h3>Twelve boroughs. Hundreds of different moods.</h3>
          <p>Every Kiez has its own rhythm—from alternative Kreuzberg to elegant City West. Add one free afternoon and find the version of Berlin that feels like yours.</p>
        </article>
        <div class="home-berlin-actions">
          <a class="button button-gold" href="/bbf-2026/">Make it your festival weekend</a>
          <a class="text-link" href="https://www.visitberlin.de/en/neighbourhoods-berlin">Explore Berlin’s neighbourhoods <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
    <div class="home-berlin-kiez" aria-hidden="true"><span>Kreuzberg</span><span>Schöneberg</span><span>Neukölln</span><span>Mitte</span><span>Charlottenburg</span><span>Friedrichshain</span></div>
  </section>

  <section class="home-social section-pad">
    <div class="shell home-social-card">
      <div>
        <p class="section-label">Between the editions</p>
        <h2>The story continues<br /><em>on Instagram.</em></h2>
      </div>
      <div>
        <p>Artist drops, timetable news and moments that cannot wait.</p>
        <a class="button button-dark" href="https://instagram.com/bachataexplosion_official">Follow @bachataexplosion_official ↗</a>
      </div>
    </div>
  </section>
  </div>

  <script>
    const countdown = document.querySelector<HTMLElement>("[data-countdown]");
    const updateCountdown = () => {
      if (!countdown) return;
      const target = new Date(countdown.dataset.countdown ?? "").getTime();
      const remaining = Math.max(0, target - Date.now());
      const day = 86_400_000;
      const hour = 3_600_000;
      const minute = 60_000;
      const values = {
        days: Math.floor(remaining / day),
        hours: Math.floor((remaining % day) / hour),
        minutes: Math.floor((remaining % hour) / minute),
      };
      Object.entries(values).forEach(([key, value]) => {
        const element = countdown.querySelector<HTMLElement>(`[data-${key}]`);
        if (element) element.textContent = String(value).padStart(2, "0");
      });
    };
    updateCountdown();
    window.setInterval(updateCountdown, 60_000);

    const homeStatObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const element = entry.target as HTMLElement;
        const target = Number(element.dataset.homeCount ?? 0);
        const suffix = element.dataset.homeSuffix ?? "";
        const started = performance.now();
        const animate = (now: number) => {
          const progress = Math.min(1, (now - started) / 1650);
          const eased = 1 - Math.pow(1 - progress, 4);
          element.textContent = `${Math.round(target * eased).toLocaleString("en-US")}${suffix}`;
          if (progress < 1) requestAnimationFrame(animate);
        };
        requestAnimationFrame(animate);
        homeStatObserver.unobserve(element);
      });
    }, { threshold: 0.45 });
    document.querySelectorAll<HTMLElement>("[data-home-count]").forEach((element) => homeStatObserver.observe(element));
  </script>
</BaseLayout>