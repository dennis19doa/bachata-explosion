---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ticketUrl } from "../data/festival";
import "../styles/home-impact.css";

const lineup = [
  ["Victor & Alba", "/media/bbf/artists/victor-alba.jpg"],
  ["David & Laura", "/media/bbf/artists/david-laura.jpg"],
  ["Diego & Ola", "/media/bbf/artists/diego-ola.jpg"],
  ["Emilien & Tehina", "/media/bbf/artists/emilien-tehina.jpg"],
  ["Felipe & Tiago", "/media/bbf/artists/felipe-taigo.jpg"],
  ["Liza & Chicho", "/media/bbf/artists/liza-chicho.jpg"],
] as const;

const team = [
  { name: "Dennis", role: "Owner · Founder", since: "Since 2021", image: "/media/team/dennis.jpg" },
  { name: "Elena", role: "Owner · Founder", since: "Since 2021", image: "/media/team/elena.jpg" },
  { name: "Laura", role: "Explosion Team", since: "Since 2023", image: "/media/team/laura.jpg" },
  { name: "Lucy", role: "Physiotherapist", since: "Since 2023", image: "/media/team/lucy.jpg" },
  { name: "Mircea", role: "Chef", since: "Since 2023", image: "/media/team/mircea.jpg" },
  { name: "Roberto", role: "Promoter", since: "Since 2023", image: "/media/team/roberto.jpg" },
  { name: "Jenn", role: "Explosion Team", since: "Since 2023", image: "/media/team/jenn.jpg" },
  { name: "Milo", role: "Driver", since: "Since 2023", image: "/media/team/milo.jpg" },
  { name: "Blanca", role: "Research & Planning", since: "Since 2024", image: "/media/team/blanca.jpg" },
] as const;

const storyImages = [
  ["/media/archive/gold-2022.jpg", "Gold Edition 2022"],
  ["/media/archive/bbf-2023.jpg", "Berlin Bachata Festival 2023"],
  ["/media/archive/role-rotation-2024.jpg", "Role Rotation 2024"],
  ["/media/archive/bbf-2025.jpg", "Berlin Bachata Festival 2025"],
  ["/media/archive/role-rotation-2026.jpg", "Role Rotation 2026"],
] as const;
---

<BaseLayout
  title="Bachata Explosion — Berlin Bachata events by dancers, for dancers"
  description="Discover the next Bachata Explosion in Berlin, meet the people behind the events, explore our formats and join Berlin Bachata Festival 2026."
>
  <div class="impact-home" data-wordpress-source="home">
    <section class="impact-hero" aria-labelledby="impact-hero-title">
      <video class="impact-hero-video ug-hero-video" autoplay muted loop playsinline preload="metadata" poster="/media/atmosphere/party-crowd.webp" aria-label="Bachata Explosion festival atmosphere">
        <source src="/media/video/bbf-2026-recap.mp4" type="video/mp4" />
      </video>
      <div class="impact-hero-wash" aria-hidden="true"></div>
      <div class="impact-shell impact-hero-layout">
        <div class="impact-hero-copy">
          <p class="impact-kicker impact-kicker-light">Next Explosion · Fourth edition</p>
          <h1 id="impact-hero-title">Berlin Bachata <em>Festival</em></h1>
          <div class="impact-hero-meta"><strong>16–18 October 2026</strong><span>MOA Berlin · Stephanstraße 41</span></div>
          <p class="impact-hero-lead">International artists, high-quality workshops, competition energy and three nights of social dancing in Berlin.</p>
          <div class="impact-actions">
            <a class="impact-button" href={ticketUrl} data-ticket-checkout>Get festival tickets</a>
            <a class="impact-button ghost" href="/bbf-2026/">Festival details</a>
          </div>
        </div>
        <a class="impact-hero-poster" href="/bbf-2026/" aria-label="Open Berlin Bachata Festival 2026">
          <img src="/media/events/bbf-2026-poster.jpg" alt="Berlin Bachata Festival 2026 official poster" width="1080" height="1350" />
          <span>BBF 2026 · official artwork</span>
        </a>
      </div>
    </section>

    <section class="impact-lineup" aria-labelledby="impact-lineup-title">
      <div class="impact-shell impact-lineup-head">
        <div><p class="impact-kicker">The lineup</p><h2 id="impact-lineup-title">Meet some of the artists coming to Berlin.</h2></div>
        <a href="/bbf-2026/#artists">See full lineup →</a>
      </div>
      <div class="impact-shell impact-lineup-grid">
        {lineup.map(([name, image]) => (
          <a href="/bbf-2026/#artists" class="impact-lineup-card">
            <img src={image} alt={`${name} at Berlin Bachata Festival 2026`} width="600" height="700" loading="lazy" />
            <strong>{name}</strong>
          </a>
        ))}
      </div>
    </section>

    <section class="impact-formats impact-section" aria-labelledby="impact-formats-title">
      <div class="impact-shell impact-section-heading">
        <p class="impact-kicker">Explosion formats</p>
        <h2 class="impact-title" id="impact-formats-title">Three concepts.<br /><em>One Explosion.</em></h2>
        <p class="impact-copy">Each format has its own purpose, but they all come from the same idea: dancers first.</p>
      </div>
      <div class="impact-shell impact-format-grid">
        <a class="impact-format-card" href="/archive/role-rotation-2026/">
          <figure><img src="/media/events/role-rotation-2026.webp" alt="Role Rotation 2026 poster" width="900" height="1100" loading="lazy" /></figure>
          <div><span>01 · Role Rotation</span><h3>Change perspective.</h3><p>Lead, follow and switch roles to understand connection from both sides. A focused concept built around technique, empathy and freedom on the dance floor.</p><b>Explore Role Rotation →</b></div>
        </a>
        <a class="impact-format-card" href="/archive/elite-dance-3/">
          <figure><img src="/media/events/elite-dance-3.webp" alt="Elite Dance 3 poster" width="900" height="1100" loading="lazy" /></figure>
          <div><span>02 · Elite Dance</span><h3>Go deeper.</h3><p>A smaller, more intimate Explosion format with selected artists, concentrated learning and a closer community atmosphere.</p><b>Explore Elite Dance →</b></div>
        </a>
        <a class="impact-format-card" href="/bbf-2026/">
          <figure><img src="/media/events/bbf-2026-poster.jpg" alt="Berlin Bachata Festival 2026 poster" width="1080" height="1350" loading="lazy" /></figure>
          <div><span>03 · Berlin Bachata Festival</span><h3>The flagship.</h3><p>Our biggest Berlin weekend: international artists, workshops, parties, competition and the full Explosion community under one roof.</p><b>Explore BBF 2026 →</b></div>
        </a>
      </div>
    </section>

    <section class="impact-stats impact-section" aria-labelledby="impact-stats-title">
      <div class="impact-shell impact-stats-heading">
        <div><p class="impact-kicker">We are all about you</p><h2 class="impact-title" id="impact-stats-title">Built around the dancers<br />who make the room <em>alive.</em></h2></div>
        <p class="impact-copy">Explosion has grown because dancers keep coming back, bringing friends and becoming part of the story. These numbers are about people, not scale for the sake of scale.</p>
      </div>
      <div class="impact-shell impact-stat-grid">
        <div><strong>20+</strong><span>Events organised</span></div>
        <div><strong>500+</strong><span>Artists & DJs worked with</span></div>
        <div><strong>6,000+</strong><span>Dancers reached</span></div>
        <div><strong>2022</strong><span>Explosion began</span></div>
        <div><strong>Berlin</strong><span>Made here</span></div>
      </div>
      <div class="impact-shell impact-stat-photo-row" aria-label="Bachata Explosion atmosphere">
        <img src="/media/bbf/atmosphere/party-141.jpg" alt="Bachata Explosion party atmosphere" loading="lazy" />
        <img src="/media/bbf/atmosphere/saturday-60.jpg" alt="Bachata Explosion dancers during the festival" loading="lazy" />
        <img src="/media/bbf/atmosphere/party-143.jpg" alt="Bachata Explosion social dance floor" loading="lazy" />
      </div>
    </section>

    <section class="impact-people impact-section" aria-labelledby="impact-people-title">
      <div class="impact-shell impact-people-heading">
        <div><p class="impact-kicker">The people behind Explosion</p><h2 class="impact-title" id="impact-people-title">We are not a faceless<br /><em>festival brand.</em></h2></div>
        <p class="impact-copy">These are the people who plan, drive, welcome, promote, support and shape the events. They are a visible part of Explosion because they are a real part of the experience.</p>
      </div>
      <div class="impact-shell impact-team-grid">
        {team.map((person, index) => (
          <article class:list={["impact-team-card", index < 2 && "is-founder"]}>
            <img src={person.image} alt={`${person.name}, ${person.role} at Bachata Explosion`} width="600" height="800" loading="lazy" />
            <div><small>{person.since}</small><h3>{person.name}</h3><span>{person.role}</span></div>
          </article>
        ))}
      </div>
    </section>

    <section class="impact-story impact-section" aria-labelledby="impact-story-title">
      <div class="impact-shell impact-story-layout">
        <div class="impact-story-copy">
          <p class="impact-kicker">We are Explosion</p>
          <h2 class="impact-title" id="impact-story-title">What started as a dream<br />became a <em>community.</em></h2>
          <p class="impact-copy">Explosion began in Berlin in 2022 with Elena and Dennis and a simple goal: create events where dancers feel challenged, welcomed and excited to come back. Since then, every edition has added another chapter, another room full of people and another reason to keep building.</p>
          <p class="impact-copy">The history matters because the event did not appear overnight. The photos, posters and people from every edition are part of what Explosion is today.</p>
          <a class="impact-text-link" href="/explosion-history/">Explore the complete history →</a>
        </div>
        <div class="impact-history-collage" aria-label="Bachata Explosion editions from 2022 to 2026">
          {storyImages.map(([src, alt], index) => <figure class={`history-tile history-tile-${index + 1}`}><img src={src} alt={alt} loading="lazy" /></figure>)}
        </div>
      </div>
    </section>

    <section class="impact-join">
      <div class="impact-shell impact-join-inner">
        <div><p class="impact-kicker impact-kicker-light">Your next chapter</p><h2>Are you ready to be part of it?</h2><p>Join us at the next Explosion in Berlin.</p></div>
        <div class="impact-actions"><a class="impact-button" href={ticketUrl} data-ticket-checkout>Get tickets</a><a class="impact-button ghost" href="/bbf-2026/">Explore BBF 2026</a></div>
      </div>
    </section>
  </div>
</BaseLayout>
