---
import BaseLayout from "../layouts/BaseLayout.astro";
import { archiveEvents } from "../data/archive";
import { ticketUrl } from "../data/festival";
import "../styles/home-impact.css";

const teamNames = ["Laura", "Lucy", "Mircea", "Roberto", "Jenn", "Milo", "Blanca"];
---

<BaseLayout
  title="Bachata Explosion — Berlin Bachata events by dancers, for dancers"
  description="Bachata Explosion is a Berlin-born bachata event family: Berlin Bachata Festival 2026, Role Rotation, Elite Dance and a growing international community."
>
  <div class="impact-home" data-wordpress-source="home">
    <section class="impact-hero" aria-labelledby="impact-hero-title">
      <video class="impact-hero-video ug-hero-video" autoplay muted loop playsinline preload="metadata" poster="/media/atmosphere/party-crowd.webp" aria-label="Bachata Explosion festival atmosphere">
        <source src="/media/video/bbf-2026-recap.mp4" type="video/mp4" />
      </video>
      <div class="impact-hero-inner">
        <div class="impact-hero-copy">
          <div class="impact-hero-overline"><b>Born in Berlin</b><span>16–18 October 2026</span><span>MOA Berlin</span></div>
          <h1 id="impact-hero-title"><span>Bachata</span><span>Explosion</span></h1>
          <p class="impact-tagline">Feel it. Live it. Share it.</p>
          <p class="impact-copy impact-hero-lead">A dancer-built event family with ambitious teaching, international artists, packed socials and a community that still feels personal.</p>
          <div class="impact-actions">
            <a class="impact-button" href={ticketUrl}>Get tickets</a>
            <a class="impact-button ghost" href="/bbf-2026/">Discover more</a>
          </div>
        </div>
        <aside class="impact-hero-side" aria-label="Berlin Bachata Festival 2026">
          <p class="impact-hero-graffiti">Berlin is our <em>dancefloor.</em></p>
          <a class="impact-poster" href="/bbf-2026/">
            <img src="/media/events/bbf-2026-poster.jpg" alt="Berlin Bachata Festival 2026 official artwork" width="1080" height="1350" />
            <span>BBF 2026 · Official artwork ↗</span>
          </a>
        </aside>
      </div>
    </section>

    <section class="impact-stats" aria-label="Berlin Bachata Festival 2026 highlights">
      <div class="impact-shell impact-stats-grid">
        <div class="impact-stat"><strong>3</strong><span>Days</span></div>
        <div class="impact-stat"><strong>40+</strong><span>Workshops</span></div>
        <div class="impact-stat"><strong>30+</strong><span>Artists</span></div>
        <div class="impact-stat"><strong>3</strong><span>Parties</span></div>
        <div class="impact-stat"><strong>1</strong><span>Community</span></div>
      </div>
    </section>

    <section class="impact-story impact-section" aria-labelledby="impact-story-title">
      <div class="impact-shell impact-story-grid">
        <div class="impact-story-copy">
          <p class="impact-kicker">More than a festival</p>
          <h2 class="impact-title" id="impact-story-title">A movement built around <em>connection.</em></h2>
          <p class="impact-copy">Bachata Explosion grew in Berlin from one simple idea: create the kind of dance experience we would want to attend ourselves—strong teaching, serious dancing and enough warmth that people still feel seen.</p>
          <div class="impact-values">
            <div><b>Dance</b><span>Workshops that give dancers something real to take home.</span></div>
            <div><b>Connect</b><span>A social floor where community matters as much as the line-up.</span></div>
            <div><b>Celebrate</b><span>Big-event energy without losing the personal side of Explosion.</span></div>
          </div>
        </div>
        <figure class="impact-story-media">
          <img src="/media/atmosphere/explosion-community.jpg" alt="Bachata Explosion community together in Berlin" width="1200" height="800" loading="lazy" />
          <figcaption>By dancers, for dancers.</figcaption>
        </figure>
      </div>
    </section>

    <section class="impact-feature impact-section" aria-labelledby="impact-feature-title">
      <div class="impact-shell">
        <div class="impact-feature-head">
          <div><p class="impact-kicker">The next Explosion</p><h2 class="impact-title" id="impact-feature-title">Berlin Bachata <em>Festival.</em></h2></div>
          <p class="impact-copy">16–18 October 2026 at Hotel MOA Berlin. Workshops, parties, shows, competitions and an international bachata community under one roof.</p>
        </div>
        <article class="impact-feature-card">
          <div class="impact-feature-poster"><img src="/media/events/bbf-2026-poster.jpg" alt="Berlin Bachata Festival 2026 poster" width="1080" height="1350" loading="lazy" /></div>
          <div class="impact-feature-copy">
            <p class="impact-kicker">October 16–18 · MOA Berlin</p>
            <h3>Three days.<br />One Explosion.</h3>
            <p>The flagship Bachata Explosion weekend brings together international artists, focused workshops, social dancing, shows and Jack & Jill in Berlin.</p>
            <div class="impact-tags"><span>40+ workshops</span><span>30+ artists</span><span>3 parties</span><span>Jack & Jill</span><span>MOA Berlin</span></div>
            <div class="impact-actions"><a class="impact-button" href="/bbf-2026/">Explore festival</a><a class="impact-button ghost" href={ticketUrl}>Get tickets</a></div>
          </div>
        </article>
      </div>
    </section>

    <section class="impact-section" aria-labelledby="impact-events-title">
      <div class="impact-shell">
        <div class="impact-events-head">
          <p class="impact-kicker">The Explosion universe</p>
          <h2 class="impact-title" id="impact-events-title">Different concepts.<br /><em>Same DNA.</em></h2>
        </div>
        <div class="impact-event-grid">
          <a class="impact-event-card" href="/bbf-2026/">
            <img src="/media/events/bbf-2026-poster.jpg" alt="Berlin Bachata Festival 2026" width="1080" height="1350" loading="lazy" />
            <div><small>Flagship weekend</small><h3>Berlin Bachata Festival</h3><p>The full-scale Explosion experience in Berlin.</p><b>Explore BBF →</b></div>
          </a>
          <a class="impact-event-card" href="/archive/role-rotation-2026/">
            <img src="/media/events/role-rotation-2026.webp" alt="Role Rotation 2026" width="900" height="1100" loading="lazy" />
            <div><small>Switch perspective</small><h3>Role Rotation</h3><p>Lead, follow and understand connection from both sides.</p><b>Explore Role Rotation →</b></div>
          </a>
          <a class="impact-event-card" href="/archive/elite-dance-3/">
            <img src="/media/events/elite-dance-3.webp" alt="Elite Dance 3" width="900" height="1100" loading="lazy" />
            <div><small>More intimate</small><h3>Elite Dance</h3><p>Selected artists, focused growth and a closer community atmosphere.</p><b>Explore Elite Dance →</b></div>
          </a>
        </div>
      </div>
    </section>

    <section class="impact-berlin impact-section" aria-labelledby="impact-berlin-title">
      <div class="impact-shell impact-berlin-grid">
        <div class="impact-berlin-art" aria-hidden="true">
          <span class="impact-berlin-tag">Berlin energy →</span>
          <img class="impact-berlin-gate" src="/media/brand/berlin-brandenburg-gold.png" alt="" />
          <img class="impact-berlin-photo" src="/media/bbf/atmosphere/party-143.jpg" alt="" />
        </div>
        <div class="impact-berlin-copy">
          <p class="impact-kicker">Berlin is our stage</p>
          <h2 class="impact-title" id="impact-berlin-title">Born here.<br /><em>Open to the world.</em></h2>
          <p class="impact-copy">Berlin gives Explosion its attitude: international, direct, creative and unafraid to mix worlds. The city is part of the experience, but the dance floor stays at the centre.</p>
          <div class="impact-berlin-points"><span>MOA Berlin</span><span>International community</span><span>Nightlife energy</span><span>Dancer-built</span></div>
          <div class="impact-actions" style="margin-top:28px"><a class="impact-button ghost" href="/bbf-2026/#travel">Discover Berlin</a></div>
        </div>
      </div>
    </section>

    <section class="impact-section" aria-labelledby="impact-people-title">
      <div class="impact-shell impact-people-grid">
        <div class="impact-founders">
          <figure><img src="/media/team/dennis.jpg" alt="Dennis, founder of Bachata Explosion" width="600" height="800" loading="lazy" /><figcaption>Dennis · Founder</figcaption></figure>
          <figure><img src="/media/team/elena.jpg" alt="Elena, founder of Bachata Explosion" width="600" height="800" loading="lazy" /><figcaption>Elena · Founder</figcaption></figure>
        </div>
        <div>
          <p class="impact-kicker">Behind Explosion</p>
          <h2 class="impact-title" id="impact-people-title">Dancer-built.<br /><em>Human-led.</em></h2>
          <p class="impact-copy">Dennis and Elena built Bachata Explosion from the dance floor outward, together with a team that keeps each edition ambitious, organised and welcoming.</p>
          <div class="impact-team" aria-label="Bachata Explosion team">{teamNames.map((name) => <span>{name}</span>)}</div>
        </div>
      </div>
    </section>

    <section class="impact-history impact-section" aria-labelledby="impact-history-title">
      <div class="impact-shell">
        <div class="impact-history-grid">
          <div><p class="impact-kicker">Since 2022</p><h2 class="impact-title" id="impact-history-title">Every edition leaves a <em>mark.</em></h2></div>
          <div><p class="impact-copy">The complete Bachata Explosion history stays available: {archiveEvents.length} editions, original event chapters, posters and galleries.</p><div class="impact-history-actions"><a class="impact-button" href="/archive/">Past events</a><a class="impact-button ghost" href="/explosion-history/">Our story</a></div></div>
        </div>
        <div class="impact-history-years" aria-label="Bachata Explosion timeline"><span>2022</span><span>2023</span><span>2024</span><span>2025</span><span>2026</span></div>
      </div>
    </section>
  </div>
</BaseLayout>
