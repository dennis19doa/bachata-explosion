---
import BaseLayout from "../layouts/BaseLayout.astro";
import { archiveEvents } from "../data/archive";
import { ticketUrl } from "../data/festival";
import "../styles/home-refresh.css";

const teamNames = ["Laura", "Lucy", "Mircea", "Roberto", "Jenn", "Milo", "Blanca"];
---

<BaseLayout
  title="Bachata Explosion — Berlin Bachata events by dancers, for dancers"
  description="Meet Bachata Explosion in Berlin: Berlin Bachata Festival 2026, Role Rotation, Elite Dance and the complete event history."
>
  <div class="refresh-home" data-wordpress-source="home">
    <section class="refresh-hero" aria-labelledby="refresh-hero-title">
      <div class="refresh-hero-copy">
        <div class="refresh-hero-overline">
          <b>The next Explosion</b>
          <span>16–18 October 2026</span>
          <span>MOA Berlin</span>
        </div>
        <h1 id="refresh-hero-title"><span>Berlin</span><span><em>Bachata</em></span><span>Festival</span></h1>
        <p class="refresh-copy refresh-hero-lead">A weekend made for people who really love dancing: strong teaching, international artists, packed socials, competitions and the kind of community that makes a big festival still feel personal.</p>
        <div class="refresh-hero-actions">
          <a class="refresh-button" href={ticketUrl}>Secure your pass</a>
          <a class="refresh-button refresh-button-light" href="/bbf-2026/">Explore BBF 2026</a>
        </div>
        <div class="refresh-countdown" data-countdown="2026-10-16T18:00:00+02:00" aria-label="Countdown to Berlin Bachata Festival 2026">
          <div><strong data-days>—</strong><span>Days</span></div>
          <div><strong data-hours>—</strong><span>Hours</span></div>
          <div><strong data-minutes>—</strong><span>Minutes</span></div>
        </div>
      </div>

      <div class="refresh-hero-visual">
        <img src="/media/bbf/atmosphere/party-143.jpg" alt="Bachata Explosion social dancing in Berlin" width="1200" height="800" fetchpriority="high" />
        <span class="refresh-hero-note">Big festival energy.<br />Human atmosphere.</span>
        <a class="refresh-hero-poster" href="/bbf-2026/" aria-label="Open Berlin Bachata Festival 2026">
          <img src="/media/events/bbf-2026-poster.jpg" alt="Berlin Bachata Festival 2026 poster" width="1080" height="1350" />
          <span>BBF 2026 · Official artwork ↗</span>
        </a>
      </div>
    </section>

    <section class="refresh-facts" aria-label="Bachata Explosion facts">
      <div class="refresh-shell refresh-fact-grid">
        <div class="refresh-fact-intro"><strong>By dancers.</strong><span>Built in Berlin for the dance floor.</span></div>
        <div><strong data-home-count="21">21</strong><span>Events created</span></div>
        <div><strong data-home-count="6010">6,010</strong><span>Attendees</span></div>
        <div><strong data-home-count="500" data-home-suffix="+">500+</strong><span>Artists worked with</span></div>
        <div><strong>2022</strong><span>Explosion history begins</span></div>
      </div>
    </section>

    <section class="refresh-story refresh-section" aria-labelledby="refresh-story-title">
      <div class="refresh-shell refresh-story-grid">
        <div class="refresh-story-copy">
          <p class="refresh-kicker">Why Bachata Explosion exists</p>
          <h2 class="refresh-title" id="refresh-story-title">A festival should feel like <em>people</em>, not production.</h2>
          <p class="refresh-copy">We care about quality, but we care just as much about how the weekend feels. Bachata Explosion grew from the idea that dancers should be able to learn seriously, dance for hours and still feel like they are part of something warm and familiar.</p>
          <div class="refresh-values">
            <div><b>Teaching</b><span>Workshops that give dancers something real to take home.</span></div>
            <div><b>Connection</b><span>A social floor where the community matters as much as the names on the poster.</span></div>
            <div><b>Energy</b><span>Ambitious events without losing the personal side that started everything.</span></div>
          </div>
        </div>
        <figure class="refresh-story-photo">
          <img src="/media/atmosphere/explosion-community.jpg" alt="Bachata Explosion community together in Berlin" width="1200" height="800" loading="lazy" />
          <figcaption>Real people are the brand. The rest is there to support the experience.</figcaption>
        </figure>
      </div>
    </section>

    <section class="refresh-next refresh-section" aria-labelledby="refresh-next-title">
      <div class="refresh-shell">
        <div class="refresh-next-heading">
          <div>
            <p class="refresh-kicker">Coming next</p>
            <h2 class="refresh-title" id="refresh-next-title">The biggest <em>Explosion</em> yet.</h2>
          </div>
          <p class="refresh-copy">Three days at Hotel MOA Berlin with international artists, workshops, parties, shows, Jack & Jill and everything under one roof.</p>
        </div>

        <article class="refresh-next-card">
          <img src="/media/events/bbf-2026-poster.jpg" alt="Berlin Bachata Festival 2026 official artwork" width="1080" height="1350" loading="lazy" />
          <div class="refresh-next-content">
            <p class="refresh-kicker">October 16–18 · Hotel MOA Berlin</p>
            <h3>Berlin Bachata Festival 2026</h3>
            <p>The flagship Bachata Explosion weekend: 40+ workshops, 30+ artists, three parties and a full Berlin festival experience built around dancing.</p>
            <div class="refresh-next-tags"><span>Workshops</span><span>Socials</span><span>Shows</span><span>Jack & Jill</span><span>Berlin</span></div>
            <div class="refresh-hero-actions">
              <a class="refresh-button" href="/bbf-2026/">See the full festival</a>
              <a class="refresh-button refresh-button-light" href={ticketUrl}>Get tickets</a>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section class="refresh-universe refresh-section" aria-labelledby="refresh-universe-title">
      <div class="refresh-shell">
        <p class="refresh-kicker">One community, different formats</p>
        <h2 class="refresh-title" id="refresh-universe-title">There is more than one way to <em>explode.</em></h2>
        <div class="refresh-universe-grid">
          <a class="refresh-event-card" href="/bbf-2026/">
            <img src="/media/events/bbf-2026-poster.jpg" alt="Berlin Bachata Festival 2026" width="1080" height="1350" loading="lazy" />
            <div><small>Flagship weekend</small><h3>Berlin Bachata Festival</h3><p>The full-scale festival experience in Berlin.</p><b>Explore BBF →</b></div>
          </a>
          <a class="refresh-event-card" href="/archive/role-rotation-2026/">
            <img src="/media/events/role-rotation-2026.webp" alt="Role Rotation 2026" width="900" height="1100" loading="lazy" />
            <div><small>Switch perspective</small><h3>Role Rotation</h3><p>A concept built around leading, following and understanding connection from both sides.</p><b>Explore Role Rotation →</b></div>
          </a>
          <a class="refresh-event-card" href="/archive/elite-dance-3/">
            <img src="/media/events/elite-dance-3.webp" alt="Elite Dance 3" width="900" height="1100" loading="lazy" />
            <div><small>More intimate</small><h3>Elite Dance</h3><p>Selected artists, focused growth and a closer community atmosphere.</p><b>Explore Elite Dance →</b></div>
          </a>
        </div>
      </div>
    </section>

    <section class="refresh-community refresh-section" aria-labelledby="refresh-community-title">
      <div class="refresh-shell refresh-community-grid">
        <div>
          <p class="refresh-kicker">The part you remember</p>
          <h2 class="refresh-title" id="refresh-community-title">You come for bachata.<br />You stay for the <em>feeling.</em></h2>
          <p class="refresh-copy">The best event moments are rarely the polished ones. They are the song you did not want to end, the workshop where something finally clicked and the people you were not expecting to meet.</p>
          <p class="refresh-community-quote">“Come to improve. Stay for the community. Leave wanting the next Explosion.”</p>
        </div>
        <div class="refresh-community-pics" aria-label="Bachata Explosion atmosphere">
          <img src="/media/bbf/atmosphere/party-141.jpg" alt="Bachata Explosion party atmosphere" width="1200" height="800" loading="lazy" />
          <img src="/media/bbf/atmosphere/saturday-60.jpg" alt="Bachata Explosion dancers during the festival" width="1200" height="800" loading="lazy" />
        </div>
      </div>
    </section>

    <section class="refresh-people refresh-section" aria-labelledby="refresh-people-title">
      <div class="refresh-shell refresh-people-grid">
        <div class="refresh-founder-pics">
          <figure><img src="/media/team/dennis.jpg" alt="Dennis, founder of Bachata Explosion" width="600" height="800" loading="lazy" /><figcaption>Dennis · Founder</figcaption></figure>
          <figure><img src="/media/team/elena.jpg" alt="Elena, founder of Bachata Explosion" width="600" height="800" loading="lazy" /><figcaption>Elena · Founder</figcaption></figure>
        </div>
        <div class="refresh-people-copy">
          <p class="refresh-kicker">The people behind it</p>
          <h2 class="refresh-title" id="refresh-people-title">Dancer-built.<br /><em>Human-led.</em></h2>
          <p class="refresh-copy">Bachata Explosion is not a faceless event company. Dennis and Elena built it from the dance floor outward, together with a team that keeps each edition personal, organised and welcoming.</p>
          <div class="refresh-team-names" aria-label="Bachata Explosion team">
            {teamNames.map((name) => <span>{name}</span>)}
          </div>
        </div>
      </div>
    </section>

    <section class="refresh-history refresh-section" aria-labelledby="refresh-history-title">
      <div class="refresh-shell refresh-history-grid">
        <div>
          <p class="refresh-kicker">Since 2022</p>
          <h2 class="refresh-title" id="refresh-history-title">Every edition is part of the <em>story.</em></h2>
        </div>
        <div>
          <p class="refresh-copy">The old events are not being erased by the redesign. The complete Bachata Explosion history stays available: {archiveEvents.length} editions, original event chapters and the archive behind them.</p>
          <div class="refresh-history-actions">
            <a class="refresh-button" href="/archive/">Browse all past events</a>
            <a class="refresh-button refresh-button-light" href="/explosion-history/">Read our story</a>
          </div>
        </div>
      </div>
    </section>
  </div>

  <script>
    const countdown = document.querySelector<HTMLElement>("[data-countdown]");
    const updateCountdown = () => {
      if (!countdown) return;
      const target = new Date(countdown.dataset.countdown ?? "").getTime();
      const remaining = Math.max(0, target - Date.now());
      const day = 86_400_000;
      const hour = 3_600_000;
      const minute = 60_000;
      const values = {
        days: Math.floor(remaining / day),
        hours: Math.floor((remaining % day) / hour),
        minutes: Math.floor((remaining % hour) / minute),
      };
      Object.entries(values).forEach(([key, value]) => {
        const element = countdown.querySelector<HTMLElement>(`[data-${key}]`);
        if (element) element.textContent = String(value).padStart(2, "0");
      });
    };
    updateCountdown();
    window.setInterval(updateCountdown, 60_000);

    const counters = document.querySelectorAll<HTMLElement>("[data-home-count]");
    if (counters.length) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const element = entry.target as HTMLElement;
          const target = Number(element.dataset.homeCount ?? 0);
          const suffix = element.dataset.homeSuffix ?? "";
          const started = performance.now();
          const animate = (now: number) => {
            const progress = Math.min(1, (now - started) / 1200);
            const eased = 1 - Math.pow(1 - progress, 4);
            element.textContent = `${Math.round(target * eased).toLocaleString("en-US")}${suffix}`;
            if (progress < 1) requestAnimationFrame(animate);
          };
          requestAnimationFrame(animate);
          observer.unobserve(element);
        });
      }, { threshold: 0.35 });
      counters.forEach((element) => observer.observe(element));
    }
  </script>
</BaseLayout>
