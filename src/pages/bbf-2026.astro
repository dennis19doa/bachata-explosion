  { key: "saturday", day: "Saturday", date: "17 October", promise: "Learn. Perform. Explode.", items: [["11:00–20:10", "Workshops + Jack & Jill", "Two rooms of workshops with the first round and semi final in Room 2."], ["21:00–22:00", "Pre-party workshop", "Emilien & Tehina."], ["00:00", "Jack & Jill Final", "Final round at midnight."]] },
