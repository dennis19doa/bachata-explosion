---
import ConceptLayout from "../../layouts/ConceptLayout.astro";
import { ticketUrl } from "../../data/festival";
---

<ConceptLayout
  concept="magazine"
  title="Concept B — Berlin Festival Magazine | Bachata Explosion"
  description="A structured editorial concept for Bachata Explosion with the original event artwork, real content and a calmer international-festival presentation."
>
  <section class="mag-hero concept-shell">
    <div class="mag-issue"><span>Explosion Journal</span><span>Issue 04 · 2026</span><span>Berlin, Germany</span></div>
    <div class="mag-hero-grid">
      <div class="mag-title">
        <p class="concept-kicker">The next Explosion</p>
        <h1>Berlin<br />Bachata<br /><em>Festival</em></h1>
        <p>By dancers,<br />for dancers.</p>
      </div>
      <div class="mag-visual">
        <img src="/media/events/bbf-2026-poster.jpg" alt="Berlin Bachata Festival 2026 official poster" width="2048" height="2560" />
        <span>04th edition</span>
      </div>
      <div class="mag-intro">
        <p>Three days of international artists, high-quality workshops, competitions and social dancing until late in the heart of Berlin.</p>
        <dl>
          <div><dt>When</dt><dd>16–18 Oct 2026</dd></div>
          <div><dt>Where</dt><dd>MOA Berlin</dd></div>
          <div><dt>Main floor</dt><dd>1,200 m²</dd></div>
        </dl>
        <a class="mag-button" href={ticketUrl}>Secure your pass <span>↗</span></a>
        <a class="mag-text-link" href="/bbf-2026/">Read the complete festival guide</a>
      </div>
    </div>
  </section>

  <section class="mag-manifesto">
    <div class="concept-shell">
      <p class="concept-kicker">Our point of view</p>
      <blockquote>Come to improve.<br />Stay for the community.<br /><em>Leave with a story.</em></blockquote>
      <div class="mag-manifesto-copy">
        <p>Explosion brings international quality into a warm Berlin setting. The website should give you the same feeling: expressive enough to remember, organized enough to trust.</p>
        <a class="mag-text-link" href="/explosion-history/">Our story since 2022 →</a>
      </div>
    </div>
  </section>

  <section class="mag-dossier concept-pad">
    <div class="concept-shell">
      <header class="mag-section-head"><p>Festival dossier · 2026</p><h2>Everything for the weekend,<br /><em>in one place.</em></h2></header>
      <div class="mag-dossier-grid">
        <article class="mag-dossier-lead">
          <span>01 / Venue</span>
          <img src="/media/atmosphere/explosion-community.jpg" alt="Bachata Explosion community in Berlin" width="1200" height="800" />
          <h3>Hotel, venue &amp; experience</h3>
          <p>MOA Berlin becomes the festival home base: sleep, workshops, socials and late-night dancing connected in one destination.</p>
          <a href="/bbf-2026/">Venue and hotel information →</a>
        </article>
        <article><span>02 / Program</span><h3>Friday</h3><p>Opening workshops, social dancing and the first big party night.</p><b>Workshops · Social · Party</b></article>
        <article><span>03 / Program</span><h3>Saturday</h3><p>Main festival day, competition spotlight, shows and the biggest social.</p><b>Workshops · Finals · Main party</b></article>
        <article><span>04 / Program</span><h3>Sunday</h3><p>Final workshops, community social and the closing night together.</p><b>Workshops · Social · Closing</b></article>
        <article class="mag-dossier-gold"><span>05 / Passes</span><h3>Choose your experience</h3><p>Full Pass, Party Pass and Gold Pass information stays clear and close to the program.</p><a href={ticketUrl}>Compare official passes ↗</a></article>
      </div>
    </div>
  </section>

  <section class="mag-editions concept-pad">
    <div class="concept-shell">
      <header class="mag-section-head mag-section-head-split"><div><p>Three ways into the family</p><h2>Choose your<br /><em>Explosion.</em></h2></div><p>One event system, three distinct identities. The structure stays familiar while every format keeps the artwork and character dancers already recognize.</p></header>
      <div class="mag-edition-list">
        <a href="/bbf-2026/"><span>01</span><img src="/media/events/bbf-2026-poster.jpg" alt="Berlin Bachata Festival" /><div><p>Flagship · International</p><h3>Berlin Bachata Festival</h3><b>16–18 October 2026</b></div><i>Explore ↗</i></a>
        <a href="/role-rotation-2026/"><span>02</span><img src="/media/events/role-rotation-2026.webp" alt="Role Rotation" /><div><p>Concept weekend · Switch roles</p><h3>Role Rotation</h3><b>Lead · Follow · Understand both</b></div><i>Explore ↗</i></a>
        <a href="/elite-dance-3/"><span>03</span><img src="/media/events/elite-dance-3.webp" alt="Elite Dance #3" /><div><p>Focused · Intimate</p><h3>Elite Dance #3</h3><b>Small room · High level</b></div><i>Explore ↗</i></a>
      </div>
    </div>
  </section>

  <section class="mag-archive concept-pad">
    <div class="concept-shell mag-archive-grid">
      <div class="mag-archive-title"><p class="concept-kicker">Archive / 2022–2026</p><h2>The nights<br />we still<br /><em>talk about.</em></h2><a class="mag-button" href="/past-events/">Browse the complete archive <span>↗</span></a></div>
      <a class="mag-archive-photo mag-archive-photo-large" href="/berlin-bachata-festival-2024/"><img src="/media/archive/bbf-2024.jpg" alt="Berlin Bachata Festival 2024" /><p><span>Berlin Bachata Festival</span><b>2024 · Workshops &amp; parties</b></p></a>
      <a class="mag-archive-photo" href="/summer-edition-2024/"><img src="/media/archive/summer-2024.jpg" alt="Explosion Summer Edition 2024" /><p><span>Summer Edition</span><b>2024 · Berlin</b></p></a>
      <a class="mag-archive-photo" href="/role-rotation-2025/"><img src="/media/archive/role-rotation-2025.jpg" alt="Role Rotation 2025" /><p><span>Role Rotation</span><b>2025 · Edition 02</b></p></a>
    </div>
  </section>
</ConceptLayout>
